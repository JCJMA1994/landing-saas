---
import type { ThemeButtonVariant } from "../../domain/site/theme";

interface Props {
  href?: string | undefined;
  variant?: ThemeButtonVariant | undefined;
  size?: "sm" | "md" | "lg" | undefined;
  type?: "button" | "submit" | "reset" | undefined;
  disabled?: boolean | undefined;
  target?: string | undefined;
  rel?: string | undefined;
  class?: string | undefined;
}

const {
  href,
  variant = "solid",
  size = "md",
  type = "button",
  disabled = false,
  target,
  rel,
  class: className = "",
} = Astro.props;

const safeRel = target === "_blank" ? rel || "noopener noreferrer" : rel;
const Element = href ? "a" : "button";
---

<Element
  href={href}
  type={href ? undefined : type}
  disabled={href ? undefined : disabled}
  target={target}
  rel={safeRel}
  class={`ds-btn ds-btn-${variant} ds-btn-${size} ${disabled ? "ds-btn-disabled" : ""} ${className}`}
>
  <slot />
</Element>

<style>
  .ds-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--ds-space-2, 0.5rem);
    font-family: inherit;
    font-weight: 600;
    text-decoration: none;
    line-height: 1.25;
    border-radius: var(--ds-theme-radius, 4px);
    transition: all var(--ds-transition-fast, 150ms ease);
    cursor: pointer;
    box-sizing: border-box;
    outline: none;
  }

  .ds-btn:focus-visible {
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.5);
  }

  /* Sizes */
  .ds-btn-sm {
    padding: var(--ds-space-1, 0.25rem) var(--ds-space-3, 0.75rem);
    font-size: var(--ds-text-xs, 0.75rem);
  }

  .ds-btn-md {
    padding: var(--ds-space-2, 0.5rem) var(--ds-space-5, 1.25rem);
    font-size: var(--ds-text-sm, 0.875rem);
  }

  .ds-btn-lg {
    padding: var(--ds-space-3, 0.75rem) var(--ds-space-6, 1.5rem);
    font-size: var(--ds-text-base, 1rem);
  }

  /* Variants */
  .ds-btn-solid {
    background-color: var(--ds-color-primary, #3b82f6);
    color: var(--ds-color-button-text, #ffffff);
    border: 1px solid transparent;
  }

  .ds-btn-solid:hover:not(.ds-btn-disabled) {
    filter: brightness(1.1);
    transform: translateY(-1px);
  }

  .ds-btn-outline {
    background-color: transparent;
    color: var(--ds-color-primary, #3b82f6);
    border: 1px solid var(--ds-color-primary, #3b82f6);
  }

  .ds-btn-outline:hover:not(.ds-btn-disabled) {
    background-color: var(--ds-color-primary, #3b82f6);
    color: var(--ds-color-button-text, #ffffff);
  }

  .ds-btn-ghost {
    background-color: transparent;
    color: var(--ds-color-text, #f8fafc);
    border: 1px solid transparent;
  }

  .ds-btn-ghost:hover:not(.ds-btn-disabled) {
    background-color: var(--ds-color-surface-elevated, rgba(255, 255, 255, 0.08));
  }

  .ds-btn-gradient {
    background: linear-gradient(135deg, var(--ds-color-primary, #3b82f6) 0%, var(--ds-color-accent, #ec4899) 100%);
    color: #ffffff;
    border: none;
  }

  .ds-btn-gradient:hover:not(.ds-btn-disabled) {
    filter: brightness(1.15);
    box-shadow: 0 4px 15px rgba(236, 72, 153, 0.4);
    transform: translateY(-1px);
  }

  .ds-btn-disabled {
    opacity: 0.5;
    cursor: not-allowed;
    pointer-events: none;
  }
</style>
