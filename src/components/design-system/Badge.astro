---
interface Props {
  variant?: "neutral" | "primary" | "accent" | "success" | "warning" | undefined;
  size?: "sm" | "md" | undefined;
  class?: string | undefined;
}

const { variant = "neutral", size = "sm", class: className = "" } = Astro.props;
---

<span class={`ds-badge ds-badge-${variant} ds-badge-${size} ${className}`}>
  <slot />
</span>

<style>
  .ds-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--ds-space-1, 0.25rem);
    font-family: inherit;
    font-weight: 600;
    line-height: 1;
    border-radius: var(--ds-radius-pill, 9999px);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    box-sizing: border-box;
    width: fit-content;
  }

  .ds-badge-sm {
    padding: 0.2rem 0.5rem;
    font-size: 0.7rem;
  }

  .ds-badge-md {
    padding: 0.3rem 0.75rem;
    font-size: var(--ds-text-xs, 0.75rem);
  }

  .ds-badge-neutral {
    background-color: var(--ds-color-surface-elevated, rgba(255, 255, 255, 0.08));
    color: var(--ds-color-muted, #94a3b8);
    border: 1px solid var(--ds-color-border, rgba(255, 255, 255, 0.15));
  }

  .ds-badge-primary {
    background-color: rgba(59, 130, 246, 0.15);
    color: var(--ds-color-primary, #60a5fa);
    border: 1px solid rgba(59, 130, 246, 0.3);
  }

  .ds-badge-accent {
    background-color: rgba(245, 158, 11, 0.15);
    color: var(--ds-color-accent, #fbbf24);
    border: 1px solid rgba(245, 158, 11, 0.3);
  }

  .ds-badge-success {
    background-color: rgba(16, 185, 129, 0.15);
    color: #34d399;
    border: 1px solid rgba(16, 185, 129, 0.3);
  }

  .ds-badge-warning {
    background-color: rgba(239, 68, 68, 0.15);
    color: #f87171;
    border: 1px solid rgba(239, 68, 68, 0.3);
  }
</style>
