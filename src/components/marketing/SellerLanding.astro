<script>
  // Interactive lead form handler
  const form = document.getElementById("lead-contact-form") as HTMLFormElement | null;
  const successBox = document.getElementById("form-success-message");
  const submitBtn = document.getElementById("btn-submit-lead");
  const whatsappBtn = document.getElementById("success-whatsapp-btn") as HTMLAnchorElement | null;

  if (form && successBox && submitBtn) {
    form.addEventListener("submit", (e) => {
      e.preventDefault();

      const nameInput = (document.getElementById("lead-name") as HTMLInputElement)?.value || "";
      const emailInput = (document.getElementById("lead-email") as HTMLInputElement)?.value || "";
      const phoneInput = (document.getElementById("lead-phone") as HTMLInputElement)?.value || "";
      const businessInput = (document.getElementById("lead-business") as HTMLInputElement)?.value || "";
      const planInput = (document.getElementById("lead-plan") as HTMLSelectElement)?.value || "";
      const messageInput = (document.getElementById("lead-message") as HTMLTextAreaElement)?.value || "";

      // Construct customized WhatsApp link
      const text = encodeURIComponent(
        `Hola! Me gustaría cotizar una landing page para mi negocio.\n\n` +
        `• Nombre: ${nameInput}\n` +
        `• Email: ${emailInput}\n` +
        `• Tel/WhatsApp: ${phoneInput}\n` +
        `• Negocio: ${businessInput}\n` +
        `• Plan de interés: ${planInput}\n` +
        (messageInput ? `• Detalle: ${messageInput}` : "")
      );

      if (whatsappBtn) {
        whatsappBtn.href = `https://wa.me/?text=${text}`;
      }

      // Smooth feedback
      submitBtn.setAttribute("disabled", "true");
      submitBtn.innerHTML = "<span>Enviando...</span>";

      setTimeout(() => {
        submitBtn.style.display = "none";
        successBox.style.display = "block";
        successBox.scrollIntoView({ behavior: "smooth", block: "nearest" });
      }, 500);
    });
  }
</script>

