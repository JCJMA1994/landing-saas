---

<div class="seller-wrapper">
  <!-- Top Announcement Bar -->
  <div class="top-announcement">
    <div class="announcement-content">
      <span class="pulse-dot"></span>
      <span><strong>Servicio Activo:</strong> Tomando nuevos clientes para lanzamientos este mes</span>
      <a href="#contacto" class="announcement-link">Consultar disponibilidad &rarr;</a>
    </div>
  </div>

  <!-- Main Navigation Header -->
  <header class="main-nav">
    <div class="nav-container">
      <a href="/" class="brand-logo">
        <div class="brand-icon">
          <span>LS</span>
        </div>
        <div class="brand-text">
          <span class="brand-title">Landing SaaS</span>
          <span class="brand-tag">Studio & Engine</span>
        </div>
      </a>

      <nav class="nav-links">
        <a href="#beneficios">Beneficios</a>
        <a href="#plantillas">Diseños</a>
        <a href="#proceso">Cómo funciona</a>
        <a href="#precios">Planes</a>
        <a href="#faq">Preguntas</a>
      </nav>

      <div class="nav-actions">
        <a href="/admin/login" class="btn-client-login" title="Acceso para clientes dados de alta">
          <span class="icon-lock">🔒</span>
          Acceso Clientes
        </a>
        <a href="#contacto" class="btn-cta-nav">
          Quiero mi Landing
        </a>
      </div>
    </div>
  </header>

  <!-- Hero Section -->
  <section class="hero-section">
    <div class="hero-glow"></div>
    <div class="hero-container">
      <div class="hero-badge">
        <span class="badge-tag">Plataforma & Agencia</span>
        <span class="badge-divider">•</span>
        <span class="badge-desc">Landings de Alta Conversión con Dominios Propios</span>
      </div>

      <h1 class="hero-title">
        Creamos la landing que <span class="gradient-text">convierte tus visitas</span> en clientes reales
      </h1>

      <p class="hero-subtitle">
        Diseños prémium a medida, velocidad instantánea en el Edge, dominios propios y un <strong>panel privado exclusivo</strong> para que actualices tus contenidos y ofertas cuando quieras, sin depender de programadores.
      </p>

      <div class="hero-ctas">
        <a href="#contacto" class="btn-primary-glow">
          <span>Pedir mi Landing Ahora</span>
          <span class="btn-arrow">&rarr;</span>
        </a>
        <a href="#plantillas" class="btn-secondary-outline">
          <span>Ver Diseños Disponibles</span>
        </a>
      </div>

      <!-- Trust Metrics -->
      <div class="trust-grid">
        <div class="trust-item">
          <strong class="trust-value">&lt; 0.8s</strong>
          <span class="trust-label">Carga en el Edge</span>
        </div>
        <div class="trust-divider"></div>
        <div class="trust-item">
          <strong class="trust-value">100%</strong>
          <span class="trust-label">Autogestionable</span>
        </div>
        <div class="trust-divider"></div>
        <div class="trust-item">
          <strong class="trust-value">99.9%</strong>
          <span class="trust-label">Uptime & SSL</span>
        </div>
        <div class="trust-divider"></div>
        <div class="trust-item">
          <strong class="trust-value">48hs</strong>
          <span class="trust-label">Tiempo de Entrega</span>
        </div>
      </div>

      <!-- Interactive Live Template Showcase Mockup Simulator -->
      <div class="mockup-frame" id="live-mockup-stage">
        <div class="mockup-header">
          <div class="mockup-dots">
            <span class="dot red"></span>
            <span class="dot yellow"></span>
            <span class="dot green"></span>
          </div>
          <div class="mockup-url-bar">
            <span class="url-lock">🔒</span>
            <span class="url-text" id="mockup-url-display">friendly-saas.app</span>
            <span class="url-badge">EN VIVO</span>
          </div>
          <div class="mockup-admin-link">
            <span class="admin-pill">Simulador de Diseños Activo</span>
          </div>
        </div>

        <!-- Interactive Template Selector Bar -->
        <div class="mockup-template-tabs">
          <div class="tabs-label">
            <span class="tab-live-pulse"></span>
            <span>Explorá las 6 arquitecturas en vivo:</span>
          </div>
          <div class="tabs-list" role="tablist">
            {templateShowcase.map((t, idx) => (
              <button
                type="button"
                class={`mockup-tab-btn ${idx === 0 ? "active" : ""}`}
                data-template-target={t.key}
                role="tab"
                aria-selected={idx === 0 ? "true" : "false"}
                style={`--tab-accent: ${t.accent};`}
                title={`Ver diseño ${t.name}`}
              >
                <span class="tab-indicator-dot" style={`background: ${t.accent}; box-shadow: 0 0 6px ${t.accent};`}></span>
                <span class="tab-btn-title">{t.name}</span>
              </button>
            ))}
          </div>
          <!-- Auto-rotation progress indicator -->
          <div class="tab-progress-track">
            <div class="tab-progress-bar" id="mockup-progress-bar"></div>
          </div>
        </div>

        <div class="mockup-viewport" id="mockup-viewport-stage">
          {templateShowcase.map((t, idx) => (
            <div
              class={`mockup-template-panel panel-${t.key} ${idx === 0 ? "active" : ""}`}
              id={`panel-${t.key}`}
              data-template-key={t.key}
              data-mock-url={t.mockUrl}
              style={`--panel-accent: ${t.accent};`}
            >
              <!-- Visual Hero preview inside template -->
              <div class="mockup-hero-preview">
                <div class="preview-badge" style={`color: ${t.accent}; background: ${t.accent}15; border-color: ${t.accent}35;`}>
                  {t.mockBadge}
                </div>
                <h3 class="preview-heading">{t.mockHeadline}</h3>
                <p class="preview-sub">{t.mockSub}</p>
                <div class="preview-action-row">
                  <span class="preview-btn-main" style={`background: ${t.accent}; color: #060a14;`}>
                    {t.btnMain}
                  </span>
                  <span class="preview-btn-ghost">
                    {t.btnGhost}
                  </span>
                </div>
              </div>

              <!-- Visual Features / Modules inside template -->
              <div class="mockup-features-row">
                {t.features.map((feat, featIdx) => (
                  <div class={`preview-card ${featIdx === 1 ? "highlight" : ""}`} style={featIdx === 1 ? `border-color: ${t.accent}50; background: ${t.accent}0a;` : ""}>
                    <div class="preview-card-top">
                      <span class="card-icon">{feat.icon}</span>
                      <span class="card-metric" style={`color: ${t.accent};`}>{feat.metric}</span>
                    </div>
                    <strong>{feat.title}</strong>
                    <p>{feat.desc}</p>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Value Propositions / Benefits -->
  <section id="beneficios" class="section-padding">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Por qué trabajar con nosotros</span>
        <h2 class="section-title">Tecnología de élite pensada para vender</h2>
        <p class="section-desc">
          No te entregamos un sitio genérico ni un WordPress vulnerable. Te entregamos un activo digital de alto rendimiento configurado y listo para generar ingresos.
        </p>
      </div>

      <div class="features-grid">
        {features.map((feat) => (
          <div class="feature-card reveal-on-scroll">
            <div class="feature-icon">{feat.icon}</div>
            <h3 class="feature-title">{feat.title}</h3>
            <p class="feature-description">{feat.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Showcase of Design Architectures -->
  <section id="plantillas" class="section-padding bg-alt">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Direcciones Visuales</span>
        <h2 class="section-title">Diseños con personalidad propia</h2>
        <p class="section-desc">
          Cada industria tiene su propio ritmo y lenguaje. Nuestras arquitecturas visuales están estudiadas para generar empatía y autoridad según tu rubro.
        </p>
      </div>

      <div class="templates-grid">
        {templateShowcase.map((t) => (
          <article class="template-card reveal-on-scroll" style={`--card-accent: ${t.accent}; --card-glow: ${t.accent}33;`}>
            <div class="template-card-header">
              <div class="template-meta">
                <span class="template-category">{t.category}</span>
                <span class="template-badge" style={`color: ${t.accent}; background: ${t.accent}18; border: 1px solid ${t.accent}35;`}>
                  {t.badge}
                </span>
              </div>
              <h3 class="template-name">{t.name}</h3>
              <p class="template-desc">{t.description}</p>
            </div>

            <!-- Architectural Mini-Preview Bar -->
            <div class="template-preview-bar">
              <div class="preview-bar-header">
                <span class="preview-indicator" style={`background: ${t.accent}; box-shadow: 0 0 8px ${t.accent};`}></span>
                <span class="preview-slug">theme/{t.key}</span>
              </div>
              <div class="preview-skeleton-lines">
                <div class="skeleton-line" style={`width: 70%; background: ${t.accent}40;`}></div>
                <div class="skeleton-line" style={`width: 45%; background: rgba(255,255,255,0.08);`}></div>
              </div>
            </div>

            <div class="template-tags">
              {t.tags.map((tag) => (
                <span class="template-tag">#{tag}</span>
              ))}
            </div>

            <div class="template-card-footer">
              <button
                type="button"
                class="btn-preview-switch"
                data-switch-to={t.key}
                title={`Ver animación en vivo del diseño ${t.name}`}
              >
                <span>👁️ Probar diseño animado &uarr;</span>
              </button>
              <a href="#contacto" class="btn-template-select">
                Solicitar este estilo &rarr;
              </a>
            </div>
          </article>
        ))}
      </div>

      <!-- Real Published Sites (if any exist) -->
      {publishedSites.length > 0 && (
        <div class="live-sites-block">
          <div class="live-sites-header">
            <h3>Sitios Activos en la Plataforma</h3>
            <p>Proyectos en producción creados con nuestra arquitectura.</p>
          </div>
          <div class="live-sites-grid">
            {publishedSites.map((site) => (
              <div class="live-site-card">
                <div class="live-site-info">
                  <strong>{site.name}</strong>
                  <span class="site-slug">/{site.slug}</span>
                </div>
                <div class="live-site-meta">
                  <span class="badge-version">v{site.version} activa</span>
                  <a href={`/sites/${site.slug}`} class="live-site-link">Ver sitio &nearr;</a>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- 3-Step Process -->
  <section id="proceso" class="section-padding">
    <div class="container">
