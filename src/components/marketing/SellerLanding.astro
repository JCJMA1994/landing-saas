  }


  /* Templates Showcase & 3D Flip Card System */
  .templates-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
    margin-bottom: 3.5rem;
  }

  .flip-card {
    perspective: 1400px;
    height: 535px;
    position: relative;
    cursor: pointer;
    user-select: none;
  }

  .flip-card-inner {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transition: transform 0.65s cubic-bezier(0.2, 0.85, 0.25, 1);
    border-radius: 1rem;
  }

  .flip-card.is-flipped .flip-card-inner {
    transform: rotateY(180deg);
  }

  .flip-card-front,
  .flip-card-back {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    border-radius: 1rem;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 1.75rem;
    box-sizing: border-box;
    background: #0d1527;
    border: 1px solid #1e293b;
    box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.5);
  }

  .flip-card-front::before,
  .flip-card-back::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--card-accent, #38bdf8);
  }

  .flip-card-front {
    z-index: 2;
    transform: rotateY(0deg);
  }

  .flip-card-front:hover {
    border-color: rgba(255, 255, 255, 0.25);
    box-shadow: 0 20px 40px -15px var(--card-glow, rgba(56, 189, 248, 0.3));
  }

  .flip-card-back {
    transform: rotateY(180deg);
    z-index: 1;
    background: #080d1a;
  }

