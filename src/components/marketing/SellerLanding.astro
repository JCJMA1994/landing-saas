    font-size: 1.05rem;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-secondary-outline:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.3);
  }

  /* Trust Metrics */
  .trust-grid {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
    padding: 1.5rem 2rem;
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 1rem;
    margin-bottom: 4rem;
  }

  .trust-item {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .trust-value {
    font-size: 1.4rem;
    font-weight: 900;
    color: #38bdf8;
    letter-spacing: -0.02em;
  }

  .trust-label {
    font-size: 0.8rem;
    color: #94a3b8;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 600;
  }

  .trust-divider {
    width: 1px;
    height: 2rem;
    background: rgba(255, 255, 255, 0.1);
  }

  /* Mockup Frame */
  .mockup-frame {
    background: #0d1527;
    border: 1px solid #1e293b;
    border-radius: 1.25rem;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.7), 0 0 40px rgba(56, 189, 248, 0.1);
    overflow: hidden;
    text-align: left;
    animation: floatSlow 8s ease-in-out infinite;
    transition: box-shadow 0.3s ease, border-color 0.3s ease;
  }

  .mockup-frame:hover {
    box-shadow: 0 30px 60px -12px rgba(0, 0, 0, 0.8), 0 0 50px rgba(56, 189, 248, 0.25);
    border-color: rgba(56, 189, 248, 0.35);
  }

  .mockup-header {
    background: #090e1a;
    padding: 0.85rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid #1e293b;
    gap: 1rem;
  }

  .mockup-dots {
    display: flex;
    gap: 0.4rem;
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .dot.red { background: #ef4444; }
  .dot.yellow { background: #f59e0b; }
  .dot.green { background: #10b981; }

  .mockup-url-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: #111b2f;
    padding: 0.35rem 1rem;
    border-radius: 0.4rem;
    font-size: 0.8rem;
    color: #94a3b8;
    font-family: monospace;
  }

  .url-badge {
    background: rgba(16, 185, 129, 0.15);
    color: #10b981;
    font-size: 0.65rem;
    font-weight: 700;
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
  }

  .admin-pill {
    font-size: 0.75rem;
    color: #f59e0b;
    background: rgba(245, 158, 11, 0.15);
    border: 1px solid rgba(245, 158, 11, 0.3);
    padding: 0.25rem 0.6rem;
    border-radius: 9999px;
    font-weight: 600;
  }

  /* Mockup Template Tabs Bar */
  .mockup-template-tabs {
    background: #070c18;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding: 0.85rem 1.25rem 0.65rem;
  }

  .tabs-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.78rem;
    font-weight: 700;
    color: #94a3b8;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.65rem;
  }

  .tab-live-pulse {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 8px #10b981;
    display: inline-block;
    animation: pulse 1.8s infinite;
  }

  .tabs-list {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .mockup-tab-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 9999px;
    padding: 0.35rem 0.85rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: #94a3b8;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .mockup-tab-btn:hover {
    color: #f8fafc;
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.2);
  }

  .mockup-tab-btn.active {
    background: var(--tab-accent, #38bdf8);
    color: #060a14;
    border-color: var(--tab-accent, #38bdf8);
    font-weight: 800;
    box-shadow: 0 2px 12px var(--tab-accent, rgba(56, 189, 248, 0.4));
    transform: translateY(-1px);
  }

  .tab-indicator-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }

  .mockup-tab-btn.active .tab-indicator-dot {
    background: #060a14 !important;
    box-shadow: none !important;
  }

  .tab-progress-track {
    width: 100%;
    height: 3px;
    background: rgba(255, 255, 255, 0.06);
    border-radius: 2px;
    overflow: hidden;
    margin-top: 0.85rem;
  }

  .tab-progress-bar {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, #38bdf8, #818cf8, #a855f7);
    border-radius: 2px;
  }

  .mockup-viewport {
    padding: 2.5rem 2rem;
    background: radial-gradient(circle at top right, #13203c 0%, #0d1527 60%);
    position: relative;
    overflow: hidden;
  }

  /* Mockup Stage & Panels */
  .mockup-template-panel {
    display: none;
    opacity: 0;
    transform: translateY(10px) scale(0.99);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .mockup-template-panel.active {
    display: block;
    opacity: 1;
    transform: translateY(0) scale(1);
    animation: panelSlideIn 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes panelSlideIn {
    from {
      opacity: 0;
      transform: translateY(12px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .mockup-hero-preview {
    text-align: center;
    max-width: 36rem;
    margin: 0 auto 2.5rem;
  }

  .preview-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    color: #38bdf8;
    background: rgba(56, 189, 248, 0.1);
    border: 1px solid rgba(56, 189, 248, 0.3);
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    margin-bottom: 1rem;
  }

  .preview-heading {
    font-size: 1.6rem;
    font-weight: 800;
    line-height: 1.25;
    color: #f8fafc;
    margin-bottom: 0.75rem;
  }

  .preview-sub {
    font-size: 0.95rem;
    color: #94a3b8;
    margin-bottom: 1.5rem;
  }

  .preview-action-row {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .preview-btn-main {
    padding: 0.6rem 1.25rem;
    background: #10b981;
    color: #060a14;
    border-radius: 0.5rem;
    font-weight: 700;
    font-size: 0.85rem;
  }

  .preview-btn-ghost {
    padding: 0.6rem 1.25rem;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #e2e8f0;
    border-radius: 0.5rem;
    font-weight: 600;
    font-size: 0.85rem;
  }

  .mockup-features-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1rem;
  }

  .preview-card {
    background: rgba(17, 27, 47, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 0.75rem;
    padding: 1.25rem;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .preview-card:hover {
    transform: translateY(-3px);
  }

  .preview-card.highlight {
    border-color: rgba(56, 189, 248, 0.4);
    background: rgba(56, 189, 248, 0.05);
  }

  .preview-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }

  .card-metric {
    font-size: 0.72rem;
    font-weight: 800;
    font-family: monospace;
    background: rgba(255, 255, 255, 0.05);
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
  }

  .card-icon {
    font-size: 1.3rem;
    display: block;
  }

  .preview-card strong {
    display: block;
    font-size: 0.95rem;
    color: #f1f5f9;
    margin-bottom: 0.25rem;
  }

  .preview-card p {
    font-size: 0.8rem;
    color: #94a3b8;
    margin: 0;
    line-height: 1.4;
  }

  /* Stage Highlight Pulse when clicked from templates grid */
  .mockup-highlight-pulse {
    animation: stagePulse 1.2s ease-out;
  }

  @keyframes stagePulse {
    0% {
      box-shadow: 0 0 0 0 rgba(56, 189, 248, 0.8);
      border-color: #38bdf8;
    }
    50% {
      box-shadow: 0 0 45px 10px rgba(56, 189, 248, 0.5);
      border-color: #38bdf8;
    }
    100% {
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.7), 0 0 40px rgba(56, 189, 248, 0.1);
      border-color: #1e293b;
    }
  }

  /* Distinct visual aesthetic per template panel */
  .panel-friendly-tech .preview-heading {
    color: #f0fdf4;
  }

  .panel-tech-diagnostic {
    background: radial-gradient(circle at top right, #151e3f 0%, #0d1527 70%);
  }
  .panel-tech-diagnostic .preview-card {
    border-left: 2px solid #818cf8;
  }

  .panel-cyber-performance {
    background: radial-gradient(circle at top right, #240e3f 0%, #080c1a 70%);
  }
  .panel-cyber-performance .preview-heading {
    text-shadow: 0 0 20px rgba(168, 85, 247, 0.4);
  }
  .panel-cyber-performance .preview-card {
    border-color: rgba(168, 85, 247, 0.25);
    background: rgba(168, 85, 247, 0.04);
  }

  .panel-system-monitor {
    background: radial-gradient(circle at top right, #092823 0%, #05121b 70%);
  }
  .panel-system-monitor .preview-heading {
    font-family: monospace;
    letter-spacing: -0.02em;
  }

  .panel-repair-workshop {
    background: radial-gradient(circle at top right, #2b1d09 0%, #0e121a 70%);
  }
  .panel-repair-workshop .preview-card {
    border-top: 2px solid #f59e0b;
  }

  .panel-tech-editorial {
    background: radial-gradient(circle at top right, #2c0f1b 0%, #0b0f19 70%);
  }
  .panel-tech-editorial .preview-heading {
    font-family: serif, system-ui;
    font-style: italic;
    font-weight: 700;
  }

  /* Button inside template cards to trigger live preview */
  .btn-preview-switch {
    width: 100%;
    padding: 0.65rem 1rem;
    margin-bottom: 0.5rem;
    background: rgba(56, 189, 248, 0.08);
    border: 1px solid rgba(56, 189, 248, 0.25);
    border-radius: 0.5rem;
    color: #38bdf8;
    font-size: 0.85rem;
    font-weight: 700;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    transition: all 0.2s ease;
  }

  .btn-preview-switch:hover {
    background: #38bdf8;
    color: #060a14;
    transform: translateY(-2px);
    box-shadow: 0 4px 14px rgba(56, 189, 248, 0.35);
  }

  /* Section Headers */
  .section-header {
    text-align: center;
    max-width: 44rem;
    margin: 0 auto 4rem;
  }

  .section-eyebrow {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #38bdf8;
    margin-bottom: 0.75rem;
  }

  .section-title {
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 1.2;
    margin: 0 0 1rem;
    color: #f8fafc;
  }

  .section-desc {
    font-size: 1.1rem;
    color: #94a3b8;
    margin: 0;
    line-height: 1.6;
  }

  /* Features Grid */
  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .feature-card {
    background: #0d1527;
    border: 1px solid #1e293b;
    border-radius: 1rem;
    padding: 2rem;
    transition: all 0.25s ease;
  }

  .feature-card:hover {
    transform: translateY(-4px);
    border-color: rgba(56, 189, 248, 0.4);
    box-shadow: 0 12px 24px -6px rgba(0, 0, 0, 0.5);
  }

  .feature-icon {
    font-size: 2rem;
    margin-bottom: 1rem;
  }

  .feature-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: #f8fafc;
    margin: 0 0 0.75rem;
  }

  .feature-description {
    font-size: 0.95rem;
    color: #94a3b8;
    margin: 0;
    line-height: 1.6;
  }

  /* Templates Showcase */
  .templates-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.75rem;
    margin-bottom: 3rem;
  }

  .template-card {
    background: #0d1527;
    border: 1px solid #1e293b;
    border-radius: 1rem;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
    overflow: hidden;
  }

  .template-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--card-accent, #38bdf8);
  }

  .template-card:hover {
    transform: translateY(-8px);
    border-color: rgba(255, 255, 255, 0.25);
    box-shadow: 0 20px 40px -15px var(--card-glow, rgba(56, 189, 248, 0.3));
  }

  /* Architectural Mini-Preview Bar */
  .template-preview-bar {
    background: rgba(4, 7, 14, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 0.6rem;
    padding: 0.85rem 1rem;
    margin: 0.5rem 0 1.25rem;
  }

  .preview-bar-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.6rem;
  }

  .preview-indicator {
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }

  .preview-slug {
    font-size: 0.72rem;
    color: #64748b;
    font-family: monospace;
  }

  .preview-skeleton-lines {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .skeleton-line {
    height: 4px;
    border-radius: 2px;
  }

  .template-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }

  .template-category {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 700;
    color: #94a3b8;
  }

  .template-badge {
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.2rem 0.6rem;
    border-radius: 9999px;
  }

  .template-name {
    font-size: 1.35rem;
    font-weight: 800;
    color: #f8fafc;
    margin: 0 0 0.75rem;
  }

  .template-desc {
    font-size: 0.9rem;
    color: #94a3b8;
    line-height: 1.55;
    margin: 0 0 1.5rem;
  }

  .template-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1.75rem;
  }

  .template-tag {
    font-size: 0.75rem;
    color: #64748b;
    background: rgba(255, 255, 255, 0.03);
    padding: 0.2rem 0.5rem;
    border-radius: 0.3rem;
  }

  .btn-template-select {
    display: block;
    text-align: center;
    padding: 0.75rem 1rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 0.5rem;
    color: #f8fafc;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-template-select:hover {
    background: #38bdf8;
    color: #060a14;
    border-color: #38bdf8;
  }

  /* Live Sites Block */
  .live-sites-block {
    margin-top: 4rem;
    padding: 2.5rem;
    background: #090e1a;
    border: 1px solid #1e293b;
    border-radius: 1rem;
  }

  .live-sites-header h3 {
    font-size: 1.25rem;
    margin: 0 0 0.25rem;
    color: #f8fafc;
  }

  .live-sites-header p {
    font-size: 0.9rem;
    color: #94a3b8;
    margin: 0 0 1.5rem;
  }

  .live-sites-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1rem;
  }

  .live-site-card {
    background: #0d1527;
    border: 1px solid #1e293b;
    border-radius: 0.6rem;
    padding: 1rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .live-site-info strong {
    display: block;
    font-size: 0.95rem;
    color: #f8fafc;
  }

  .site-slug {
    font-size: 0.75rem;
    color: #38bdf8;
    font-family: monospace;
  }

  .live-site-meta {
    text-align: right;
  }

  .badge-version {
    display: block;
    font-size: 0.7rem;
    color: #10b981;
    margin-bottom: 0.25rem;
  }

  .live-site-link {
    font-size: 0.8rem;
    color: #cbd5e1;
    text-decoration: none;
    font-weight: 600;
  }

  .live-site-link:hover {
    color: #38bdf8;
  }

  /* 3-Step Process */
  .steps-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
  }

  .step-card {
    background: #0d1527;
    border: 1px solid #1e293b;
    border-radius: 1rem;
    padding: 2.5rem 2rem;
    position: relative;
  }

  .step-num {
    font-size: 2.5rem;
    font-weight: 900;
    color: #38bdf8;
    opacity: 0.7;
    letter-spacing: -0.05em;
    margin-bottom: 1rem;
  }

  .step-title {
    font-size: 1.25rem;
    font-weight: 800;
    color: #f8fafc;
    margin: 0 0 0.75rem;
  }

  .step-desc {
    font-size: 0.95rem;
    color: #94a3b8;
    line-height: 1.6;
    margin: 0;
  }

  /* Pricing Grid */
  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
    gap: 2rem;
    align-items: stretch;
  }

  .pricing-card {
    background: #0d1527;
    border: 1px solid #1e293b;
    border-radius: 1.25rem;
    padding: 2.5rem 2rem;
    display: flex;
    flex-direction: column;
    position: relative;
    transition: transform 0.25s ease;
  }

  .pricing-card.featured {
    border-color: #38bdf8;
    background: linear-gradient(180deg, #101c37 0%, #0d1527 100%);
    box-shadow: 0 10px 30px -10px rgba(56, 189, 248, 0.3);
    transform: scale(1.02);
  }

  .featured-badge {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: linear-gradient(135deg, #38bdf8, #6366f1);
    color: #060a14;
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.3rem 0.9rem;
    border-radius: 9999px;
  }

  .plan-name {
    font-size: 1.35rem;
    font-weight: 800;
    color: #f8fafc;
    margin: 0 0 0.5rem;
  }

  .plan-price-row {
    display: flex;
    align-items: baseline;
    gap: 0.3rem;
    margin-bottom: 1rem;
  }

  .plan-price {
    font-size: 2.75rem;
    font-weight: 900;
    color: #f8fafc;
    letter-spacing: -0.03em;
  }

  .plan-period {
    font-size: 0.95rem;
    color: #94a3b8;
  }

  .plan-description {
    font-size: 0.9rem;
    color: #94a3b8;
    line-height: 1.5;
    margin: 0 0 2rem;
    min-height: 2.7rem;
  }

  .plan-features {
    list-style: none;
    padding: 0;
    margin: 0 0 2.5rem;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .plan-features li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-size: 0.9rem;
    color: #cbd5e1;
    line-height: 1.45;
  }

  .check-icon {
    color: #38bdf8;
    font-weight: 800;
  }

  .btn-plan {
    display: block;
    text-align: center;
    padding: 0.85rem 1.5rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 0.6rem;
