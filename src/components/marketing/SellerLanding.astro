    width: 40%;
    background: #818cf8;
    box-shadow: 0 0 10px #818cf8;
    animation: scannerMove 1.8s ease-in-out infinite alternate;
  }
  @keyframes scannerMove {
    0% { transform: translateX(-50%); }
    100% { transform: translateX(250%); }
  }
  .diag-grid-chips {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-family: monospace;
    font-size: 0.72rem;
    margin-bottom: 0.75rem;
  }
  .diag-chip {
    display: flex;
    justify-content: space-between;
    padding: 0.35rem 0.6rem;
    background: rgba(129, 140, 248, 0.08);
    border-left: 3px solid #818cf8;
    border-radius: 3px;
  }
  .diag-chip strong {
    color: #a5b4fc;
  }
  .diag-btn {
    display: block;
    text-align: center;
    background: rgba(129, 140, 248, 0.15);
    border: 1px solid #818cf8;
    color: #818cf8;
    font-size: 0.72rem;
    font-weight: 800;
    font-family: monospace;
    padding: 0.45rem;
    border-radius: 3px;
  }

  /* Cyber Performance */
  .cyber-chamfer-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.45rem;
  }
  .cyber-badge {
    font-size: 0.7rem;
    font-weight: 900;
    color: #a855f7;
    letter-spacing: 0.05em;
  }
  .cyber-hz {
    font-size: 0.85rem;
    font-weight: 900;
    font-family: monospace;
    color: #38bdf8;
    text-shadow: 0 0 10px rgba(56, 189, 248, 0.7);
  }
  .cyber-energy-line {
    height: 2px;
    background: linear-gradient(90deg, #a855f7, #38bdf8);
    box-shadow: 0 0 12px #a855f7;
    margin-bottom: 0.75rem;
  }
  .cyber-spec-matrix {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.72rem;
    font-family: monospace;
    margin-bottom: 0.75rem;
  }
  .cyber-spec-row {
    display: flex;
    justify-content: space-between;
    padding: 0.3rem 0.5rem;
    background: rgba(168, 85, 247, 0.08);
    border-radius: 3px;
    clip-path: polygon(0 0, calc(100% - 6px) 0, 100% 6px, 100% 100%, 6px 100%, 0 calc(100% - 6px));
  }
  .cyber-glow-val {
    color: #f0abfc;
  }
  .cyber-btn {
    display: block;
    text-align: center;
    background: linear-gradient(90deg, #a855f7, #6366f1);
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    padding: 0.45rem;
    border-radius: 3px;
  }

  /* System Monitor */
  .terminal-command-line {
    font-family: monospace;
    font-size: 0.74rem;
    background: #030712;
    padding: 0.4rem 0.6rem;
    border-radius: 4px;
    border: 1px solid rgba(52, 211, 153, 0.2);
    margin-bottom: 0.65rem;
  }
  .term-user {
    color: #34d399;
    font-weight: 700;
    margin-right: 0.35rem;
  }
  .term-cmd {
    color: #f1f5f9;
  }
  .term-nodes-list {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-family: monospace;
    font-size: 0.7rem;
    margin-bottom: 0.65rem;
  }
  .term-node-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.25rem 0.45rem;
    background: rgba(52, 211, 153, 0.05);
    border-radius: 3px;
  }
  .node-live {
    color: #34d399;
    font-size: 0.6rem;
    margin-right: 0.3rem;
    animation: pulse 1.5s infinite;
  }
  .node-state {
    color: #34d399;
    font-weight: 700;
  }
  .term-uptime-bar {
    text-align: center;
    font-family: monospace;
    font-size: 0.68rem;
    font-weight: 700;
    color: #34d399;
    background: rgba(52, 211, 153, 0.1);
    padding: 0.35rem;
    border-radius: 3px;
    border: 1px solid rgba(52, 211, 153, 0.25);
  }

  /* Repair Workshop */
  .workshop-ticket-top {
    display: flex;
    justify-content: space-between;
    font-size: 0.7rem;
    font-weight: 800;
    font-family: monospace;
    color: #f59e0b;
    margin-bottom: 0.55rem;
    padding-bottom: 0.35rem;
    border-bottom: 1px dashed rgba(245, 158, 11, 0.4);
  }
  .workshop-service-box {
    font-size: 0.78rem;
    margin-bottom: 0.65rem;
  }
  .workshop-service-box strong {
    display: block;
    color: #f8fafc;
    font-size: 0.82rem;
    margin-bottom: 0.2rem;
  }
  .workshop-service-box p {
    margin: 0;
    color: #94a3b8;
    font-size: 0.72rem;
  }
  .workshop-parts-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.68rem;
    color: #f59e0b;
    background: rgba(245, 158, 11, 0.08);
    padding: 0.35rem 0.5rem;
    border-radius: 3px;
    margin-bottom: 0.65rem;
  }
  .workshop-wa {
    display: block;
    text-align: center;
    background: #f59e0b;
    color: #060a14;
    font-size: 0.76rem;
    font-weight: 800;
    padding: 0.45rem;
    border-radius: 4px;
  }

  /* Tech Editorial */
  .editorial-volume {
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: #f43f5e;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
  }
  .editorial-headline {
    font-family: serif, system-ui;
    font-style: italic;
    font-size: 1.05rem;
    font-weight: 700;
    color: #ffffff;
    line-height: 1.35;
    margin: 0 0 0.5rem;
  }
  .editorial-pullquote {
    margin: 0 0 0.5rem;
    padding-left: 0.75rem;
    border-left: 2px solid #f43f5e;
    font-size: 0.75rem;
    color: #94a3b8;
    font-style: italic;
  }
  .editorial-author-row {
    font-size: 0.68rem;
    color: #64748b;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Live Sites Block */
  .live-sites-block {
    margin-top: 4rem;
    padding: 2.5rem;
    background: #090e1a;
    border: 1px solid #1e293b;
    border-radius: 1rem;
  }

  .live-sites-header h3 {
    font-size: 1.25rem;
    margin: 0 0 0.25rem;
    color: #f8fafc;
  }

  .live-sites-header p {
    font-size: 0.9rem;
    color: #94a3b8;
    margin: 0 0 1.5rem;
  }

  .live-sites-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1rem;
  }

  .live-site-card {
    background: #0d1527;
    border: 1px solid #1e293b;
    border-radius: 0.6rem;
    padding: 1rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .live-site-info strong {
    display: block;
    font-size: 0.95rem;
    color: #f8fafc;
  }

  .site-slug {
    font-size: 0.75rem;
    color: #38bdf8;
    font-family: monospace;
  }

  .live-site-meta {
    text-align: right;
  }

  .badge-version {
    display: block;
    font-size: 0.7rem;
    color: #10b981;
    margin-bottom: 0.25rem;
  }

  .live-site-link {
    font-size: 0.8rem;
    color: #cbd5e1;
    text-decoration: none;
    font-weight: 600;
  }

  .live-site-link:hover {
    color: #38bdf8;
  }

  /* 3-Step Process */
  .steps-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
  }

  .step-card {
    background: #0d1527;
    border: 1px solid #1e293b;
    border-radius: 1rem;
    padding: 2.5rem 2rem;
    position: relative;
  }

  .step-num {
    font-size: 2.5rem;
    font-weight: 900;
    color: #38bdf8;
    opacity: 0.7;
    letter-spacing: -0.05em;
    margin-bottom: 1rem;
  }

  .step-title {
    font-size: 1.25rem;
    font-weight: 800;
    color: #f8fafc;
    margin: 0 0 0.75rem;
  }

  .step-desc {
    font-size: 0.95rem;
    color: #94a3b8;
    line-height: 1.6;
    margin: 0;
  }

  /* Pricing Grid */
  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
    gap: 2rem;
    align-items: stretch;
  }

  .pricing-card {
    background: #0d1527;
    border: 1px solid #1e293b;
    border-radius: 1.25rem;
    padding: 2.5rem 2rem;
    display: flex;
    flex-direction: column;
    position: relative;
    transition: transform 0.25s ease;
  }

  .pricing-card.featured {
    border-color: #38bdf8;
    background: linear-gradient(180deg, #101c37 0%, #0d1527 100%);
    box-shadow: 0 10px 30px -10px rgba(56, 189, 248, 0.3);
    transform: scale(1.02);
  }

  .featured-badge {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: linear-gradient(135deg, #38bdf8, #6366f1);
    color: #060a14;
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.3rem 0.9rem;
    border-radius: 9999px;
  }

  .plan-name {
    font-size: 1.35rem;
    font-weight: 800;
    color: #f8fafc;
    margin: 0 0 0.5rem;
  }

  .plan-price-row {
    display: flex;
    align-items: baseline;
    gap: 0.3rem;
    margin-bottom: 1rem;
  }

  .plan-price {
    font-size: 2.75rem;
    font-weight: 900;
    color: #f8fafc;
    letter-spacing: -0.03em;
  }

  .plan-period {
    font-size: 0.95rem;
    color: #94a3b8;
  }

  .plan-description {
    font-size: 0.9rem;
    color: #94a3b8;
    line-height: 1.5;
    margin: 0 0 2rem;
    min-height: 2.7rem;
  }

  .plan-features {
    list-style: none;
    padding: 0;
    margin: 0 0 2.5rem;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .plan-features li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-size: 0.9rem;
    color: #cbd5e1;
    line-height: 1.45;
  }

  .check-icon {
    color: #38bdf8;
    font-weight: 800;
  }

  .btn-plan {
    display: block;
    text-align: center;
    padding: 0.85rem 1.5rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 0.6rem;
    color: #f8fafc;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-plan:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.3);
  }

  .btn-plan-featured {
    background: linear-gradient(135deg, #38bdf8, #6366f1);
    color: #060a14;
    border: none;
    box-shadow: 0 4px 14px rgba(56, 189, 248, 0.3);
  }

  .btn-plan-featured:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(56, 189, 248, 0.45);
    color: #060a14;
  }

  /* Contact & Lead Capture Section */
  .contact-card-wrapper {
    background: #0d1527;
    border: 1px solid #1e293b;
    border-radius: 1.5rem;
    padding: 3.5rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3.5rem;
    box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.6);
  }

  .contact-headline {
    font-size: 2.25rem;
    font-weight: 900;
    line-height: 1.2;
    letter-spacing: -0.03em;
    color: #f8fafc;
    margin: 0 0 1rem;
  }

  .contact-subtext {
    font-size: 1.05rem;
    color: #94a3b8;
    line-height: 1.6;
    margin: 0 0 2.5rem;
  }

  .contact-direct-box {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .direct-item {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .direct-icon {
    font-size: 1.5rem;
    background: rgba(255, 255, 255, 0.05);
    padding: 0.6rem;
    border-radius: 0.6rem;
  }

  .direct-item strong {
    display: block;
    color: #f8fafc;
    font-size: 1rem;
    margin-bottom: 0.25rem;
  }

  .direct-item p {
    font-size: 0.85rem;
    color: #94a3b8;
    margin: 0 0 0.5rem;
    line-height: 1.4;
  }

  .whatsapp-link {
    color: #10b981;
    font-weight: 700;
    font-size: 0.9rem;
    text-decoration: none;
  }

  .whatsapp-link:hover {
    text-decoration: underline;
  }

  /* Lead Form */
  .lead-form {
    background: #080d19;
    border: 1px solid #1e293b;
    border-radius: 1rem;
    padding: 2.5rem;
  }

  .form-title-row h3 {
    font-size: 1.25rem;
    color: #f8fafc;
    margin: 0 0 0.25rem;
  }

  .form-title-row p {
    font-size: 0.85rem;
    color: #94a3b8;
    margin: 0 0 1.75rem;
  }

  .form-group {
    margin-bottom: 1.25rem;
  }

  .form-group label {
    display: block;
    font-size: 0.85rem;
    font-weight: 600;
    color: #cbd5e1;
    margin-bottom: 0.4rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .lead-form input,
  .lead-form select,
  .lead-form textarea {
    width: 100%;
    background: #0d1527;
    border: 1px solid #243555;
    border-radius: 0.5rem;
    padding: 0.75rem 1rem;
    color: #f8fafc;
    font-size: 0.9rem;
    font-family: inherit;
    box-sizing: border-box;
    transition: border-color 0.2s ease;
  }

  .lead-form input:focus,
  .lead-form select:focus,
  .lead-form textarea:focus {
    outline: none;
    border-color: #38bdf8;
    box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.15);
  }

  .btn-submit-lead {
    width: 100%;
    padding: 0.9rem;
    background: linear-gradient(135deg, #38bdf8, #6366f1);
    color: #060a14;
    border: none;
    border-radius: 0.5rem;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    transition: all 0.2s ease;
    margin-top: 0.5rem;
  }

  .btn-submit-lead:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 16px rgba(56, 189, 248, 0.4);
  }

  .form-success-box {
    text-align: center;
    padding: 1.5rem;
    background: rgba(16, 185, 129, 0.1);
    border: 1px solid rgba(16, 185, 129, 0.3);
    border-radius: 0.75rem;
    margin-top: 1rem;
  }

  .success-icon {
    font-size: 2rem;
    margin-bottom: 0.5rem;
  }

  .form-success-box h4 {
    font-size: 1.15rem;
    color: #34d399;
    margin: 0 0 0.5rem;
  }

  .form-success-box p {
    font-size: 0.85rem;
    color: #94a3b8;
    margin: 0 0 1.25rem;
  }

  .whatsapp-action-btn {
    display: inline-block;
    padding: 0.7rem 1.25rem;
    background: #10b981;
    color: #060a14;
    border-radius: 0.5rem;
    font-weight: 700;
    font-size: 0.85rem;
    text-decoration: none;
  }

  /* FAQ Accordion */
  .faq-accordion-list {
    max-width: 50rem;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .faq-accordion-item {
    background: #0b1222;
    border: 1px solid #1e293b;
    border-radius: 0.85rem;
    overflow: hidden;
    transition: all 0.25s ease;
  }

  .faq-accordion-item:hover {
    border-color: rgba(56, 189, 248, 0.35);
  }

  .faq-accordion-item[open] {
    border-color: #38bdf8;
    background: #0d172e;
    box-shadow: 0 10px 25px -5px rgba(56, 189, 248, 0.12);
  }

  .faq-summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.35rem 1.75rem;
    cursor: pointer;
    user-select: none;
    list-style: none;
    font-size: 1.1rem;
    font-weight: 700;
    color: #f8fafc;
    transition: color 0.15s ease;
  }

  .faq-summary::-webkit-details-marker {
    display: none;
  }

  .faq-accordion-item[open] .faq-summary {
    color: #38bdf8;
  }

  .faq-toggle-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.05);
    color: #94a3b8;
    font-size: 1.3rem;
    font-weight: 400;
    line-height: 1;
    transition: transform 0.25s ease, background-color 0.25s ease, color 0.25s ease;
  }

  .faq-accordion-item[open] .faq-toggle-icon {
    transform: rotate(45deg);
    background: rgba(56, 189, 248, 0.2);
    color: #38bdf8;
  }

  .faq-body {
    padding: 0 1.75rem 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.04);
  }

  .faq-answer {
    font-size: 0.96rem;
    color: #94a3b8;
    margin: 0;
    line-height: 1.7;
    padding-top: 1rem;
  }

  /* Client Access Banner */
  .client-access-banner {
    padding: 4rem 0;
  }

  .client-banner-box {
    background: linear-gradient(135deg, #111b33 0%, #0d1527 100%);
    border: 1px solid #243555;
    border-radius: 1.5rem;
    padding: 3rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .pill-badge {
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #f59e0b;
    background: rgba(245, 158, 11, 0.1);
    border: 1px solid rgba(245, 158, 11, 0.25);
    padding: 0.25rem 0.6rem;
    border-radius: 9999px;
    display: inline-block;
    margin-bottom: 0.75rem;
  }

  .client-banner-text h2 {
    font-size: 1.8rem;
    font-weight: 800;
    color: #f8fafc;
    margin: 0 0 0.5rem;
  }

  .client-banner-text p {
    font-size: 1rem;
    color: #94a3b8;
    margin: 0;
    max-width: 38rem;
  }

  /* Footer */
  .main-footer {
    border-top: 1px solid #1e293b;
    background: #04070e;
    padding: 4rem 0 2rem;
  }

  .footer-content {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 3rem;
    margin-bottom: 3rem;
  }

  .footer-tagline {
    font-size: 0.9rem;
    color: #64748b;
    max-width: 24rem;
    margin-top: 1rem;
    line-height: 1.6;
  }

  .footer-nav-col {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer-nav-col strong {
    color: #f8fafc;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }

  .footer-nav-col a {
    color: #94a3b8;
    font-size: 0.9rem;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .footer-nav-col a:hover {
    color: #38bdf8;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding-top: 2rem;
    font-size: 0.85rem;
    color: #64748b;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .footer-bottom p {
    margin: 0;
  }

  .footer-bottom-links {
    display: flex;
    gap: 0.75rem;
    align-items: center;
  }

  .footer-bottom-links a {
    color: #64748b;
    text-decoration: none;
  }

  .footer-bottom-links a:hover {
    color: #94a3b8;
  }

  /* Responsive Adjustments */
  @media (max-width: 900px) {
    .nav-links {
      display: none;
    }

    .contact-card-wrapper {
      grid-template-columns: 1fr;
      padding: 2.5rem 1.5rem;
    }

    .client-banner-box {
      flex-direction: column;
      align-items: flex-start;
      padding: 2rem;
    }

    .footer-content {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  @media (max-width: 640px) {
    .form-row {
      grid-template-columns: 1fr;
    }

    .trust-divider {
      display: none;
    }

    .hero-ctas {
      flex-direction: column;
      width: 100%;
    }

