<script>
  // Interactive lead form handler
  const form = document.getElementById("lead-contact-form") as HTMLFormElement | null;
  const successBox = document.getElementById("form-success-message");
  const submitBtn = document.getElementById("btn-submit-lead");
  const whatsappBtn = document.getElementById("success-whatsapp-btn") as HTMLAnchorElement | null;

  if (form && successBox && submitBtn) {
    form.addEventListener("submit", (e) => {
      e.preventDefault();

      const nameInput = (document.getElementById("lead-name") as HTMLInputElement)?.value || "";
      const emailInput = (document.getElementById("lead-email") as HTMLInputElement)?.value || "";
      const phoneInput = (document.getElementById("lead-phone") as HTMLInputElement)?.value || "";
      const businessInput = (document.getElementById("lead-business") as HTMLInputElement)?.value || "";
      const planInput = (document.getElementById("lead-plan") as HTMLSelectElement)?.value || "";
      const messageInput = (document.getElementById("lead-message") as HTMLTextAreaElement)?.value || "";

      // Construct customized WhatsApp link
      const text = encodeURIComponent(
        `Hola! Me gustaría cotizar una landing page para mi negocio.\n\n` +
        `• Nombre: ${nameInput}\n` +
        `• Email: ${emailInput}\n` +
        `• Tel/WhatsApp: ${phoneInput}\n` +
        `• Negocio: ${businessInput}\n` +
        `• Plan de interés: ${planInput}\n` +
        (messageInput ? `• Detalle: ${messageInput}` : "")
      );

      if (whatsappBtn) {
        whatsappBtn.href = `https://wa.me/?text=${text}`;
      }

      // Smooth feedback
      submitBtn.setAttribute("disabled", "true");
      submitBtn.innerHTML = "<span>Enviando...</span>";

      setTimeout(() => {
        submitBtn.style.display = "none";
        successBox.style.display = "block";
        successBox.scrollIntoView({ behavior: "smooth", block: "nearest" });
      }, 500);
    });
  }

  // Interactive Live Mockup Switcher with Auto-Cycle and Manual Controls
  const tabButtons = document.querySelectorAll<HTMLButtonElement>(".mockup-tab-btn");
  const panels = document.querySelectorAll<HTMLElement>(".mockup-template-panel");
  const urlDisplay = document.getElementById("mockup-url-display");
  const progressBar = document.getElementById("mockup-progress-bar");
  const mockupStage = document.getElementById("live-mockup-stage");
  const switchButtons = document.querySelectorAll<HTMLButtonElement>(".btn-preview-switch");

  if (tabButtons.length > 0 && panels.length > 0) {
    let currentIdx = 0;
    const totalTemplates = tabButtons.length;
    const CYCLE_DURATION = 4500;
    let cycleTimer: any = null;
    let isPaused = false;

    function activateTemplate(index: number) {
      currentIdx = (index + totalTemplates) % totalTemplates;

      tabButtons.forEach((btn, i) => {
        const isActive = i === currentIdx;
        btn.classList.toggle("active", isActive);
        btn.setAttribute("aria-selected", isActive ? "true" : "false");
      });

      panels.forEach((panel, i) => {
        const isActive = i === currentIdx;
        panel.classList.toggle("active", isActive);
        if (isActive && urlDisplay) {
          const mockUrl = panel.getAttribute("data-mock-url");
          if (mockUrl) urlDisplay.textContent = mockUrl;
        }
      });

      restartProgress();
    }

    function restartProgress() {
      if (!progressBar) return;
      progressBar.style.transition = "none";
      progressBar.style.width = "0%";
      void progressBar.offsetWidth;
      if (!isPaused) {
        progressBar.style.transition = `width ${CYCLE_DURATION}ms linear`;
        progressBar.style.width = "100%";
      }
    }

    function startCycle() {
      clearInterval(cycleTimer);
      restartProgress();
      cycleTimer = setInterval(() => {
        if (!isPaused) {
          activateTemplate(currentIdx + 1);
        }
      }, CYCLE_DURATION);
    }

    tabButtons.forEach((btn, i) => {
      btn.addEventListener("click", () => {
        activateTemplate(i);
        startCycle();
      });
    });

    if (mockupStage) {
      mockupStage.addEventListener("mouseenter", () => {
        isPaused = true;
        if (progressBar) {
          const computedWidth = window.getComputedStyle(progressBar).width;
          progressBar.style.transition = "none";
          progressBar.style.width = computedWidth;
        }
      });

      mockupStage.addEventListener("mouseleave", () => {
        isPaused = false;
        startCycle();
      });
    }

    switchButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const targetKey = btn.getAttribute("data-switch-to");
        if (!targetKey) return;
        const targetIdx = Array.from(tabButtons).findIndex(
          (b) => b.getAttribute("data-template-target") === targetKey
        );
        if (targetIdx !== -1) {
          activateTemplate(targetIdx);
          startCycle();
          if (mockupStage) {
            mockupStage.scrollIntoView({ behavior: "smooth", block: "center" });
            mockupStage.classList.add("mockup-highlight-pulse");
            setTimeout(() => {
              mockupStage.classList.remove("mockup-highlight-pulse");
            }, 1200);
          }
        }
      });
    });

    startCycle();
  }
</script>

