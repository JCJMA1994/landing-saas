---
interface PublishedSite {
  id: string;
  name: string;
  slug: string;
  version: number;
  publishedAt: string;
  templateKey: string;
}

interface Props {
  publishedSites?: PublishedSite[];
}

const { publishedSites = [] } = Astro.props;

const templateShowcase = [
  {
    key: "FriendlyTechTemplate",
    name: "SaaS & App Friendly",
    category: "Software & Startups",
    description: "Diseño limpio, amigable y dinámico con micro-interacciones. Pensado para retener usuarios y maximizar registros.",
    accent: "#38bdf8",
    badge: "Alta Conversión",
    tags: ["Prueba Gratuita", "SaaS B2B", "Apps Móviles"]
  },
  {
    key: "TechDiagnosticTemplate",
    name: "Diagnóstico & Sistemas",
    category: "Servicios IT & Consultoría",
    description: "Estilo técnico de precisión con tarjetas de diagnóstico y métricas de confiabilidad para empresas tecnológicas.",
    accent: "#818cf8",
    badge: "Corporativo Tech",
    tags: ["Auditoría IT", "Ciberseguridad", "Cloud"]
  },
  {
    key: "CyberPerformanceTemplate",
    name: "Cyber Performance",
    category: "High-Tech & Gaming",
    description: "Paleta oscura de alto contraste con acentos neón y estética futurista orientada a servicios de alto impacto.",
    accent: "#a855f7",
    badge: "Máximo Impacto",
    tags: ["Hardware", "DevOps", "Servicios Pro"]
  },
  {
    key: "SystemMonitorTemplate",
    name: "Monitor & Cloud Infra",
    category: "Infraestructura & Datos",
    description: "Estructura modular con indicadores de estado en tiempo real, tablas comparativas y dashboards visuales.",
    accent: "#34d399",
    badge: "Métricas en Vivo",
    tags: ["Monitoreo", "APIs", "Data Analytics"]
  },
  {
    key: "RepairWorkshopTemplate",
    name: "Taller & Ingeniería",
    category: "Servicios Técnicos & Oficios",
    description: "Diseño robusto, confiable y directo con llamadas a la acción inmediatas vía WhatsApp y cotizaciones rápidas.",
    accent: "#f59e0b",
    badge: "Cotización Rápida",
    tags: ["Mantenimiento", "Talleres", "Ingeniería"]
  },
  {
    key: "TechEditorialTemplate",
    name: "Tech Editorial",
    category: "Agencias & Firmas Boutique",
    description: "Tipografía refinada, espacios generosos y narrativa profunda para consultoras de alto valor y marcas premium.",
    accent: "#f43f5e",
    badge: "Diseño Editorial",
    tags: ["Agencias", "Venture Capital", "Estudios"]
  },
];

const features = [
  {
    icon: "⚡",
    title: "Carga Ultrarrápida en el Edge",
    description: "Construidas con arquitectura moderna sin WordPress ni plugins pesados. Puntaje 98+ en Google Lighthouse para posicionar primero."
  },
  {
    icon: "🎨",
    title: "Diseños Auténticos No Genéricos",
    description: "6 direcciones visuales diseñadas desde cero. Tu negocio no va a parecer una plantilla clonada de internet."
  },
  {
    icon: "🔑",
    title: "Panel Privado para Clientes",
    description: "Te damos tu usuario y contraseña para que actualices tarjetas, ofertas, textos y fotos cuando quieras, sin depender de nadie."
  },
  {
    icon: "🌐",
    title: "Dominio Propio + SSL Gratis",
    description: "Conectamos tu propio dominio (tunegocio.com) o te damos un subdominio veloz. Certificado SSL automático renovado de por vida."
  },
  {
    icon: "⏱️",
    title: "Motor de Campañas Estacionales",
    description: "Activá promociones por tiempo limitado (CyberMonday, Black Friday o lanzamientos) con banners y cuentas regresivas programadas."
  },
  {
    icon: "📈",
    title: "SEO Técnico & Conversión Lista",
    description: "Etiquetas OpenGraph, Schema.org estructurado para Google y botones directos a WhatsApp para no perder ningún lead."
  },
];

const steps = [
  {
    number: "01",
    title: "Contacto y Diagnóstico",
    description: "Nos contás sobre tu negocio, tu propuesta y qué querés vender. Elegimos la arquitectura visual ideal para tu rubro."
  },
  {
    number: "02",
    title: "Alta y Configuración",
    description: "Damos de alta tu espacio en nuestra plataforma, configuramos tu dominio, cargamos tus contenidos base y creamos tu usuario."
  },
  {
    number: "03",
    title: "Lanzamiento y Autonomía",
    description: "Tu landing queda publicada en minutos. Podés recibir clientes de inmediato y autogestionar tus cambios desde tu panel privado."
  },
];

const plans = [
  {
    name: "Lanzamiento",
    price: "$39",
    period: "/mes",
    description: "Ideal para profesionales y emprendimientos que necesitan presencia seria y rápida.",
    highlight: false,
    cta: "Elegir Lanzamiento",
    items: [
      "Landing Page de Alta Conversión",
      "Subdominio de alta velocidad incluido",
      "Panel de Cliente para editar contenidos",
      "1 Campaña estacional programable",
      "Optimización SEO básica y OpenGraph",
      "Botón de contacto directo a WhatsApp"
    ]
  },
  {
    name: "Crecimiento Pro",
    price: "$79",
    period: "/mes",
    description: "Para negocios consolidados que buscan máxima conversión y dominio propio.",
    highlight: true,
    badge: "Más Elegido",
    cta: "Empezar con Pro",
    items: [
      "Todo lo del plan Lanzamiento",
      "Conexión a Dominio Propio (ej. tuempresa.com)",
      "SSL Automático y CDN global en el Edge",
      "Campañas y promociones ilimitadas",
      "Métricas de visitas y analíticas en tiempo real",
      "Soporte prioritario y asesoría de copy"
    ]
  },
  {
    name: "Agencia / Escala",
    price: "$149",
    period: "/mes",
    description: "Para empresas y marcas con múltiples servicios o campañas publicitarias intensivas.",
    highlight: false,
    cta: "Consultar por Escala",
    items: [
      "Múltiples landings para campañas de pauta",
      "A/B testing y personalización de módulos",
      "Multi-usuarios y roles de equipo en panel",
      "Integración con webhooks y CRM externo",
      "SLA de disponibilidad garantizado 99.9%",
      "Soporte VIP directo por WhatsApp"
    ]
  },
];

const faqs = [
  {
    q: "¿Puedo usar mi propio dominio?",
    a: "¡Sí, totalmente! En el plan Pro y Escala conectamos tu dominio personalizado (por ejemplo, www.tunegocio.com) con verificación DNS automática y certificado SSL gratuito."
  },
  {
    q: "¿Cómo hago si quiero cambiar un precio, texto o foto?",
    a: "Una vez que te damos de alta, recibís tus credenciales para acceder a tu Panel de Control exclusivo (/admin/login). Ahí podés editar títulos, tarjetas de servicios, fotos y promociones en cualquier momento y publicar los cambios con un solo clic."
  },
  {
    q: "¿Ustedes también pueden gestionar los cambios por mí?",
    a: "Exacto. Si no tenés tiempo o preferís delegarlo, nuestro equipo puede encargarse de actualizar tus campañas y contenidos cuando lo necesites directamente desde nuestro panel administrativo."
  },
  {
    q: "¿Cuánto demora tener mi landing online?",
    a: "Una vez que nos compartís la información básica de tu negocio, el alta y configuración en la plataforma demora entre 24 y 48 horas hábiles."
  },
  {
    q: "¿Por qué es mejor que una plantilla típica de WordPress?",
    a: "Nuestras landings no usan servidores lentos ni plugins que se desactualizan o son hackeables. Están programadas con arquitectura moderna alojada en el Edge, lo que garantiza tiempos de carga instantáneos (<0.8 segundos) y una tasa de conversión hasta 3 veces mayor."
  }
];
---

<div class="seller-wrapper">
  <!-- Top Announcement Bar -->
  <div class="top-announcement">
    <div class="announcement-content">
      <span class="pulse-dot"></span>
      <span><strong>Servicio Activo:</strong> Tomando nuevos clientes para lanzamientos este mes</span>
      <a href="#contacto" class="announcement-link">Consultar disponibilidad &rarr;</a>
    </div>
  </div>

  <!-- Main Navigation Header -->
  <header class="main-nav">
    <div class="nav-container">
      <a href="/" class="brand-logo">
        <div class="brand-icon">
          <span>LS</span>
        </div>
        <div class="brand-text">
          <span class="brand-title">Landing SaaS</span>
          <span class="brand-tag">Studio & Engine</span>
        </div>
      </a>

      <nav class="nav-links">
        <a href="#beneficios">Beneficios</a>
        <a href="#plantillas">Diseños</a>
        <a href="#proceso">Cómo funciona</a>
        <a href="#precios">Planes</a>
        <a href="#faq">Preguntas</a>
      </nav>

      <div class="nav-actions">
        <a href="/admin/login" class="btn-client-login" title="Acceso para clientes dados de alta">
          <span class="icon-lock">🔒</span>
          Acceso Clientes
        </a>
        <a href="#contacto" class="btn-cta-nav">
          Quiero mi Landing
        </a>
      </div>
    </div>
  </header>

  <!-- Hero Section -->
  <section class="hero-section">
    <div class="hero-glow"></div>
    <div class="hero-container">
      <div class="hero-badge">
        <span class="badge-tag">Plataforma & Agencia</span>
        <span class="badge-divider">•</span>
        <span class="badge-desc">Landings de Alta Conversión con Dominios Propios</span>
      </div>

      <h1 class="hero-title">
        Creamos la landing que <span class="gradient-text">convierte tus visitas</span> en clientes reales
      </h1>

      <p class="hero-subtitle">
        Diseños prémium a medida, velocidad instantánea en el Edge, dominios propios y un <strong>panel privado exclusivo</strong> para que actualices tus contenidos y ofertas cuando quieras, sin depender de programadores.
      </p>

      <div class="hero-ctas">
        <a href="#contacto" class="btn-primary-glow">
          <span>Pedir mi Landing Ahora</span>
          <span class="btn-arrow">&rarr;</span>
        </a>
        <a href="#plantillas" class="btn-secondary-outline">
          <span>Ver Diseños Disponibles</span>
        </a>
      </div>

      <!-- Trust Metrics -->
      <div class="trust-grid">
        <div class="trust-item">
          <strong class="trust-value">&lt; 0.8s</strong>
          <span class="trust-label">Carga en el Edge</span>
        </div>
        <div class="trust-divider"></div>
        <div class="trust-item">
          <strong class="trust-value">100%</strong>
          <span class="trust-label">Autogestionable</span>
        </div>
        <div class="trust-divider"></div>
        <div class="trust-item">
          <strong class="trust-value">99.9%</strong>
          <span class="trust-label">Uptime & SSL</span>
        </div>
        <div class="trust-divider"></div>
        <div class="trust-item">
          <strong class="trust-value">48hs</strong>
          <span class="trust-label">Tiempo de Entrega</span>
        </div>
      </div>

      <!-- Interactive Mockup Preview -->
      <div class="mockup-frame">
        <div class="mockup-header">
          <div class="mockup-dots">
            <span class="dot red"></span>
            <span class="dot yellow"></span>
            <span class="dot green"></span>
          </div>
          <div class="mockup-url-bar">
            <span class="url-lock">🔒</span>
            <span class="url-text">tunegocio.com</span>
            <span class="url-badge">EN VIVO</span>
          </div>
          <div class="mockup-admin-link">
            <span class="admin-pill">Panel de Control: Activo</span>
          </div>
        </div>

        <div class="mockup-viewport">
          <!-- Visual preview cards inside mockup -->
          <div class="mockup-hero-preview">
            <div class="preview-badge">Tu Negocio Online</div>
            <div class="preview-heading">Aumentá tus ventas con una experiencia digital superior</div>
            <div class="preview-sub">Atraé a tus clientes ideales con un diseño profesional y contacto directo.</div>
            <div class="preview-action-row">
              <span class="preview-btn-main">Contactar por WhatsApp</span>
              <span class="preview-btn-ghost">Ver Servicios</span>
            </div>
          </div>

          <div class="mockup-features-row">
            <div class="preview-card">
              <span class="card-icon">🚀</span>
              <strong>Servicio Principal</strong>
              <p>Descripción clara y vendedora de tu propuesta.</p>
            </div>
            <div class="preview-card highlight">
              <span class="card-icon">⭐</span>
              <strong>Promoción Activa</strong>
              <p>Motor de ofertas con cuenta regresiva integrada.</p>
            </div>
            <div class="preview-card">
              <span class="card-icon">💬</span>
              <strong>Contacto Inmediato</strong>
              <p>Redirección directa a tu WhatsApp sin fricción.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Value Propositions / Benefits -->
  <section id="beneficios" class="section-padding">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Por qué trabajar con nosotros</span>
        <h2 class="section-title">Tecnología de élite pensada para vender</h2>
        <p class="section-desc">
          No te entregamos un sitio genérico ni un WordPress vulnerable. Te entregamos un activo digital de alto rendimiento configurado y listo para generar ingresos.
        </p>
      </div>

      <div class="features-grid">
        {features.map((feat) => (
          <div class="feature-card">
            <div class="feature-icon">{feat.icon}</div>
            <h3 class="feature-title">{feat.title}</h3>
            <p class="feature-description">{feat.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Showcase of Design Architectures -->
  <section id="plantillas" class="section-padding bg-alt">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Direcciones Visuales</span>
        <h2 class="section-title">Diseños con personalidad propia</h2>
        <p class="section-desc">
          Cada industria tiene su propio ritmo y lenguaje. Nuestras arquitecturas visuales están estudiadas para generar empatía y autoridad según tu rubro.
        </p>
      </div>

      <div class="templates-grid">
        {templateShowcase.map((t) => (
          <article class="template-card">
            <div class="template-card-header" style={`border-top: 3px solid ${t.accent};`}>
              <div class="template-meta">
                <span class="template-category">{t.category}</span>
                <span class="template-badge" style={`color: ${t.accent}; background: ${t.accent}15; border: 1px solid ${t.accent}30;`}>
                  {t.badge}
                </span>
              </div>
              <h3 class="template-name">{t.name}</h3>
              <p class="template-desc">{t.description}</p>
            </div>

            <div class="template-tags">
              {t.tags.map((tag) => (
                <span class="template-tag">#{tag}</span>
              ))}
            </div>

            <div class="template-card-footer">
              <a href="#contacto" class="btn-template-select">
                Solicitar este estilo &rarr;
              </a>
            </div>
          </article>
        ))}
      </div>

      <!-- Real Published Sites (if any exist) -->
      {publishedSites.length > 0 && (
        <div class="live-sites-block">
          <div class="live-sites-header">
            <h3>Sitios Activos en la Plataforma</h3>
            <p>Proyectos en producción creados con nuestra arquitectura.</p>
          </div>
          <div class="live-sites-grid">
            {publishedSites.map((site) => (
              <div class="live-site-card">
                <div class="live-site-info">
                  <strong>{site.name}</strong>
                  <span class="site-slug">/{site.slug}</span>
                </div>
                <div class="live-site-meta">
                  <span class="badge-version">v{site.version} activa</span>
                  <a href={`/sites/${site.slug}`} class="live-site-link">Ver sitio &nearr;</a>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- 3-Step Process -->
  <section id="proceso" class="section-padding">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Flujo de Trabajo</span>
        <h2 class="section-title">Del concepto a tu landing online en 3 pasos</h2>
        <p class="section-desc">
          Un proceso ágil, sin reuniones eternas ni presupuestos inflados. Vos te enfocás en tu negocio, nosotros nos encargamos de la infraestructura.
        </p>
      </div>

      <div class="steps-grid">
        {steps.map((step) => (
          <div class="step-card">
            <div class="step-num">{step.number}</div>
            <h3 class="step-title">{step.title}</h3>
            <p class="step-desc">{step.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Pricing Plans -->
  <section id="precios" class="section-padding bg-alt">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Inversión Clara</span>
        <h2 class="section-title">Planes diseñados para cada etapa</h2>
        <p class="section-desc">
          Sin costos ocultos de servidores, certificados ni mantenimiento. Todo incluido en una suscripción simple.
        </p>
      </div>

      <div class="pricing-grid">
        {plans.map((p) => (
          <div class={`pricing-card ${p.highlight ? "featured" : ""}`}>
            {p.highlight && <div class="featured-badge">{p.badge}</div>}
            <h3 class="plan-name">{p.name}</h3>
            <div class="plan-price-row">
              <span class="plan-price">{p.price}</span>
              <span class="plan-period">{p.period}</span>
            </div>
            <p class="plan-description">{p.description}</p>

            <ul class="plan-features">
              {p.items.map((item) => (
                <li>
                  <span class="check-icon">✓</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>

            <a href="#contacto" class={`btn-plan ${p.highlight ? "btn-plan-featured" : ""}`}>
              {p.cta}
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Contact & Lead Capture Section -->
  <section id="contacto" class="section-padding">
    <div class="container">
      <div class="contact-card-wrapper">
        <div class="contact-info-column">
          <span class="section-eyebrow">Empecemos hoy</span>
          <h2 class="contact-headline">¿Listo para tener la landing que tu negocio merece?</h2>
          <p class="contact-subtext">
            Completá el formulario con tus datos y te respondemos en menos de 2 horas con una propuesta a medida. Si preferís atención inmediata, podés escribirnos directo por WhatsApp.
          </p>

          <div class="contact-direct-box">
            <div class="direct-item">
              <span class="direct-icon">💬</span>
              <div>
                <strong>WhatsApp Directo</strong>
                <p>Respuesta inmediata de nuestro equipo comercial.</p>
                <a href="https://wa.me/?text=Hola%2C%20quiero%20cotizar%20una%20landing%20page%20para%20mi%20negocio" target="_blank" rel="noopener noreferrer" class="whatsapp-link">
                  Chatear por WhatsApp &rarr;
                </a>
              </div>
            </div>

            <div class="direct-item">
              <span class="direct-icon">🛡️</span>
              <div>
                <strong>Garantía de Satisfacción</strong>
                <p>Si el diseño inicial no te convence, lo ajustamos hasta que quede perfecto.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Interactive Lead Form -->
        <div class="contact-form-column">
          <form id="lead-contact-form" class="lead-form">
            <div class="form-title-row">
              <h3>Solicitar Cotización / Alta</h3>
              <p>Sin compromiso. Te contactamos a la brevedad.</p>
            </div>

            <div class="form-group">
              <label for="lead-name">Nombre y Apellido *</label>
              <input type="text" id="lead-name" name="name" required placeholder="Ej: Juan Pérez" />
            </div>

            <div class="form-row">
              <div class="form-group">
                <label for="lead-email">Email de Contacto *</label>
                <input type="email" id="lead-email" name="email" required placeholder="juan@empresa.com" />
              </div>
              <div class="form-group">
                <label for="lead-phone">WhatsApp / Teléfono</label>
                <input type="tel" id="lead-phone" name="phone" placeholder="+54 9 11 ..." />
              </div>
            </div>

            <div class="form-group">
              <label for="lead-business">Nombre de tu Negocio o Rubro</label>
              <input type="text" id="lead-business" name="business" placeholder="Ej: Consultora Tech, Taller Mecánico, SaaS..." />
            </div>

            <div class="form-group">
              <label for="lead-plan">Plan de Interés</label>
              <select id="lead-plan" name="plan">
                <option value="pro">Plan Crecimiento Pro (Recomendado - Dominio Propio)</option>
                <option value="starter">Plan Lanzamiento (Subdominio rápido)</option>
                <option value="enterprise">Plan Agencia / Escala (Múltiples sitios)</option>
                <option value="custom">No estoy seguro, necesito asesoramiento</option>
              </select>
            </div>

            <div class="form-group">
              <label for="lead-message">¿Qué te gustaría que tenga tu landing?</label>
              <textarea id="lead-message" name="message" rows="3" placeholder="Contanos brevemente qué ofrecés o qué enlaces te gustaría incluir..."></textarea>
            </div>

            <button type="submit" id="btn-submit-lead" class="btn-submit-lead">
              <span>Enviar Solicitud</span>
              <span class="btn-arrow">&rarr;</span>
            </button>

            <div id="form-success-message" class="form-success-box" style="display: none;">
              <div class="success-icon">🎉</div>
              <h4>¡Solicitud enviada con éxito!</h4>
              <p>Muchas gracias por contactarnos. Te responderemos a tu email a la brevedad.</p>
              <a id="success-whatsapp-btn" href="#" target="_blank" rel="noopener noreferrer" class="whatsapp-action-btn">
                O escribinos directo por WhatsApp ahora &rarr;
              </a>
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section id="faq" class="section-padding bg-alt">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Dudas Comunes</span>
        <h2 class="section-title">Preguntas Frecuentes</h2>
      </div>

      <div class="faq-grid">
        {faqs.map((faq) => (
          <div class="faq-card">
            <h3 class="faq-question">{faq.q}</h3>
            <p class="faq-answer">{faq.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Client Access Banner -->
  <section class="client-access-banner">
    <div class="container">
      <div class="client-banner-box">
        <div class="client-banner-text">
          <span class="pill-badge">Zona de Clientes</span>
          <h2>¿Ya sos cliente de la plataforma?</h2>
          <p>Ingresá con tu cuenta para gestionar tus publicaciones, cambiar fotos, editar ofertas o ver analíticas de tu sitio.</p>
        </div>
        <div class="client-banner-action">
          <a href="/admin/login" class="btn-primary-glow">
            <span>Iniciar Sesión en el Admin</span>
            <span>&rarr;</span>
          </a>
        </div>
      </div>
