---
interface Props {
  siteId: string;
  siteName: string;
  activeTab:
    | "template"
    | "theme"
    | "hero"
    | "cards"
    | "media"
    | "contacts"
    | "promotions"
    | "campaigns"
    | "publish"
    | "domains"
    | "analytics";
  status?: "draft" | "published";
  hasPendingChanges?: boolean;
}

const {
  siteId,
  siteName,
  activeTab,
  status = "draft",
  hasPendingChanges = false,
} = Astro.props;

// Steps definition for the onboarding wizard
const wizardSteps = [
  {
    number: 1,
    id: "design",
    label: "Plantilla & Estilo",
    shortLabel: "Plantilla",
    path: `/admin/sites/${siteId}/template`,
    activeMatches: ["template", "theme"],
    subtabs: [
      { id: "template", label: "Plantilla Visual", path: `/admin/sites/${siteId}/template` },
      { id: "theme", label: "Colores y Estilo", path: `/admin/sites/${siteId}/theme` },
    ],
  },
  {
    number: 2,
    id: "hero",
    label: "Encabezado",
    shortLabel: "Hero",
    path: `/admin/sites/${siteId}/hero`,
    activeMatches: ["hero"],
  },
  {
    number: 3,
    id: "cards",
    label: "Servicios",
    shortLabel: "Servicios",
    path: `/admin/sites/${siteId}/cards`,
    activeMatches: ["cards"],
  },
  {
    number: 4,
    id: "media",
    label: "Identidad",
    shortLabel: "Medios",
    path: `/admin/sites/${siteId}/media`,
    activeMatches: ["media"],
  },
  {
    number: 5,
    id: "contacts",
    label: "Contacto",
    shortLabel: "Contacto",
    path: `/admin/sites/${siteId}/contacts`,
    activeMatches: ["contacts"],
  },
  {
    number: 6,
    id: "marketing",
    label: "Promociones",
    shortLabel: "Promos",
    path: `/admin/sites/${siteId}/promotions`,
    activeMatches: ["promotions", "campaigns"],
    isOptional: true,
    subtabs: [
      { id: "promotions", label: "Promociones", path: `/admin/sites/${siteId}/promotions` },
      { id: "campaigns", label: "Campañas UTM", path: `/admin/sites/${siteId}/campaigns` },
    ],
  },
  {
    number: 7,
    id: "publish",
    label: "Publicar",
    shortLabel: "Publicar",
    path: `/admin/sites/${siteId}/publish`,
    activeMatches: ["publish"],
  },
];

const isManagementTab = activeTab === "domains" || activeTab === "analytics";
const currentStepIndex = wizardSteps.findIndex((s) => s.activeMatches.includes(activeTab));
const currentStep = currentStepIndex >= 0 ? wizardSteps[currentStepIndex] : null;

// Next & Previous step calculations
const prevStep = currentStepIndex > 0 ? wizardSteps[currentStepIndex - 1] : null;
const nextStep = currentStepIndex >= 0 && currentStepIndex < wizardSteps.length - 1
  ? wizardSteps[currentStepIndex + 1]
  : null;

const progressPercent = currentStepIndex >= 0 
  ? Math.round(((currentStepIndex + 1) / wizardSteps.length) * 100)
  : 100;
---

<nav class="site-header-nav" aria-label="Navegación y Asistente de Edición">
  <!-- 1. BARRA SUPERIOR: Identidad del Sitio + Herramientas de Gestión -->
  <div class="site-nav-topbar">
    <div class="site-nav-identity">
      <a href="/admin" class="site-nav-back" title="Volver a Sitios">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 12H5M12 19l-7-7 7-7"/>
        </svg>
        <span class="back-label">Sitios</span>
      </a>
      <span class="nav-divider">/</span>
      <span class="site-title" title={siteName}>{siteName}</span>
      {hasPendingChanges ? (
        <span class="status-chip chip-pending" title="Cambios en borrador listos para publicar">
          ● Pendiente
        </span>
      ) : status === "published" ? (
        <span class="status-chip chip-live" title="Sitio en vivo">
          ● En vivo
        </span>
      ) : (
        <span class="status-chip chip-draft" title="Sitio en borrador">
          ● Borrador
        </span>
      )}
    </div>

    <!-- Herramientas de Gestión (Apartadas del Asistente de Contenido) -->
    <div class="site-nav-tools">
      <div class="tools-segmented">
        <a
          href={`/admin/sites/${siteId}/domains`}
          class:list={["tool-item", { active: activeTab === "domains" }]}
          title="Configurar dominio web y DNS"
        >
          <span class="t-icon">🌐</span>
          <span class="t-text">Dominios</span>
        </a>
        <a
          href={`/admin/sites/${siteId}/analytics`}
          class:list={["tool-item", { active: activeTab === "analytics" }]}
          title="Ver estadísticas y conversiones"
        >
          <span class="t-icon">📊</span>
          <span class="t-text">Métricas</span>
        </a>
      </div>

      <div class="tools-actions">
        <a
          href={`/preview/${siteId}`}
          target="_blank"
          rel="noopener noreferrer"
          class="action-preview-btn"
          title="Abrir vista previa del borrador"
        >
          <span>Vista Previa</span>
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
            <polyline points="15 3 21 3 21 9"></polyline>
            <line x1="10" y1="14" x2="21" y2="3"></line>
          </svg>
        </a>
        {activeTab !== "publish" && (
          <a
            href={`/admin/sites/${siteId}/publish`}
            class="action-publish-btn"
            title="Ir a publicar cambios"
          >
            🚀 Publicar
          </a>
        )}
      </div>
    </div>
  </div>

  <!-- 2. BANNER DE GESTIÓN O ASISTENTE ONBOARDING -->
  {isManagementTab ? (
    <div class="management-banner">
      <div class="mb-info">
        <span class="mb-tag">GESTIÓN DEL SITIO</span>
        <span class="mb-desc">
          {activeTab === "domains"
            ? "Conecta tu propio dominio (.com, .pe) y certificados SSL con resolución automática."
            : "Monitorea el tráfico de visitantes, clics a WhatsApp y rendimiento comercial sin cookies."}
        </span>
      </div>
      <a href={`/admin/sites/${siteId}/template`} class="mb-return-btn">
        ← Volver al Asistente de Contenido
      </a>
    </div>
  ) : (
    <div class="stepper-card">
      <!-- Barra de progreso e información activa (Mobile & Desktop) -->
      <div class="stepper-header">
        <div class="stepper-progress-meta">
          <div class="step-badge-group">
            <span class="step-counter">PASO {currentStep ? currentStep.number : 1} DE 7</span>
            <strong class="step-active-name">{currentStep ? currentStep.label : ""}</strong>
            {currentStep?.isOptional && <span class="step-opt-badge">Opcional</span>}
          </div>
          <!-- Barra de progreso fluida -->
          <div class="progress-bar-track" title={`Progreso: ${progressPercent}%`}>
            <div class="progress-bar-fill" style={`width: ${progressPercent}%`}></div>
          </div>
        </div>

        <!-- Controles rápidos de avance (Touch Friendly) -->
        <div class="stepper-nav-actions">
          {prevStep && (
            <a href={prevStep.path} class="step-btn btn-prev" title="Ir al paso anterior">
              ← Anterior
            </a>
          )}
          {nextStep && (
            <a href={nextStep.path} class="step-btn btn-next" title="Ir al paso siguiente">
              {currentStep?.isOptional ? "Omitir paso →" : "Siguiente →"}
            </a>
          )}
          {activeTab !== "publish" && (
            <a href={`/admin/sites/${siteId}/publish`} class="step-btn btn-skip-publish" title="Publicar directamente">
              Saltar a Publicar 🚀
            </a>
          )}
        </div>
      </div>

      <!-- Steps List: Mobile Touch Carousel horizontal / Desktop Clean Connected Strip -->
      <div class="steps-carousel-container">
        <ol class="steps-list">
          {wizardSteps.map((step, idx) => {
            const isCurrent = step.activeMatches.includes(activeTab);
            const isCompleted = currentStepIndex > idx;

            return (
              <li class:list={["step-item", { current: isCurrent, completed: isCompleted }]}>
                <a href={step.path} class="step-anchor" title={`Paso ${step.number}: ${step.label}`}>
                  <span class="step-circle">
                    {isCompleted ? (
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="20 6 9 17 4 12"></polyline>
                      </svg>
                    ) : (
                      step.number
                    )}
                  </span>
                  <span class="step-name-text">{step.label}</span>
                </a>
              </li>
            );
          })}
        </ol>
      </div>

      <!-- Sub-tabs en caso de tener alternativas secundarias (ej: Plantilla vs Colores) -->
      {currentStep?.subtabs && (
        <div class="stepper-subtabs-row">
          <span class="subtabs-caption">Sección:</span>
          <div class="subtabs-pills">
            {currentStep.subtabs.map((sub) => (
              <a
                href={sub.path}
                class:list={["subtab-chip", { active: activeTab === sub.id }]}
              >
                {sub.label}
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  )}
</nav>

<style>
  /* =========================================================
     MOBILE-FIRST CSS (Base styles are optimized for phones)
     ========================================================= */

  .site-header-nav {
    margin-bottom: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    width: 100%;
  }

  /* 1. TOPBAR */
  .site-nav-topbar {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    background: #0b1326;
    border: 1px solid #1e293b;
    border-radius: 0.85rem;
    backdrop-filter: blur(8px);
  }

  .site-nav-identity {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .site-nav-back {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: #94a3b8;
    text-decoration: none;
    font-size: 0.82rem;
    font-weight: 600;
    padding: 0.3rem 0.5rem;
    border-radius: 0.4rem;
    background: rgba(30, 41, 59, 0.6);
    border: 1px solid #334155;
    transition: all 0.15s ease;
  }
  .site-nav-back:hover {
    color: #f8fafc;
    background: #1e293b;
  }

  .nav-divider {
    color: #475569;
    font-weight: 300;
  }

  .site-title {
    font-size: 0.95rem;
    font-weight: 800;
    color: #f8fafc;
    max-width: 16rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .status-chip {
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.15rem 0.5rem;
    border-radius: 9999px;
  }
  .chip-pending {
    background: #451a03;
    color: #fcd34d;
    border: 1px solid #b45309;
  }
  .chip-live {
    background: #064e3b;
    color: #6ee7b7;
    border: 1px solid #059669;
  }
  .chip-draft {
    background: #1e293b;
    color: #94a3b8;
    border: 1px solid #334155;
  }

  /* Tools row */
  .site-nav-tools {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .tools-segmented {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    background: #111b33;
    padding: 0.2rem;
    border-radius: 0.55rem;
    border: 1px solid #1e2e4f;
  }

  .tool-item {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.65rem;
    border-radius: 0.45rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: #94a3b8;
    text-decoration: none;
    transition: all 0.15s ease;
  }
  .tool-item:hover {
    color: #ffffff;
    background: #1e2d4a;
  }
  .tool-item.active {
    background: #2563eb;
    color: #ffffff;
  }

  .t-icon {
    font-size: 0.85rem;
  }

  .tools-actions {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .action-preview-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.75rem;
    border-radius: 0.5rem;
    background: #1e293b;
    color: #fcd34d;
    font-size: 0.8rem;
    font-weight: 700;
    text-decoration: none;
    border: 1px solid #334155;
    transition: all 0.15s ease;
  }
  .action-preview-btn:hover {
    background: #283548;
    border-color: #fcd34d;
  }

  .action-publish-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.85rem;
    border-radius: 0.5rem;
    background: linear-gradient(135deg, #2563eb, #1d4ed8);
    color: #ffffff;
    font-size: 0.8rem;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 2px 8px rgba(37, 99, 235, 0.3);
    transition: all 0.15s ease;
  }
  .action-publish-btn:hover {
    background: linear-gradient(135deg, #3b82f6, #2563eb);
  }

  /* 2. MANAGEMENT BANNER */
  .management-banner {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 0.9rem 1.1rem;
    background: #0f1c36;
    border: 1px solid #23375f;
    border-radius: 0.85rem;
  }

  .mb-info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .mb-tag {
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #38bdf8;
  }

  .mb-desc {
    font-size: 0.86rem;
    color: #cbd5e1;
    line-height: 1.4;
  }

  .mb-return-btn {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    padding: 0.4rem 0.8rem;
    font-size: 0.82rem;
    font-weight: 700;
    color: #38bdf8;
    background: rgba(56, 189, 248, 0.1);
    border: 1px solid rgba(56, 189, 248, 0.3);
    border-radius: 0.5rem;
    text-decoration: none;
  }

  /* 3. STEPPER CARD (MOBILE-FIRST) */
  .stepper-card {
    background: #0d1527;
    border: 1px solid #1e2e4f;
    border-radius: 0.95rem;
    padding: 0.9rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.3);
  }

  .stepper-header {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .stepper-progress-meta {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .step-badge-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .step-counter {
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    background: #1e293b;
    color: #38bdf8;
    padding: 0.2rem 0.5rem;
    border-radius: 0.35rem;
  }

  .step-active-name {
    font-size: 0.98rem;
    font-weight: 750;
    color: #f8fafc;
  }

  .step-opt-badge {
    font-size: 0.68rem;
    background: #334155;
    color: #cbd5e1;
    padding: 0.15rem 0.45rem;
    border-radius: 0.35rem;
  }

  /* Progress track bar */
  .progress-bar-track {
    width: 100%;
    height: 4px;
    background: #1e293b;
    border-radius: 9999px;
    overflow: hidden;
  }

  .progress-bar-fill {
    height: 100%;
    background: linear-gradient(90deg, #38bdf8, #3b82f6);
    border-radius: 9999px;
    transition: width 0.3s ease;
  }

  /* Touch-friendly navigation buttons */
  .stepper-nav-actions {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .step-btn {
    display: inline-flex;
    align-items: center;
    padding: 0.45rem 0.8rem;
    border-radius: 0.5rem;
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .btn-prev {
    background: #1e293b;
    color: #cbd5e1;
    border: 1px solid #334155;
  }
  .btn-prev:hover {
    background: #283548;
    color: #ffffff;
  }

  .btn-next {
    background: #0284c7;
    color: #ffffff;
    font-weight: 700;
  }
  .btn-next:hover {
    background: #0369a1;
  }

  .btn-skip-publish {
    background: transparent;
    color: #fcd34d;
    border: 1px dashed #78350f;
    font-size: 0.78rem;
    margin-left: auto;
  }
  .btn-skip-publish:hover {
    background: rgba(245, 158, 11, 0.1);
    border-color: #f59e0b;
  }

  /* Steps list (Touch-scrollable on mobile) */
  .steps-carousel-container {
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding: 0.25rem 0;
  }
  .steps-carousel-container::-webkit-scrollbar {
    display: none;
  }

  .steps-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 0.4rem;
    min-width: max-content;
  }

  .step-item {
    display: flex;
  }

  .step-anchor {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.4rem 0.65rem;
    border-radius: 0.55rem;
    background: #111b30;
    border: 1px solid #1e2e4f;
    text-decoration: none;
    transition: all 0.15s ease;
  }
  .step-anchor:hover {
    background: #172442;
    border-color: #334a75;
  }

  .step-circle {
    width: 1.45rem;
    height: 1.45rem;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-size: 0.75rem;
    font-weight: 800;
    background: #1e293b;
    color: #64748b;
    flex-shrink: 0;
  }

  .step-name-text {
    font-size: 0.78rem;
    font-weight: 600;
    color: #94a3b8;
    white-space: nowrap;
  }

  /* Completed step */
  .step-item.completed .step-anchor {
    border-color: #1e3a5f;
    background: rgba(17, 27, 48, 0.6);
  }
  .step-item.completed .step-circle {
    background: #064e3b;
    color: #6ee7b7;
  }
  .step-item.completed .step-name-text {
    color: #cbd5e1;
  }

  /* Current step */
  .step-item.current .step-anchor {
    background: #172554;
    border-color: #3b82f6;
    box-shadow: 0 0 12px rgba(59, 130, 246, 0.3);
  }
  .step-item.current .step-circle {
    background: #2563eb;
    color: #ffffff;
  }
  .step-item.current .step-name-text {
    color: #60a5fa;
    font-weight: 750;
  }

  /* Subtabs Row */
  .stepper-subtabs-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding-top: 0.6rem;
    border-top: 1px dashed #1e2e4f;
    flex-wrap: wrap;
  }

  .subtabs-caption {
    font-size: 0.72rem;
    font-weight: 700;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .subtabs-pills {
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
  }

  .subtab-chip {
    font-size: 0.78rem;
    font-weight: 600;
    padding: 0.25rem 0.65rem;
    border-radius: 0.4rem;
    color: #94a3b8;
    text-decoration: none;
    background: #1e293b;
    border: 1px solid #334155;
    transition: all 0.15s ease;
  }
  .subtab-chip:hover {
    color: #f8fafc;
    background: #283548;
  }
  .subtab-chip.active {
    background: #3b82f6;
    color: #ffffff;
    border-color: #3b82f6;
  }

  /* =========================================================
     DESKTOP ADAPTATIONS (min-width: 768px & 1024px)
     ========================================================= */

  @media (min-width: 768px) {
    .site-nav-topbar {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      padding: 0.85rem 1.25rem;
    }

    .management-banner {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }

    .stepper-header {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }

    .stepper-progress-meta {
      max-width: 24rem;
    }
  }

  @media (min-width: 1024px) {
    .steps-list {
      display: grid;
      grid-template-columns: repeat(7, 1fr);
      gap: 0.5rem;
      min-width: 0;
    }

    .step-anchor {
      width: 100%;
      justify-content: flex-start;
      padding: 0.55rem 0.65rem;
    }

    .step-name-text {
      overflow: hidden;
      text-overflow: ellipsis;
    }
  }
</style>
