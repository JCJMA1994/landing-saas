---
import type { SiteTheme } from "../../domain/site/theme";
import type { SiteHero } from "../../domain/site/hero";
import type { SiteCard } from "../../domain/site/card";
import type { SitePromotion } from "../../domain/site/promotion";
import type { SiteContacts } from "../../domain/site/contact";
import { themeToCssVariables, serializeCssVariables } from "../../domain/design-system/tokens";
import Button from "../design-system/Button.astro";
import Badge from "../design-system/Badge.astro";
import Card from "../design-system/Card.astro";
import Icon from "../design-system/Icon.astro";
import WhatsAppButton from "../design-system/WhatsAppButton.astro";

interface Props {
  theme: SiteTheme;
  hero: SiteHero | null;
  cards: SiteCard[];
  promotions: SitePromotion[];
  contacts: SiteContacts | null;
  siteName?: string | undefined;
}

const { theme, hero, cards, promotions, contacts, siteName = "Tech Diagnostic" } = Astro.props;
const cssVars = serializeCssVariables(themeToCssVariables(theme));
const activePromotions = promotions.filter((p) => p.isActive);
---

<div class="template-diagnostic" style={cssVars} data-theme-root>
  {/* Header Bar */}
  <header class="diag-header-bar">
    <div class="diag-container diag-header-content">
      <div class="diag-brand">
        <Icon name="cpu" size={20} />
        <span class="diag-brand-title">{siteName}</span>
      </div>
      {contacts?.phone && (
        <a href={`tel:${contacts.phone}`} class="diag-header-phone">
          <Icon name="phone" size={14} />
          <span>{contacts.phone}</span>
        </a>
      )}
    </div>
  </header>

  {/* Active Promotion Carousel Ticker */}
  {activePromotions.length > 0 && (
    <aside class="diag-promo-carousel-wrapper" aria-label="Promociones activas">
      <div class="diag-promo-carousel-track">
        {Array.from({ length: 4 }).flatMap(() => activePromotions).map((promo) => (
          <div class="diag-promo-item">
            <Icon name="bolt" size={14} class="diag-promo-icon" />
            <span class="diag-promo-title">{promo.title}</span>
            {promo.discountLabel && (
              <span class="diag-promo-discount">{promo.discountLabel}</span>
            )}
            {promo.couponCode && (
              <code class="diag-promo-code">CÓDIGO: {promo.couponCode}</code>
            )}
            <span class="diag-promo-separator" aria-hidden="true">✦</span>
          </div>
        ))}
      </div>
    </aside>
  )}

  {/* Hero Section */}
  {hero && (
    <section class="diag-hero-section">
      <div class="diag-container diag-hero-grid">
        <div class="diag-hero-copy">
          <div class="diag-section-tag">
            <span class="diag-tag-num">[01]</span>
            <span class="diag-tag-name">{hero.badgeText || "ESPECIFICACIÓN Y RESUMEN"}</span>
          </div>
          <h1 class="diag-hero-title">{hero.headline}</h1>
          {hero.subheadline && <p class="diag-hero-subtitle">{hero.subheadline}</p>}

          <div class="diag-hero-actions">
            {hero.ctaText && hero.ctaLink && (
              <Button href={hero.ctaLink} variant={theme.buttonVariant} size="lg">
                {hero.ctaText}
              </Button>
            )}
            {contacts?.whatsappNumber && (
              <WhatsAppButton phone={contacts.whatsappNumber} message={contacts.whatsappMessage} size="lg" />
            )}
          </div>
        </div>

        <div class="diag-hero-media">
          <div class="diag-media-frame">
            <div class="diag-hud-schematic" aria-hidden="true">
              <div class="diag-hud-reticle"></div>
              <div class="diag-hud-data-row">
                <span>SENSOR_01: ACTIVO</span>
                <span>VOLTAJE: 3.3V</span>
              </div>
              <div class="diag-hud-data-row">
                <span>SEÑAL: 99.4%</span>
                <span>FREC_CH: 2.4GHz</span>
              </div>
            </div>
            <div class="diag-hud-overlay" aria-hidden="true">
              <span class="diag-hud-corner tl"></span>
              <span class="diag-hud-corner tr"></span>
              <span class="diag-hud-corner bl"></span>
              <span class="diag-hud-corner br"></span>
              <span class="diag-hud-scan">CALIBRADO // 100%</span>
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  {/* Cards Section: Diagnostic Telemetry Grid */}
  {cards.length > 0 && (
    <section class="diag-cards-section">
      <div class="diag-container">
        <div class="diag-section-header">
          <div class="diag-section-tag">
            <span class="diag-tag-num">[02]</span>
            <span class="diag-tag-name">MATRIZ DE DIAGNÓSTICO Y CAPACIDADES</span>
          </div>
          <h2 class="diag-section-heading">Diagnósticos y Soluciones Técnicas</h2>
        </div>

        <div class="diag-cards-grid">
          {cards.map((card, idx) => (
            <Card variant={theme.cardVariant} class="diag-card-item">
              <div class="diag-card-header">
                <span class="diag-card-idx">MÓDULO #{String(idx + 1).padStart(2, "0")}</span>
                <Icon name={(card.iconKey as any) || "wrench"} size={22} class="diag-card-icon" />
              </div>
              <h3 class="diag-card-title">{card.title}</h3>
              {card.description && <p class="diag-card-desc">{card.description}</p>}
              {card.badge && (
                <div class="diag-card-badge-wrap">
                  <Badge variant="primary" size="sm">{card.badge}</Badge>
                </div>
              )}
              {card.linkUrl && (
                <div class="diag-card-footer">
                  <a href={card.linkUrl} class="diag-card-link">
                    <span>Ver especificación técnica</span>
                    <Icon name="external" size={14} />
                  </a>
                </div>
              )}
            </Card>
          ))}
        </div>
      </div>
    </section>
  )}

  {/* Contacts / Technical Dispatch Section */}
  {contacts && (
    <section class="diag-contact-section">
      <div class="diag-container">
        <div class="diag-contact-panel">
          <div class="diag-contact-info">
            <div class="diag-section-tag">
              <span class="diag-tag-num">[03]</span>
              <span class="diag-tag-name">DESPACHO DE COMUNICACIONES</span>
            </div>
            <h2 class="diag-contact-heading">Canales de Enlace Directo</h2>
            <p class="diag-contact-desc">
              Comuníquese con nuestros especialistas para evaluación, diagnóstico o agendamiento técnico inmediato.
            </p>

            <div class="diag-channels-list">
              {contacts.phone && (
                <div class="diag-channel-row">
                  <Icon name="phone" size={16} />
                  <span>TEL: {contacts.phone}</span>
                </div>
              )}
              {contacts.email && (
                <div class="diag-channel-row">
                  <Icon name="email" size={16} />
                  <span>CORREO: {contacts.email}</span>
                </div>
              )}
              {contacts.instagramHandle && (
                <div class="diag-channel-row">
                  <Icon name="instagram" size={16} />
                  <a href={`https://instagram.com/${contacts.instagramHandle.replace(/^@/, "")}`} target="_blank" rel="noopener noreferrer">
                    @{contacts.instagramHandle.replace(/^@/, "")}
                  </a>
                </div>
              )}
              {contacts.facebookUrl && (
                <div class="diag-channel-row">
                  <Icon name="facebook" size={16} />
                  <a href={contacts.facebookUrl} target="_blank" rel="noopener noreferrer">
                    Página Oficial
                  </a>
                </div>
              )}
            </div>
          </div>

          <div class="diag-contact-cta">
            {contacts.whatsappNumber && (
              <div class="diag-whatsapp-box">
                <span class="diag-live-status">LÍNEA DIRECTA DISPONIBLE</span>
                <WhatsAppButton phone={contacts.whatsappNumber} message={contacts.whatsappMessage} size="lg" />
              </div>
            )}
          </div>
        </div>
      </div>
    </section>
  )}

  {/* Technical Footer */}
  <footer class="diag-footer">
    <div class="diag-container diag-footer-content">
      <span class="diag-footer-copy">© {new Date().getFullYear()} {siteName} // ARQUITECTURA DE DIAGNÓSTICO</span>
      <span class="diag-footer-version">TELEMETRÍA v1.0.4 - NORMAS ISO/IEC</span>
    </div>
  </footer>
</div>

<style>
  .template-diagnostic {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    font-family: var(--ds-theme-font, monospace);
    background-color: var(--ds-color-background, #0a0f1e);
    color: var(--ds-color-text, #f8fafc);
    border-top: 3px solid var(--ds-color-primary, #3b82f6);
  }

  .diag-container {
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 var(--ds-space-4, 1rem);
    box-sizing: border-box;
  }

  .diag-header-bar {
    background: rgba(0, 0, 0, 0.4);
    border-bottom: 1px solid var(--ds-color-border, rgba(255, 255, 255, 0.1));
    padding: var(--ds-space-2, 0.5rem) 0;
    font-size: var(--ds-text-xs, 0.75rem);
  }

  .diag-header-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--ds-space-4, 1rem);
    flex-wrap: wrap;
  }

  .diag-brand {
    display: flex;
    align-items: center;
    gap: var(--ds-space-2, 0.5rem);
    font-weight: 700;
    letter-spacing: 0.05em;
    font-size: var(--ds-text-base, 1rem);
  }

  .diag-header-phone {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--ds-color-muted, #94a3b8);
    text-decoration: none;
    font-family: var(--ds-font-mono);
    font-size: var(--ds-text-xs, 0.75rem);
    transition: color 0.15s ease;
  }

  .diag-header-phone:hover {
    color: var(--ds-color-primary, #60a5fa);
  }

  .diag-promo-carousel-wrapper {
    overflow: hidden;
    white-space: nowrap;
    background: linear-gradient(90deg, rgba(245, 158, 11, 0.12), rgba(234, 88, 12, 0.12));
    border-bottom: 1px solid rgba(245, 158, 11, 0.25);
    padding: 0.55rem 0;
    position: relative;
    user-select: none;
  }

  .diag-promo-carousel-wrapper:hover .diag-promo-carousel-track {
    animation-play-state: paused;
  }

  .diag-promo-carousel-track {
    display: inline-flex;
    align-items: center;
    gap: 2rem;
    width: max-content;
    animation: diag-carousel-rotate 25s linear infinite;
    will-change: transform;
  }

  @keyframes diag-carousel-rotate {
    0% {
      transform: translateX(0%);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .diag-promo-carousel-track {
      animation: none;
      flex-wrap: wrap;
    }
  }

  .diag-promo-item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--ds-text-xs, 0.75rem);
    font-weight: 600;
    color: var(--ds-color-text, #f8fafc);
  }

  .diag-promo-icon {
    color: #f59e0b;
    flex-shrink: 0;
  }

  .diag-promo-title {
    color: var(--ds-color-text, #f8fafc);
  }

  .diag-promo-discount {
    background: #f59e0b;
    color: #0b0f19;
    font-size: 0.68rem;
    font-weight: 800;
    padding: 0.1rem 0.4rem;
    border-radius: 3px;
    letter-spacing: 0.04em;
  }

  .diag-promo-code {
    background: rgba(0, 0, 0, 0.5);
    color: #fbbf24;
    padding: 0.1rem 0.35rem;
    border-radius: 3px;
    border: 1px dashed rgba(245, 158, 11, 0.5);
    font-family: var(--ds-font-mono);
  }

  .diag-promo-separator {
    color: rgba(245, 158, 11, 0.6);
    margin-left: 1.5rem;
    font-size: 0.7rem;
  }

  .diag-hero-section {
    padding: var(--ds-space-12, 3rem) 0;
    border-bottom: 1px solid var(--ds-color-border, rgba(255, 255, 255, 0.08));
  }

  .diag-hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--ds-space-8, 2rem);
    align-items: center;
  }

  @media (min-width: 768px) {
    .diag-hero-grid {
      grid-template-columns: 1.2fr 1fr;
    }
  }

  .diag-section-tag {
    display: inline-flex;
    align-items: center;
    gap: var(--ds-space-2, 0.5rem);
    font-family: var(--ds-font-mono);
    font-size: var(--ds-text-xs, 0.75rem);
    color: var(--ds-color-primary, #60a5fa);
    margin-bottom: var(--ds-space-2, 0.5rem);
    letter-spacing: 0.08em;
  }

  .diag-hero-title {
    font-size: var(--ds-text-4xl, 2.5rem);
    font-weight: 800;
    line-height: 1.15;
    margin: 0 0 var(--ds-space-4, 1rem) 0;
    letter-spacing: -0.02em;
  }

  .diag-hero-subtitle {
    font-size: var(--ds-text-lg, 1.125rem);
    color: var(--ds-color-muted, #94a3b8);
    line-height: 1.6;
    margin: 0 0 var(--ds-space-8, 2rem) 0;
  }

  .diag-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ds-space-3, 0.75rem);
    align-items: center;
  }

  .diag-media-frame {
    position: relative;
    border: 1px solid var(--ds-color-primary, #3b82f6);
    background: rgba(0, 0, 0, 0.75);
    overflow: hidden;
    border-radius: var(--ds-theme-radius, 4px);
    min-height: 240px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .diag-hud-schematic {
    padding: var(--ds-space-6, 1.5rem);
    display: flex;
    flex-direction: column;
    gap: var(--ds-space-4, 1rem);
    width: 100%;
    font-family: var(--ds-font-mono);
    font-size: var(--ds-text-xs, 0.75rem);
    color: var(--ds-color-primary, #60a5fa);
  }

  .diag-hud-reticle {
    width: 60px;
    height: 60px;
    border: 1px dashed var(--ds-color-primary, #60a5fa);
    border-radius: 50%;
    margin: 0 auto;
  }

  .diag-hud-data-row {
    display: flex;
    justify-content: space-between;
    background: rgba(59, 130, 246, 0.08);
    padding: 0.35rem 0.75rem;
    border-radius: 2px;
  }

  .diag-hud-overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .diag-hud-corner {
    position: absolute;
    width: 12px;
    height: 12px;
    border-color: var(--ds-color-primary, #60a5fa);
    border-style: solid;
  }
  .diag-hud-corner.tl { top: 6px; left: 6px; border-width: 2px 0 0 2px; }
  .diag-hud-corner.tr { top: 6px; right: 6px; border-width: 2px 2px 0 0; }
  .diag-hud-corner.bl { bottom: 6px; left: 6px; border-width: 0 0 2px 2px; }
  .diag-hud-corner.br { bottom: 6px; right: 6px; border-width: 0 2px 2px 0; }

  .diag-hud-scan {
    position: absolute;
    bottom: 8px;
    right: 12px;
    font-size: 0.65rem;
    font-family: var(--ds-font-mono);
    color: var(--ds-color-primary, #60a5fa);
    background: rgba(0, 0, 0, 0.6);
    padding: 2px 6px;
  }

  .diag-cards-section {
    padding: var(--ds-space-12, 3rem) 0;
  }

  .diag-section-header {
    margin-bottom: var(--ds-space-8, 2rem);
  }

  .diag-section-heading {
    font-size: var(--ds-text-2xl, 1.75rem);
    font-weight: 700;
    margin: 0;
  }

  .diag-cards-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--ds-space-4, 1rem);
  }

  @media (min-width: 640px) {
    .diag-cards-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .diag-cards-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .diag-card-item {
    display: flex;
    flex-direction: column;
    border-left: 3px solid var(--ds-color-primary, #3b82f6);
  }

  .diag-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--ds-space-3, 0.75rem);
  }

  .diag-card-idx {
    font-family: var(--ds-font-mono);
    font-size: var(--ds-text-xs, 0.75rem);
    color: var(--ds-color-primary, #60a5fa);
    font-weight: 600;
  }

  .diag-card-title {
    font-size: var(--ds-text-lg, 1.125rem);
    font-weight: 700;
    margin: 0 0 var(--ds-space-2, 0.5rem) 0;
  }

  .diag-card-desc {
    font-size: var(--ds-text-sm, 0.875rem);
    color: var(--ds-color-muted, #94a3b8);
    line-height: 1.5;
    flex-grow: 1;
    margin: 0 0 var(--ds-space-4, 1rem) 0;
  }

  .diag-card-badge-wrap {
    margin-bottom: var(--ds-space-3, 0.75rem);
  }

  .diag-card-link {
    display: inline-flex;
    align-items: center;
    gap: var(--ds-space-1, 0.25rem);
    font-size: var(--ds-text-xs, 0.75rem);
    color: var(--ds-color-primary, #60a5fa);
    text-decoration: none;
    font-weight: 600;
  }

  .diag-card-link:hover {
    text-decoration: underline;
  }

  .diag-contact-section {
    padding: var(--ds-space-8, 2rem) 0;
    margin-top: auto;
  }

  .diag-contact-panel {
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid var(--ds-color-border, rgba(255, 255, 255, 0.1));
    border-radius: var(--ds-theme-radius, 4px);
    padding: var(--ds-space-8, 2rem);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--ds-space-6, 1.5rem);
    align-items: center;
  }

  @media (min-width: 768px) {
    .diag-contact-panel {
      grid-template-columns: 1.5fr 1fr;
    }
  }

  .diag-contact-heading {
    font-size: var(--ds-text-xl, 1.5rem);
    margin: 0 0 var(--ds-space-2, 0.5rem) 0;
  }

  .diag-contact-desc {
    color: var(--ds-color-muted, #94a3b8);
    font-size: var(--ds-text-sm, 0.875rem);
    margin: 0 0 var(--ds-space-4, 1rem) 0;
  }

  .diag-channels-list {
    display: flex;
    flex-direction: column;
    gap: var(--ds-space-2, 0.5rem);
    font-size: var(--ds-text-xs, 0.75rem);
    font-family: var(--ds-font-mono);
  }

  .diag-channel-row {
    display: flex;
    align-items: center;
    gap: var(--ds-space-2, 0.5rem);
    color: var(--ds-color-text, #f8fafc);
  }

  .diag-channel-row a {
    color: var(--ds-color-primary, #60a5fa);
    text-decoration: none;
  }

  .diag-whatsapp-box {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--ds-space-2, 0.5rem);
  }

  .diag-live-status {
    font-size: 0.65rem;
    font-family: var(--ds-font-mono);
    color: #10b981;
    letter-spacing: 0.08em;
  }

  .diag-footer {
    border-top: 1px solid var(--ds-color-border, rgba(255, 255, 255, 0.1));
    padding: var(--ds-space-4, 1rem) 0;
    font-size: 0.7rem;
    font-family: var(--ds-font-mono);
    color: var(--ds-color-muted, #64748b);
  }

  .diag-footer-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--ds-space-2, 0.5rem);
  }
</style>
