  /* Zigzag Feature Showcase (HubSpot Style) */
  .friendly-zigzag-wrap {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
    margin-bottom: 4rem;
  }

  .friendly-zigzag-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
  }

  .friendly-zigzag-reverse {
    direction: rtl;
  }

  .friendly-zigzag-reverse > * {
    direction: ltr;
  }

  @media (max-width: 860px) {
    .friendly-zigzag-row {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .friendly-zigzag-reverse {
      direction: ltr;
    }
  }

  .friendly-zigzag-pill {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: var(--ds-color-primary, #60a5fa);
    background: rgba(59, 130, 246, 0.12);
    padding: 0.2rem 0.6rem;
    border-radius: 9999px;
    margin-bottom: 0.75rem;
  }

  .friendly-zigzag-title {
    font-size: clamp(1.4rem, 2.5vw, 1.85rem);
    font-weight: 700;
    line-height: 1.25;
    color: #ffffff;
    margin: 0 0 1rem;
  }

  .friendly-zigzag-desc {
    color: #94a3b8;
    line-height: 1.6;
    margin: 0 0 1.5rem;
    font-size: 0.95rem;
  }

  .friendly-zigzag-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .friendly-zigzag-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    color: #cbd5e1;
    font-size: 0.88rem;
    line-height: 1.4;
  }

  .friendly-check-icon {
    color: #10b981;
    flex-shrink: 0;
    margin-top: 2px;
  }

