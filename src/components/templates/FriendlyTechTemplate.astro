    transition: color 0.15s ease;
  }

  .friendly-header-phone:hover {
    color: var(--ds-color-primary, #60a5fa);
  }

  .friendly-footer-socials {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .friendly-footer-social {
    color: var(--ds-color-muted, #94a3b8);
    display: inline-flex;
    align-items: center;
    transition: color 0.15s ease;
  }

  .friendly-footer-social:hover {
    color: var(--ds-color-primary, #60a5fa);
  }

  /* SaaS Mockup Frame & Floating Chips (HubSpot Style) */
  .friendly-saas-mockup-frame {
    position: relative;
    background: rgba(15, 23, 42, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--ds-theme-radius, 1rem);
    padding: 0.75rem;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(12px);
  }

  .friendly-mockup-browser-header {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.6rem 0.8rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    margin-bottom: 0.75rem;
  }

  .friendly-browser-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.2);
  }

  .friendly-browser-url {
    margin-left: auto;
    font-size: 0.72rem;
    color: #64748b;
    font-family: var(--ds-font-mono, monospace);
  }

  .friendly-floating-chip {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.85rem;
    background: rgba(15, 23, 42, 0.9);
    border: 1px solid rgba(59, 130, 246, 0.3);
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 600;
    color: #f8fafc;
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.3);
    backdrop-filter: blur(8px);
    z-index: 2;
  }

  .friendly-chip-top {
    top: -12px;
    right: 18px;
  }

  .friendly-chip-bottom {
    bottom: -14px;
    left: 18px;
  }

  .friendly-chip-pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 8px #10b981;
  }

  /* Trust & Integrations Strip (Whitespace Style) */
  .friendly-trust-strip {
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    background: rgba(255, 255, 255, 0.015);
    padding: 2.2rem 0;
    text-align: center;
  }

  .friendly-trust-caption {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #64748b;
    margin: 0 0 1.25rem;
  }

  .friendly-trust-logos {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .friendly-trust-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 1rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 9999px;
    font-size: 0.8rem;
    font-weight: 600;
