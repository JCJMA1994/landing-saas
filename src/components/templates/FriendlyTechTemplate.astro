---
import type { SiteTheme } from "../../domain/site/theme";
import type { SiteHero } from "../../domain/site/hero";
import type { SiteCard } from "../../domain/site/card";
import type { SitePromotion } from "../../domain/site/promotion";
import { type SiteContacts, generateWhatsAppUrl } from "../../domain/site/contact";
import { themeToCssVariables, serializeCssVariables } from "../../domain/design-system/tokens";
import Button from "../design-system/Button.astro";
import Badge from "../design-system/Badge.astro";
import Card from "../design-system/Card.astro";
import Icon from "../design-system/Icon.astro";
import WhatsAppButton from "../design-system/WhatsAppButton.astro";

interface Props {
  theme: SiteTheme;
  hero: SiteHero | null;
  cards: SiteCard[];
  promotions: SitePromotion[];
  contacts: SiteContacts | null;
  siteName?: string | undefined;
}

const { theme, hero, cards, promotions, contacts, siteName = "Friendly Tech" } = Astro.props;
const cssVars = serializeCssVariables(themeToCssVariables(theme));
const activePromotions = promotions.filter((p) => p.isActive);
---

<div class="template-friendly" style={cssVars} data-theme-root>
  {/* Friendly Header Bar */}
  <header class="friendly-header">
    <div class="friendly-container friendly-header-wrap">
      <div class="friendly-brand">
        {theme?.logoUrl ? (
          <img src={theme.logoUrl} alt={siteName} class="friendly-brand-logo" style="height: 32px; width: auto; object-fit: contain; max-width: 140px; border-radius: 4px;" />
        ) : (
          <Icon name="heart" size={20} class="friendly-heart-icon" />
        )}
        <span class="friendly-brand-text">{siteName}</span>
      </div>

      <nav class="friendly-nav" aria-label="Navegación principal">
        <a href="#inicio" class="friendly-nav-link">Inicio</a>
        <a href="#proceso" class="friendly-nav-link">Cómo Funciona</a>
        <a href="#soluciones" class="friendly-nav-link">Soluciones</a>
        <a href="#planes" class="friendly-nav-link">Planes</a>
        <a href="#opiniones" class="friendly-nav-link">Opiniones</a>
        <a href="#contacto" class="friendly-nav-link">Contacto</a>
      </nav>

      <div class="friendly-header-actions">
        {contacts?.whatsappNumber && (
          <a
            href={generateWhatsAppUrl(contacts.whatsappNumber, contacts.whatsappMessage)}
            target="_blank"
            rel="noopener noreferrer"
            class="friendly-header-cta"
            title="WhatsApp"
          >
            <Icon name="whatsapp" size={15} />
            <span>WhatsApp</span>
          </a>
        )}
        {contacts?.instagramHandle && (
          <a
            href={`https://instagram.com/${contacts.instagramHandle.replace(/^@/, "")}`}
            target="_blank"
            rel="noopener noreferrer"
            class="friendly-header-social"
            title="Instagram"
            aria-label="Instagram"
          >
            <Icon name="instagram" size={16} />
          </a>
        )}
        {contacts?.facebookUrl && (
          <a
            href={contacts.facebookUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="friendly-header-social"
            title="Facebook"
            aria-label="Facebook"
          >
            <Icon name="facebook" size={16} />
          </a>
        )}
        {contacts?.email && (
          <a
            href={`mailto:${contacts.email}`}
            class="friendly-header-social"
            title="Correo"
            aria-label="Correo"
          >
            <Icon name="email" size={16} />
          </a>
        )}
        {contacts?.phone && (
          <a href={`tel:${contacts.phone}`} class="friendly-header-phone" title="Teléfono">
            <Icon name="phone" size={14} />
            <span>{contacts.phone}</span>
          </a>
        )}
      </div>
    </div>
  </header>

  {/* Active Promotion: Smooth Carousel Ticker */}
  {activePromotions.length > 0 && (
    <aside class="friendly-perk-ribbon" aria-label="Beneficios y Promociones">
      <div class="friendly-promo-track">
        {Array.from({ length: 4 }).flatMap(() => activePromotions).map((promo) => (
          <div class="friendly-promo-item">
            <span class="friendly-promo-badge">BENEFICIO EXCLUSIVO</span>
            <span class="friendly-promo-title">{promo.title}</span>
            {promo.discountLabel && (
              <span class="friendly-promo-discount">{promo.discountLabel}</span>
            )}
            {promo.couponCode && (
              <code class="friendly-promo-code">CÓDIGO: {promo.couponCode}</code>
            )}
            <span class="friendly-promo-sep" aria-hidden="true">♥</span>
          </div>
        ))}
      </div>
    </aside>
  )}

  {/* Hero: Warm and Approachable SaaS Hero */}
  {hero && (
    <section id="inicio" class="friendly-hero-section">
      <div class="friendly-container friendly-hero-grid">
        <div class="friendly-hero-copy">
          <div class="friendly-pill-tag">
            <span>{hero.badgeText || "👋 TE DAMOS LA BIENVENIDA"}</span>
          </div>
          <h1 class="friendly-hero-title">{hero.headline}</h1>
          {hero.subheadline && <p class="friendly-hero-subtitle">{hero.subheadline}</p>}

          <div class="friendly-hero-actions">
            {contacts?.whatsappNumber && (
              <WhatsAppButton
                phone={contacts.whatsappNumber}
                message={contacts.whatsappMessage}
                size="lg"
                label="Hablemos por WhatsApp"
                class="friendly-cta-pill"
              />
            )}
            {hero.ctaText && hero.ctaLink && (
              <Button href={hero.ctaLink} variant="solid" size="lg" class="friendly-cta-pill">
                {hero.ctaText}
              </Button>
            )}
          </div>
        </div>

        <div class="friendly-hero-media">
          <div class="friendly-saas-mockup-frame">
            <div class="friendly-mockup-browser-header">
              <span class="friendly-browser-dot"></span>
              <span class="friendly-browser-dot"></span>
              <span class="friendly-browser-dot"></span>
              <span class="friendly-browser-url">{siteName.toLowerCase().replace(/\s+/g, '')}.com</span>
            </div>
            {hero.imageUrl ? (
              <div class="friendly-hero-img-wrap">
                <img src={hero.imageUrl} alt={hero.headline} class="friendly-hero-img" />
              </div>
            ) : (
              <div class="friendly-welcome-card">
                <div class="friendly-welcome-icon">
                  <Icon name="heart" size={36} />
                </div>
                <h3 class="friendly-welcome-title">Estamos para acompañarte</h3>
                <p class="friendly-welcome-text">Sin trámites complejos ni demoras. Asesoramiento humano directo.</p>
              </div>
            )}
            <div class="friendly-floating-chip friendly-chip-top">
              <span class="friendly-chip-pulse"></span>
              <span>Soporte 24/7 Verificado</span>
            </div>
            <div class="friendly-floating-chip friendly-chip-bottom">
              <Icon name="star" size={14} class="friendly-star-active" />
              <span>99.8% Satisfacción</span>
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  {/* Trust & Integrations Bar (SaaS Partner Strip - Whitespace Style) */}
  <section class="friendly-trust-strip" aria-label="Tecnología e integraciones">
    <div class="friendly-container">
      <p class="friendly-trust-caption">COMPATIBLE Y SINCRONIZADO CON TUS PLATAFORMAS FAVORITAS</p>
      <div class="friendly-trust-logos">
        <div class="friendly-trust-badge">
          <Icon name="cpu" size={16} />
          <span>Google Workspace</span>
        </div>
        <div class="friendly-trust-badge">
          <Icon name="bolt" size={16} />
          <span>Slack & Notion</span>
        </div>
        <div class="friendly-trust-badge">
          <Icon name="shield" size={16} />
          <span>Microsoft 365</span>
        </div>
        <div class="friendly-trust-badge">
          <Icon name="rocket" size={16} />
          <span>Cloud Infrastructure</span>
        </div>
        <div class="friendly-trust-badge">
          <Icon name="whatsapp" size={16} />
          <span>WhatsApp Business</span>
        </div>
      </div>
    </div>
  </section>

  {/* Friendly Experience: 3 Simple Steps */}
  <section id="proceso" class="friendly-steps-section" aria-label="Cómo te ayudamos">
    <div class="friendly-container">
      <div class="friendly-steps-header">
        <span class="friendly-steps-eyebrow">EXPERIENCIA SENCILLA</span>
        <h2 class="friendly-steps-title">Te acompañamos en 3 simples pasos</h2>
        <p class="friendly-steps-desc">Procesos claros pensados para que tengas total tranquilidad de principio a fin.</p>
      </div>

      <div class="friendly-steps-grid">
        <div class="friendly-step-card">
          <div class="friendly-step-number">01</div>
          <h3 class="friendly-step-heading">Consulta Inicial Sin Cargo</h3>
          <p class="friendly-step-text">Nos contás tu inquietud de forma directa y te respondemos de persona a persona.</p>
        </div>
        <div class="friendly-step-card">
          <div class="friendly-step-number">02</div>
          <h3 class="friendly-step-heading">Presupuesto Transparente</h3>
          <p class="friendly-step-text">Te detallamos cada punto con claridad total, sin letra chica ni costos ocultos.</p>
        </div>
        <div class="friendly-step-card">
          <div class="friendly-step-number">03</div>
          <h3 class="friendly-step-heading">Entrega y Acompañamiento</h3>
          <p class="friendly-step-text">Solución garantizada con seguimiento posventa para que sientas respaldo continuo.</p>
        </div>
      </div>
    </div>
  </section>

  {/* Solutions: Zigzag Deep-Dive & Approachable Cards (HubSpot Style) */}
  <section id="soluciones" class="friendly-cards-section">
    <div class="friendly-container">
      <div class="friendly-section-heading">
        <span class="friendly-steps-eyebrow">SOLUCIONES A TU MEDIDA</span>
        <h2 class="friendly-section-title">¿Cómo podemos ayudarte hoy?</h2>
        <p class="friendly-section-subtitle">Explicamos todo de forma clara y sin términos complicados.</p>
      </div>

      {/* Alternating Feature Showcase */}
      <div class="friendly-zigzag-wrap">
        <div class="friendly-zigzag-row">
          <div class="friendly-zigzag-copy">
            <span class="friendly-zigzag-pill">GESTIÓN SIMPLE</span>
            <h3 class="friendly-zigzag-title">Diseñado para que ahorres tiempo y ganes tranquilidad</h3>
            <p class="friendly-zigzag-desc">Cada herramienta y proceso está optimizado para que accedas a respuestas rápidas sin tener que lidiar con configuraciones técnicas complejas.</p>
            <ul class="friendly-zigzag-list">
              <li><Icon name="check" size={16} class="friendly-check-icon" /> Interfaz limpia, intuitiva y accesible desde cualquier dispositivo.</li>
              <li><Icon name="check" size={16} class="friendly-check-icon" /> Notificaciones instantáneas y seguimiento en tiempo real.</li>
              <li><Icon name="check" size={16} class="friendly-check-icon" /> Cero fricción operativa con asistencia humana cuando la necesites.</li>
            </ul>
          </div>
          <div class="friendly-zigzag-visual">
            <div class="friendly-preview-card">
              <div class="friendly-preview-topbar">
                <span class="friendly-preview-indicator"></span>
                <span class="friendly-preview-label">Panel en Vivo</span>
              </div>
              <div class="friendly-preview-metric-box">
                <span class="friendly-metric-val">100%</span>
                <span class="friendly-metric-tag">Transparencia y claridad</span>
              </div>
              <div class="friendly-preview-bar-track">
                <div class="friendly-preview-bar-fill" style="width: 85%;"></div>
              </div>
              <span class="friendly-preview-note">Optimización activa sin interrupciones</span>
            </div>
          </div>
        </div>

        <div class="friendly-zigzag-row friendly-zigzag-reverse">
          <div class="friendly-zigzag-copy">
            <span class="friendly-zigzag-pill">ACOMPAÑAMIENTO CONSTANTE</span>
            <h3 class="friendly-zigzag-title">Atención personalizada que resuelve tus dudas en minutos</h3>
            <p class="friendly-zigzag-desc">Detrás de la tecnología hay personas comprometidas con entender exactamente lo que requiere tu proyecto o negocio.</p>
            <ul class="friendly-zigzag-list">
              <li><Icon name="check" size={16} class="friendly-check-icon" /> Asesoramiento directo sin intermediarios ni bots confusos.</li>
              <li><Icon name="check" size={16} class="friendly-check-icon" /> Presupuestos claros antes de iniciar cualquier labor.</li>
              <li><Icon name="check" size={16} class="friendly-check-icon" /> Garantía de satisfacción en cada entrega realizada.</li>
            </ul>
          </div>
          <div class="friendly-zigzag-visual">
            <div class="friendly-preview-card friendly-preview-chat">
              <div class="friendly-preview-topbar">
                <Icon name="heart" size={16} class="friendly-heart-icon" />
                <span class="friendly-preview-label">Atención Dedicada</span>
              </div>
              <div class="friendly-chat-bubble friendly-chat-in">
                <span>¿Cuánto tardamos en empezar?</span>
              </div>
              <div class="friendly-chat-bubble friendly-chat-out">
                <span>¡Al instante! Ya dejamos todo listo para tu proyecto.</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      {/* Cards: Approachable Solutions Grid */}
      {cards.length > 0 && (
        <div class="friendly-cards-grid">
          {cards.map((card) => (
            <Card variant="elevated" class="friendly-card-bubble">
              <div class="friendly-card-icon-bubble">
                <Icon name={(card.iconKey as any) || "heart"} size={24} />
              </div>
              <h3 class="friendly-card-title">{card.title}</h3>
              {card.description && <p class="friendly-card-desc">{card.description}</p>}
              {card.badge && (
                <div class="friendly-card-badge-wrap">
                  <Badge variant="primary" size="sm">{card.badge}</Badge>
                </div>
              )}
              {card.linkUrl && (
                <div class="friendly-card-link-box">
                  <a href={card.linkUrl} class="friendly-card-link">
                    <span>Conocer más detalles</span>
                    <Icon name="external" size={14} />
                  </a>
                </div>
              )}
            </Card>
          ))}
        </div>
      )}
    </div>
  </section>

  {/* Pricing & Value Plans (Whitespace / SaaS Style) */}
  <section id="planes" class="friendly-pricing-section" aria-label="Planes y presupuestos">
    <div class="friendly-container">
      <div class="friendly-section-heading">
        <span class="friendly-steps-eyebrow">PLANES CLAROS</span>
        <h2 class="friendly-section-title">Elegí la opción ideal para tu objetivo</h2>
        <p class="friendly-section-subtitle">Precios transparentes y sin sorpresas. Adaptados a lo que realmente necesitás.</p>
      </div>

      <div class="friendly-pricing-grid">
        <div class="friendly-pricing-card">
          <div class="friendly-pricing-header">
            <h3 class="friendly-pricing-name">Inicial</h3>
            <p class="friendly-pricing-desc">Para resolver dudas puntuales o proyectos que recién comienzan.</p>
            <div class="friendly-pricing-rate">
              <span class="friendly-pricing-currency">$</span>
              <span class="friendly-pricing-amount">29</span>
              <span class="friendly-pricing-period">/consulta</span>
            </div>
          </div>
          <ul class="friendly-pricing-perks">
            <li><Icon name="check" size={16} /> Diagnóstico inicial express</li>
            <li><Icon name="check" size={16} /> Asesoramiento personalizado</li>
            <li><Icon name="check" size={16} /> Plan de acción en 24hs</li>
          </ul>
          <a href="#contacto" class="friendly-pricing-btn">Elegir Plan Inicial</a>
        </div>

        <div class="friendly-pricing-card friendly-pricing-featured">
          <div class="friendly-featured-badge">MÁS ELEGIDO</div>
          <div class="friendly-pricing-header">
            <h3 class="friendly-pricing-name">Profesional</h3>
            <p class="friendly-pricing-desc">La solución completa para optimizar y escalar con respaldo garantizado.</p>
            <div class="friendly-pricing-rate">
              <span class="friendly-pricing-currency">$</span>
              <span class="friendly-pricing-amount">89</span>
              <span class="friendly-pricing-period">/mes</span>
            </div>
          </div>
          <ul class="friendly-pricing-perks">
            <li><Icon name="check" size={16} /> Todo lo del plan Inicial</li>
            <li><Icon name="check" size={16} /> Monitoreo y mantenimiento preventivo</li>
            <li><Icon name="check" size={16} /> Soporte prioritario por WhatsApp</li>
            <li><Icon name="check" size={16} /> Ajustes y optimización continua</li>
          </ul>
          <a href="#contacto" class="friendly-pricing-btn friendly-pricing-btn-primary">Empezar con Profesional</a>
        </div>

        <div class="friendly-pricing-card">
          <div class="friendly-pricing-header">
            <h3 class="friendly-pricing-name">Empresarial</h3>
            <p class="friendly-pricing-desc">Acompañamiento integral a medida para alta demanda y equipos.</p>
            <div class="friendly-pricing-rate">
              <span class="friendly-pricing-amount">A Medida</span>
            </div>
          </div>
          <ul class="friendly-pricing-perks">
            <li><Icon name="check" size={16} /> Arquitectura e integración dedicada</li>
            <li><Icon name="check" size={16} /> SLA de respuesta menor a 2 horas</li>
            <li><Icon name="check" size={16} /> Consultoría estratégica mensual</li>
            <li><Icon name="check" size={16} /> Capacitación directa a tu equipo</li>
          </ul>
          <a href="#contacto" class="friendly-pricing-btn">Consultar por WhatsApp</a>
        </div>
      </div>
    </div>
  </section>

  {/* Social Proof & Testimonials (HubSpot & Whitespace Style) */}
  <section id="opiniones" class="friendly-testimonials-section" aria-label="Testimonios de clientes">
    <div class="friendly-container">
      <div class="friendly-testimonial-card">
        <div class="friendly-testimonial-stars">
          <Icon name="star" size={20} class="friendly-star-active" />
          <Icon name="star" size={20} class="friendly-star-active" />
          <Icon name="star" size={20} class="friendly-star-active" />
          <Icon name="star" size={20} class="friendly-star-active" />
          <Icon name="star" size={20} class="friendly-star-active" />
        </div>
        <blockquote class="friendly-testimonial-quote">
          “Trabajar con este equipo nos cambió por completo la velocidad y la tranquilidad operativa. La claridad en cada paso y la rapidez para responder dudas es de otro nivel.”
        </blockquote>
        <div class="friendly-testimonial-author">
          <div class="friendly-author-avatar">MC</div>
          <div class="friendly-author-info">
            <span class="friendly-author-name">Mariana Costa</span>
            <span class="friendly-author-role">Directora de Operaciones en InnovaTech</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Contacts: Friendly Invitation */}
  {contacts && (
    <section id="contacto" class="friendly-contact-section">
      <div class="friendly-container">
        <div class="friendly-contact-card">
          <div class="friendly-contact-content">
            <h2 class="friendly-contact-title">Estamos para responder todas tus dudas</h2>
            <p class="friendly-contact-sub">Escribinos sin compromiso. Te asesoramos con gusto y transparencia.</p>

            <div class="friendly-contact-channels">
              {contacts.phone && (
                <div class="friendly-channel-item">
                  <Icon name="phone" size={18} />
                  <span>{contacts.phone}</span>
                </div>
              )}
              {contacts.email && (
                <div class="friendly-channel-item">
                  <Icon name="email" size={18} />
                  <span>{contacts.email}</span>
                </div>
              )}
              {contacts.instagramHandle && (
                <div class="friendly-channel-item">
                  <Icon name="instagram" size={18} />
                  <a href={`https://instagram.com/${contacts.instagramHandle.replace(/^@/, "")}`} target="_blank" rel="noopener noreferrer">
                    @{contacts.instagramHandle.replace(/^@/, "")}
                  </a>
                </div>
              )}
              {contacts.facebookUrl && (
                <div class="friendly-channel-item">
                  <Icon name="facebook" size={18} />
                  <a href={contacts.facebookUrl} target="_blank" rel="noopener noreferrer">
                    Facebook
                  </a>
                </div>
              )}
            </div>
          </div>

          <div class="friendly-contact-button-wrap">
            {contacts.whatsappNumber && (
              <WhatsAppButton
                phone={contacts.whatsappNumber}
                message={contacts.whatsappMessage}
                size="lg"
                label="Envíanos un mensaje"
                class="friendly-cta-pill"
              />
            )}
          </div>
        </div>
      </div>
    </section>
  )}

  {/* Footer */}
  <footer class="friendly-footer">
    <div class="friendly-container">
      <div class="friendly-footer-grid">
        <div class="friendly-footer-brand-col">
          <div class="friendly-footer-brand">
            {theme?.logoUrl ? (
              <img src={theme.logoUrl} alt={siteName} class="friendly-footer-logo" />
            ) : (
              <Icon name="heart" size={22} class="friendly-heart-icon" />
            )}
            <span class="friendly-footer-title">{siteName}</span>
          </div>
          <p class="friendly-footer-desc">Soluciones claras, asesoramiento cercano y atención personalizada con calidez humana.</p>
        </div>

        <div class="friendly-footer-nav-col">
          <span class="friendly-footer-heading">SECCIONES</span>
          <nav class="friendly-footer-nav" aria-label="Navegación pie de página">
            <a href="#inicio" class="friendly-footer-link">Inicio</a>
            <a href="#proceso" class="friendly-footer-link">Cómo Funciona</a>
            <a href="#soluciones" class="friendly-footer-link">Soluciones</a>
            <a href="#planes" class="friendly-footer-link">Planes</a>
            <a href="#opiniones" class="friendly-footer-link">Opiniones</a>
            <a href="#contacto" class="friendly-footer-link">Contacto</a>
          </nav>
        </div>

        {contacts && (
          <div class="friendly-footer-contact-col">
            <span class="friendly-footer-heading">CONTACTO</span>
            <div class="friendly-footer-contact-list">
              {contacts.phone && (
                <a href={`tel:${contacts.phone}`} class="friendly-footer-contact-link">
                  <Icon name="phone" size={14} />
                  <span>{contacts.phone}</span>
                </a>
              )}
              {contacts.email && (
                <a href={`mailto:${contacts.email}`} class="friendly-footer-contact-link">
                  <Icon name="email" size={14} />
                  <span>{contacts.email}</span>
                </a>
              )}
            </div>
            <div class="friendly-footer-socials">
              {contacts.whatsappNumber && (
                <a
                  href={generateWhatsAppUrl(contacts.whatsappNumber, contacts.whatsappMessage)}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="friendly-footer-social"
                  title="WhatsApp"
                  aria-label="WhatsApp"
                >
                  <Icon name="whatsapp" size={16} />
                </a>
              )}
              {contacts.instagramHandle && (
                <a
                  href={`https://instagram.com/${contacts.instagramHandle.replace(/^@/, "")}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="friendly-footer-social"
                  title="Instagram"
                  aria-label="Instagram"
                >
                  <Icon name="instagram" size={16} />
                </a>
              )}
              {contacts.facebookUrl && (
                <a
                  href={contacts.facebookUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="friendly-footer-social"
                  title="Facebook"
                  aria-label="Facebook"
                >
                  <Icon name="facebook" size={16} />
                </a>
              )}
            </div>
          </div>
        )}
      </div>

      <div class="friendly-footer-bottom">
        <span>© {new Date().getFullYear()} {siteName}. Hecho con dedicación y calidez humana.</span>
      </div>
    </div>
  </footer>
</div>

<style>
  .template-friendly {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    font-family: var(--ds-font-outfit, sans-serif);
