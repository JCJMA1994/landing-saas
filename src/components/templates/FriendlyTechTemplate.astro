    color: var(--ds-color-primary, #60a5fa);
    letter-spacing: 0.05em;
    margin-bottom: 0.75rem;
  }

  .friendly-footer-nav {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .friendly-footer-link {
    color: #94a3b8;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .friendly-footer-link:hover {
    color: var(--ds-color-primary, #60a5fa);
  }

  .friendly-footer-contact-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .friendly-footer-contact-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: #94a3b8;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .friendly-footer-contact-link:hover {
    color: var(--ds-color-primary, #60a5fa);
  }

  .friendly-footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.06);
