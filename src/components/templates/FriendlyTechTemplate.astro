  }

  .friendly-header-cta:hover {
    background: var(--ds-color-primary, #3b82f6);
    color: #ffffff;
  }

  .friendly-heart-icon {
    color: var(--ds-color-primary, #3b82f6);
  }

  .friendly-brand-text {
    font-size: var(--ds-text-lg, 1.125rem);
    font-weight: 700;
  }

  .friendly-motto {
    font-size: var(--ds-text-xs, 0.75rem);
    color: var(--ds-color-muted, #94a3b8);
  }

  .friendly-perk-ribbon {
    background: rgba(59, 130, 246, 0.12);
    border-bottom: 1px solid rgba(59, 130, 246, 0.25);
