  .friendly-nav-link:hover {
    color: var(--ds-color-primary, #60a5fa);
  }

  .friendly-header-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: rgba(59, 130, 246, 0.15);
    border: 1px solid rgba(59, 130, 246, 0.4);
    color: var(--ds-color-primary, #60a5fa);
    padding: 0.25rem 0.65rem;
    border-radius: 9999px;
