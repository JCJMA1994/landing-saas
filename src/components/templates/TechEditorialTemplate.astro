---
import type { SiteTheme } from "../../domain/site/theme";
import type { SiteHero } from "../../domain/site/hero";
import type { SiteCard } from "../../domain/site/card";
import type { SitePromotion } from "../../domain/site/promotion";
import { type SiteContacts, generateWhatsAppUrl } from "../../domain/site/contact";
import { themeToCssVariables, serializeCssVariables } from "../../domain/design-system/tokens";
import Button from "../design-system/Button.astro";
import Badge from "../design-system/Badge.astro";
import Card from "../design-system/Card.astro";
import Icon from "../design-system/Icon.astro";
import WhatsAppButton from "../design-system/WhatsAppButton.astro";

interface Props {
  theme: SiteTheme;
  hero: SiteHero | null;
  cards: SiteCard[];
  promotions: SitePromotion[];
  contacts: SiteContacts | null;
  siteName?: string | undefined;
}

const { theme, hero, cards, promotions, contacts, siteName = "Tech Editorial" } = Astro.props;
const cssVars = serializeCssVariables(themeToCssVariables(theme));
const activePromotions = promotions.filter((p) => p.isActive);
---

<div class="template-editorial" style={cssVars} data-theme-root>
  {/* Editorial Masthead */}
  <header class="edit-masthead">
    <div class="edit-container edit-masthead-wrap">
      <div class="edit-pub-title" style="display: flex; align-items: center; gap: 0.6rem;">
        {theme?.logoUrl && (
          <img src={theme.logoUrl} alt={siteName} class="edit-brand-logo" style="height: 28px; width: auto; object-fit: contain; max-width: 130px;" />
        )}
        <span>{siteName}</span>
      </div>
      <div class="edit-header-actions">
        {contacts?.whatsappNumber && (
          <a
            href={generateWhatsAppUrl(contacts.whatsappNumber, contacts.whatsappMessage)}
            target="_blank"
            rel="noopener noreferrer"
            class="edit-header-social"
            title="WhatsApp"
            aria-label="WhatsApp"
          >
            <Icon name="whatsapp" size={15} />
          </a>
        )}
        {contacts?.instagramHandle && (
          <a
            href={`https://instagram.com/${contacts.instagramHandle.replace(/^@/, "")}`}
            target="_blank"
            rel="noopener noreferrer"
            class="edit-header-social"
            title="Instagram"
            aria-label="Instagram"
          >
            <Icon name="instagram" size={15} />
          </a>
        )}
        {contacts?.facebookUrl && (
          <a
            href={contacts.facebookUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="edit-header-social"
            title="Facebook"
            aria-label="Facebook"
          >
            <Icon name="facebook" size={15} />
          </a>
        )}
        {contacts?.email && (
          <a
            href={`mailto:${contacts.email}`}
            class="edit-header-social"
            title="Correo"
            aria-label="Correo"
          >
            <Icon name="email" size={15} />
          </a>
        )}
        {contacts?.phone && (
          <a href={`tel:${contacts.phone}`} class="edit-header-phone" title="Teléfono">
            <Icon name="phone" size={13} />
            <span>{contacts.phone}</span>
          </a>
        )}
      </div>
    </div>
  </header>

  {/* Active Promotion: Editorial Wire Ticker */}
  {activePromotions.length > 0 && (
    <aside class="edit-curated-notice" aria-label="Destacados y Promociones de Temporada">
      <div class="edit-curated-track">
        {Array.from({ length: 4 }).flatMap(() => activePromotions).map((promo) => (
          <div class="edit-curated-item">
            <span class="edit-curated-badge">EDICIÓN ESPECIAL</span>
            <span class="edit-curated-title">{promo.title}</span>
            {promo.discountLabel && (
              <span class="edit-curated-benefit">— {promo.discountLabel}</span>
            )}
            {promo.couponCode && (
              <span class="edit-curated-code">Código: {promo.couponCode}</span>
            )}
            <span class="edit-curated-sep" aria-hidden="true">/</span>
          </div>
        ))}
      </div>
    </aside>
  )}

  {/* Hero: Asymmetrical Editorial Spread */}
  {hero && (
    <section class="edit-hero-section">
      <div class="edit-container">
        <div class="edit-hero-layout">
          <div class="edit-hero-main">
            <span class="edit-kicker">{hero.badgeText || "PERSPECTIVA & VISIÓN TÉCNICA"}</span>
            <h1 class="edit-headline">{hero.headline}</h1>
            {hero.subheadline && <p class="edit-standfirst">{hero.subheadline}</p>}

            <div class="edit-actions-row">
              {hero.ctaText && hero.ctaLink && (
                <Button href={hero.ctaLink} variant="solid" size="lg">
                  {hero.ctaText}
                </Button>
              )}
              {contacts?.whatsappNumber && (
                <WhatsAppButton phone={contacts.whatsappNumber} message={contacts.whatsappMessage} size="lg" />
              )}
            </div>
          </div>

          <aside class="edit-hero-aside">
            {hero.imageUrl ? (
              <div class="edit-hero-img-wrap">
                <img src={hero.imageUrl} alt={hero.headline} class="edit-hero-img" />
              </div>
            ) : (
              <blockquote class="edit-pullquote">
                “La sofisticación técnica no reside en la complejidad innecesaria, sino en la impecable ejecución de los fundamentos.”
              </blockquote>
            )}
          </aside>
        </div>
      </div>
    </section>
  )}

  {/* Editorial Indices & Value Manifesto */}
  <section class="edit-manifesto-section" aria-label="Compromisos Editoriales de Excelencia">
    <div class="edit-container">
      <div class="edit-manifesto-grid">
        <div class="edit-manifesto-column">
          <span class="edit-manifesto-num">I.</span>
          <h3 class="edit-manifesto-title">Excelencia Operativa</h3>
          <p class="edit-manifesto-p">Cada proceso es supervisado con estándares rigurosos de precisión y consistencia técnica.</p>
        </div>
        <div class="edit-manifesto-column">
          <span class="edit-manifesto-num">II.</span>
          <h3 class="edit-manifesto-title">Atención Personalizada</h3>
          <p class="edit-manifesto-p">Asesoramiento profesional directo y cercano, sin intermediarios impersonales.</p>
        </div>
        <div class="edit-manifesto-column">
          <span class="edit-manifesto-num">III.</span>
          <h3 class="edit-manifesto-title">Garantía Verificable</h3>
          <p class="edit-manifesto-p">Trazabilidad documentada y respaldo formal en cada servicio prestado.</p>
        </div>
      </div>
    </div>
  </section>

  {/* Cards: In-depth Editorial Features */}
  {cards.length > 0 && (
    <section class="edit-features-section">
      <div class="edit-container">
        <div class="edit-section-header">
          <span class="edit-kicker">PROPUESTA DE VALOR</span>
          <h2 class="edit-section-title">Ejes Fundamentales de Servicio</h2>
        </div>

        <div class="edit-features-grid">
          {cards.map((card, idx) => (
            <Card variant="flat" class="edit-feature-column">
              <span class="edit-column-num">{String(idx + 1).padStart(2, "0")}</span>
              <div class="edit-column-body">
                <div class="edit-column-icon-wrap">
                  <Icon name={(card.iconKey as any) || "star"} size={22} />
                </div>
                <h3 class="edit-column-title">{card.title}</h3>
                {card.description && <p class="edit-column-text">{card.description}</p>}
                {card.badge && (
                  <div class="edit-column-badge">
                    <Badge variant="neutral" size="sm">{card.badge}</Badge>
                  </div>
                )}
                {card.linkUrl && (
                  <div class="edit-column-link-box">
                    <a href={card.linkUrl} class="edit-column-link">
                      <span>Continuar leyendo</span>
                      <Icon name="external" size={12} />
                    </a>
                  </div>
                )}
              </div>
            </Card>
          ))}
        </div>
      </div>
    </section>
  )}

  {/* Contacts: Bespoke Correspondence Column */}
  {contacts && (
    <section class="edit-contact-section">
      <div class="edit-container">
        <div class="edit-contact-spread">
          <div class="edit-contact-copy">
            <span class="edit-kicker">CORRESPONDENCIA & ENLACE</span>
            <h2 class="edit-contact-title">Inicie una Conversación Directa</h2>
            <p class="edit-contact-lead">
              Atendemos consultas ejecutivas y proyectos especiales con dedicación personalizada y criterio técnico.
            </p>

            <div class="edit-contact-lines">
              {contacts.phone && <p class="edit-contact-item">Línea directa: {contacts.phone}</p>}
              {contacts.email && <p class="edit-contact-item">Contacto formal: {contacts.email}</p>}
              {contacts.instagramHandle && (
                <p class="edit-contact-item">
                  Presencia: <a href={`https://instagram.com/${contacts.instagramHandle.replace(/^@/, "")}`} target="_blank" rel="noopener noreferrer">@{contacts.instagramHandle.replace(/^@/, "")}</a>
                </p>
              )}
              {contacts.facebookUrl && (
                <p class="edit-contact-item">
                  Facebook: <a href={contacts.facebookUrl} target="_blank" rel="noopener noreferrer">Página Oficial</a>
                </p>
              )}
            </div>
          </div>

          <div class="edit-contact-action-box">
            {contacts.whatsappNumber && (
              <div class="edit-whatsapp-envelope">
                <span class="edit-direct-label">COMUNICACIÓN INMEDIATA</span>
                <WhatsAppButton phone={contacts.whatsappNumber} message={contacts.whatsappMessage} size="lg" label="Escribir por WhatsApp" />
              </div>
            )}
          </div>
        </div>
      </div>
    </section>
  )}

  {/* Colophon Footer */}
  <footer class="edit-footer">
    <div class="edit-container edit-footer-wrap">
      <span>© {new Date().getFullYear()} {siteName}. Todos los derechos reservados.</span>
      {contacts && (
        <div class="edit-footer-socials">
          {contacts.whatsappNumber && (
            <a
              href={generateWhatsAppUrl(contacts.whatsappNumber, contacts.whatsappMessage)}
              target="_blank"
              rel="noopener noreferrer"
              class="edit-footer-social"
              title="WhatsApp"
              aria-label="WhatsApp"
            >
              <Icon name="whatsapp" size={16} />
            </a>
          )}
          {contacts.instagramHandle && (
            <a
              href={`https://instagram.com/${contacts.instagramHandle.replace(/^@/, "")}`}
              target="_blank"
              rel="noopener noreferrer"
              class="edit-footer-social"
              title="Instagram"
              aria-label="Instagram"
            >
              <Icon name="instagram" size={16} />
            </a>
          )}
          {contacts.facebookUrl && (
            <a
              href={contacts.facebookUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="edit-footer-social"
              title="Facebook"
              aria-label="Facebook"
            >
              <Icon name="facebook" size={16} />
            </a>
          )}
          {contacts.email && (
            <a
              href={`mailto:${contacts.email}`}
              class="edit-footer-social"
              title="Correo"
              aria-label="Correo"
            >
              <Icon name="email" size={16} />
            </a>
          )}
        </div>
      )}
      <span>DISEÑO EDITORIAL TIPOGRÁFICO</span>
    </div>
  </footer>
</div>

<style>
  .template-editorial {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    font-family: var(--ds-font-inter, sans-serif);
    background-color: var(--ds-color-background, #0f172a);
    color: var(--ds-color-text, #f8fafc);
  }

  .edit-container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--ds-space-6, 1.5rem);
    box-sizing: border-box;
  }

  .edit-masthead {
    border-bottom: 1px solid var(--ds-color-border, rgba(255, 255, 255, 0.1));
    padding: var(--ds-space-4, 1rem) 0;
  }

  .edit-masthead-wrap {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--ds-space-2, 0.5rem);
  }

  .edit-issue-tag, .edit-colophon {
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    color: var(--ds-color-muted, #94a3b8);
    text-transform: uppercase;
  }

  .edit-pub-title {
    font-size: var(--ds-text-lg, 1.125rem);
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .edit-curated-notice {
    background: rgba(255, 255, 255, 0.02);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    overflow: hidden;
    padding: 0.5rem 0;
    white-space: nowrap;
  }

  .edit-curated-track {
    display: flex;
    align-items: center;
    gap: 2.5rem;
    width: max-content;
    animation: editTicker 32s linear infinite;
  }

  .edit-curated-notice:hover .edit-curated-track {
    animation-play-state: paused;
  }

  @keyframes editTicker {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .edit-curated-item {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.8rem;
  }

  .edit-curated-badge {
    background: rgba(255, 255, 255, 0.1);
    color: #f8fafc;
    font-size: 0.68rem;
    font-weight: 700;
    padding: 0.15rem 0.5rem;
    border-radius: 2px;
    letter-spacing: 0.1em;
  }

  .edit-curated-title {
    font-weight: 600;
    color: #e2e8f0;
  }

  .edit-curated-benefit {
    color: var(--ds-color-primary, #60a5fa);
    font-weight: 600;
  }

  .edit-curated-code {
    font-style: italic;
    color: #94a3b8;
  }

  .edit-curated-sep {
    color: #475569;
    font-weight: 300;
  }

  /* Editorial Manifesto Section */
  .edit-manifesto-section {
    padding: 3rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.01);
  }

  .edit-manifesto-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .edit-manifesto-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .edit-manifesto-column {
    border-left: 1px solid rgba(255, 255, 255, 0.12);
    padding-left: 1.5rem;
    transition: border-left-color 0.25s, transform 0.25s;
  }

  .edit-manifesto-column:hover {
    border-left-color: var(--ds-color-primary, #60a5fa);
    transform: translateX(4px);
  }

  .edit-manifesto-num {
    display: block;
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--ds-color-primary, #60a5fa);
    margin-bottom: 0.4rem;
    font-family: serif;
  }

  .edit-manifesto-title {
    font-size: 1.1rem;
    font-weight: 700;
    margin: 0 0 0.4rem 0;
    color: #f8fafc;
  }

  .edit-manifesto-p {
    font-size: 0.85rem;
    color: #94a3b8;
    line-height: 1.6;
    margin: 0;
  }

  .edit-hero-section {
    padding: var(--ds-space-12, 3rem) 0;
    border-bottom: 1px solid var(--ds-color-border, rgba(255, 255, 255, 0.08));
  }

  .edit-hero-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--ds-space-10, 2.5rem);
    align-items: center;
  }

  @media (min-width: 900px) {
    .edit-hero-layout {
      grid-template-columns: 1.4fr 1fr;
    }
  }

  .edit-kicker {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ds-color-primary, #60a5fa);
    display: block;
    margin-bottom: var(--ds-space-3, 0.75rem);
  }

  .edit-headline {
    font-size: var(--ds-text-display, 3.25rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin: 0 0 var(--ds-space-6, 1.5rem) 0;
  }

  .edit-standfirst {
    font-size: var(--ds-text-lg, 1.125rem);
    color: var(--ds-color-muted, #cbd5e1);
    line-height: 1.7;
    margin: 0 0 var(--ds-space-8, 2rem) 0;
    max-width: 620px;
  }

  .edit-actions-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ds-space-4, 1rem);
    align-items: center;
  }

  .edit-hero-aside {
    border-left: 1px solid var(--ds-color-border, rgba(255, 255, 255, 0.15));
    padding-left: var(--ds-space-6, 1.5rem);
  }

  @media (max-width: 899px) {
    .edit-hero-aside {
      border-left: none;
      padding-left: 0;
      border-top: 1px solid var(--ds-color-border, rgba(255, 255, 255, 0.15));
      padding-top: var(--ds-space-6, 1.5rem);
    }
  }

  .edit-pullquote {
    font-size: var(--ds-text-xl, 1.25rem);
    font-style: italic;
    line-height: 1.6;
    color: var(--ds-color-muted, #cbd5e1);
    margin: 0;
  }

  .edit-features-section {
    padding: var(--ds-space-12, 3rem) 0;
  }

  .edit-section-header {
    margin-bottom: var(--ds-space-8, 2rem);
  }

  .edit-section-title {
    font-size: var(--ds-text-2xl, 1.75rem);
    font-weight: 700;
    margin: 0;
    letter-spacing: -0.02em;
  }

  .edit-features-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--ds-space-8, 2rem);
  }

  @media (min-width: 640px) {
    .edit-features-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .edit-features-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .edit-feature-column {
    display: flex;
    gap: var(--ds-space-4, 1rem);
    padding: 1.25rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.3s ease, background 0.3s ease;
  }

  .edit-feature-column:hover {
    transform: translateY(-5px);
    border-color: var(--ds-color-primary, #60a5fa);
    background: rgba(255, 255, 255, 0.04);
  }

  .edit-column-num {
    font-size: var(--ds-text-xl, 1.25rem);
    font-weight: 800;
    color: var(--ds-color-primary, #60a5fa);
    line-height: 1;
  }

  .edit-column-body {
    flex-grow: 1;
  }

  .edit-column-icon-wrap {
    color: var(--ds-color-muted, #94a3b8);
    margin-bottom: var(--ds-space-2, 0.5rem);
  }

  .edit-column-title {
    font-size: var(--ds-text-lg, 1.125rem);
    font-weight: 700;
    margin: 0 0 var(--ds-space-2, 0.5rem) 0;
    letter-spacing: -0.01em;
  }

  .edit-column-text {
    font-size: var(--ds-text-sm, 0.875rem);
    color: var(--ds-color-muted, #94a3b8);
    line-height: 1.6;
    margin: 0 0 var(--ds-space-3, 0.75rem) 0;
  }

  .edit-column-badge {
    margin-bottom: var(--ds-space-3, 0.75rem);
  }

  .edit-column-link {
    display: inline-flex;
    align-items: center;
    gap: var(--ds-space-1, 0.25rem);
    font-size: var(--ds-text-xs, 0.75rem);
    color: var(--ds-color-primary, #60a5fa);
    font-weight: 600;
    text-decoration: none;
  }

  .edit-column-link:hover {
    text-decoration: underline;
  }

  .edit-contact-section {
    padding: var(--ds-space-12, 3rem) 0;
    background: rgba(0, 0, 0, 0.25);
    border-top: 1px solid var(--ds-color-border, rgba(255, 255, 255, 0.08));
    margin-top: auto;
  }

  .edit-contact-spread {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--ds-space-8, 2rem);
    align-items: center;
  }

  @media (min-width: 768px) {
    .edit-contact-spread {
      grid-template-columns: 1.5fr 1fr;
    }
  }

  .edit-contact-title {
    font-size: var(--ds-text-2xl, 1.75rem);
    font-weight: 700;
    margin: 0 0 var(--ds-space-3, 0.75rem) 0;
  }

  .edit-contact-lead {
    color: var(--ds-color-muted, #94a3b8);
    font-size: var(--ds-text-sm, 0.875rem);
    margin: 0 0 var(--ds-space-4, 1rem) 0;
    line-height: 1.6;
  }

  .edit-contact-lines {
    display: flex;
    flex-direction: column;
    gap: var(--ds-space-1, 0.25rem);
    font-size: var(--ds-text-sm, 0.875rem);
  }

  .edit-contact-item a {
    color: var(--ds-color-primary, #60a5fa);
    text-decoration: none;
  }

  .edit-direct-label {
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    color: var(--ds-color-muted, #94a3b8);
    display: block;
    margin-bottom: var(--ds-space-2, 0.5rem);
  }

  .edit-footer {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding: var(--ds-space-6, 1.5rem) 0;
    font-size: 0.75rem;
    color: var(--ds-color-muted, #64748b);
  }

  .edit-footer-wrap {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--ds-space-2, 0.5rem);
  }

  .edit-hero-img-wrap {
    border-radius: var(--ds-theme-radius, 2px);
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .edit-hero-img {
    width: 100%;
    height: 100%;
    max-height: 380px;
    object-fit: cover;
    display: block;
  }

  .edit-header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .edit-header-social {
    color: var(--ds-color-muted, #94a3b8);
    display: inline-flex;
    align-items: center;
    transition: color 0.15s ease, transform 0.15s ease;
  }

  .edit-header-social:hover {
    color: var(--ds-color-primary, #60a5fa);
    transform: translateY(-1px);
  }

  .edit-header-phone {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
