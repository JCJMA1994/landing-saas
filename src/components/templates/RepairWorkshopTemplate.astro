---
import type { SiteTheme } from "../../domain/site/theme";
import type { SiteHero } from "../../domain/site/hero";
import type { SiteCard } from "../../domain/site/card";
import type { SitePromotion } from "../../domain/site/promotion";
import { type SiteContacts, generateWhatsAppUrl } from "../../domain/site/contact";
import { themeToCssVariables, serializeCssVariables } from "../../domain/design-system/tokens";
import Button from "../design-system/Button.astro";
import Badge from "../design-system/Badge.astro";
import Card from "../design-system/Card.astro";
import Icon from "../design-system/Icon.astro";
import WhatsAppButton from "../design-system/WhatsAppButton.astro";

interface Props {
  theme: SiteTheme;
  hero: SiteHero | null;
  cards: SiteCard[];
  promotions: SitePromotion[];
  contacts: SiteContacts | null;
  siteName?: string | undefined;
}

const { theme, hero, cards, promotions, contacts, siteName = "Taller de Reparación" } = Astro.props;
const cssVars = serializeCssVariables(themeToCssVariables(theme));
const activePromotions = promotions.filter((p) => p.isActive);
---

<div class="template-workshop" style={cssVars} data-theme-root>
  {/* Workshop Service Header */}
  <header class="work-header">
    <div class="work-container work-header-flex">
      <div class="work-brand">
        {theme?.logoUrl ? (
          <img src={theme.logoUrl} alt={siteName} class="work-brand-logo" />
        ) : (
          <Icon name="wrench" size={20} />
        )}
        <span class="work-brand-title">{siteName}</span>
      </div>

      <nav class="work-nav" aria-label="Navegación principal">
        <a href="#inicio" class="work-nav-link">Inicio</a>
        <a href="#despiece" class="work-nav-link">Despiece</a>
        <a href="#garantias" class="work-nav-link">Protocolo</a>
        <a href="#servicios" class="work-nav-link">Servicios</a>
        <a href="#contacto" class="work-nav-link">Contacto</a>
      </nav>

      <div class="work-header-actions">
        {contacts?.whatsappNumber && (
          <a
            href={generateWhatsAppUrl(contacts.whatsappNumber, contacts.whatsappMessage)}
            target="_blank"
            rel="noopener noreferrer"
            class="work-header-cta"
            title="WhatsApp"
          >
            <Icon name="whatsapp" size={15} />
            <span>WhatsApp</span>
          </a>
        )}
        {contacts?.instagramHandle && (
          <a
            href={`https://instagram.com/${contacts.instagramHandle.replace(/^@/, "")}`}
            target="_blank"
            rel="noopener noreferrer"
            class="work-header-social"
            title="Instagram"
            aria-label="Instagram"
          >
            <Icon name="instagram" size={16} />
          </a>
        )}
        {contacts?.facebookUrl && (
          <a
            href={contacts.facebookUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="work-header-social"
            title="Facebook"
            aria-label="Facebook"
          >
            <Icon name="facebook" size={16} />
          </a>
        )}
        {contacts?.email && (
          <a
            href={`mailto:${contacts.email}`}
            class="work-header-social"
            title="Correo"
            aria-label="Correo"
          >
            <Icon name="email" size={16} />
          </a>
        )}
        {contacts?.phone && (
          <a href={`tel:${contacts.phone}`} class="work-header-phone" title="Teléfono">
            <Icon name="phone" size={14} />
            <span>{contacts.phone}</span>
          </a>
        )}
      </div>
    </div>
  </header>

  {/* Active Promotion Carousel Ticker */}
  {activePromotions.length > 0 && (
    <aside class="work-voucher-ribbon" aria-label="Cupones y Promociones Activas">
      <div class="work-promo-track">
        {Array.from({ length: 4 }).flatMap(() => activePromotions).map((promo) => (
          <div class="work-promo-item">
            <span class="work-promo-badge">CUPÓN DE TALLER</span>
            <span class="work-promo-title">{promo.title}</span>
            {promo.discountLabel && (
              <span class="work-promo-discount">{promo.discountLabel}</span>
            )}
            {promo.couponCode && (
              <code class="work-promo-code">CÓDIGO: {promo.couponCode}</code>
            )}
            <span class="work-promo-sep" aria-hidden="true">✦</span>
          </div>
        ))}
      </div>
    </aside>
  )}

  {/* Hero: Workbench Intake Sheet */}
  {hero && (
    <section id="inicio" class="work-intake-section">
      <div class="work-container">
        <div class="work-intake-card">
          <div class="work-intake-grid">
            <div class="work-intake-copy">
              <span class="work-intake-label">{hero.badgeText || "SERVICIO ESPECIALIZADO Y DIAGNÓSTICO"}</span>
              <h1 class="work-intake-title">{hero.headline}</h1>
              {hero.subheadline && <p class="work-intake-subtitle">{hero.subheadline}</p>}

              <div class="work-intake-actions">
                {hero.ctaText && hero.ctaLink && (
                  <Button href={hero.ctaLink} variant="solid" size="lg">
                    {hero.ctaText}
                  </Button>
                )}
                {contacts?.whatsappNumber && (
                  <WhatsAppButton phone={contacts.whatsappNumber} message={contacts.whatsappMessage} size="lg" />
                )}
              </div>
            </div>

            <div class="work-intake-media">
              {hero.imageUrl ? (
                <div class="work-hero-img-wrap">
                  <img src={hero.imageUrl} alt={hero.headline} class="work-hero-img" />
                </div>
              ) : (
                <div class="work-bench-specs">
                  <div class="work-spec-item">
                    <span class="work-spec-key">BANCO:</span>
                    <span class="work-spec-val">#04 - CERTIFICADO</span>
                  </div>
                  <div class="work-spec-item">
                    <span class="work-spec-key">PROTOCOLO:</span>
                    <span class="work-spec-val">INSPECCIÓN DINÁMICA</span>
                  </div>
                  <div class="work-spec-item">
                    <span class="work-spec-key">REPUESTOS:</span>
                    <span class="work-spec-val">ORIGINALES / TRAZADOS</span>
                  </div>
                </div>
              )}
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  {/* Technical Blueprint & Component Callouts (Soluciones Modulares Style) */}
  <section id="despiece" class="work-blueprint-section" aria-label="Despiece técnico y componentes">
    <div class="work-container">
      <div class="work-blueprint-header">
        <span class="work-blueprint-tag">DESPIECE Y ARQUITECTURA DE HARDWARE</span>
        <h2 class="work-blueprint-title">Intervención Especializada por Componente</h2>
        <p class="work-blueprint-desc">Identificación de puntos críticos con peritaje bajo microscopio y reemplazo homologado.</p>
      </div>

      <div class="work-blueprint-stage">
        <div class="work-blueprint-canvas">
          <div class="work-blueprint-grid-overlay"></div>
          
          {/* Central Technical Diagram */}
          <div class="work-blueprint-schematic">
            <div class="work-schematic-chassis">
              <div class="work-schematic-core">
                <Icon name="cpu" size={48} />
                <span class="work-schematic-label">PLACA PRINCIPAL & CHIPSET BGA</span>
              </div>
            </div>
          </div>

          {/* Hotspot Callouts */}
          <div class="work-blueprint-callouts">
            <div class="work-callout-node">
              <div class="work-node-pointer">
                <span class="work-node-ring"></span>
                <span class="work-node-dot">01</span>
              </div>
              <div class="work-node-card">
                <span class="work-node-category">ALIMENTACIÓN</span>
                <h4 class="work-node-title">Líneas de Carga & Batería</h4>
                <p class="work-node-text">Medición de consumo en mA y calibración de celdas genuinas.</p>
              </div>
            </div>

            <div class="work-callout-node">
              <div class="work-node-pointer">
                <span class="work-node-ring"></span>
                <span class="work-node-dot">02</span>
              </div>
              <div class="work-node-card">
                <span class="work-node-category">MICROELECTRÓNICA</span>
                <h4 class="work-node-title">Reballing & Soldadura SMD</h4>
                <p class="work-node-text">Reconstrucción de pistas y sustitución de circuitos integrados.</p>
              </div>
            </div>

            <div class="work-callout-node">
              <div class="work-node-pointer">
                <span class="work-node-ring"></span>
                <span class="work-node-dot">03</span>
              </div>
              <div class="work-node-card">
                <span class="work-node-category">DISIPACIÓN TÉRMICA</span>
                <h4 class="work-node-title">Conductividad & Coolers</h4>
                <p class="work-node-text">Thermal pads de alta densidad y limpieza de cámaras de vapor.</p>
              </div>
            </div>

            <div class="work-callout-node">
              <div class="work-node-pointer">
                <span class="work-node-ring"></span>
                <span class="work-node-dot">04</span>
              </div>
              <div class="work-node-card">
                <span class="work-node-category">INTERFACES Y BUSES</span>
                <h4 class="work-node-title">Puertos & Conectores Blindados</h4>
                <p class="work-node-text">Pruebas de osciloscopio sobre señales de alta transferencia.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Workshop Operational Protocol & Guarantees */}
  <section id="garantias" class="work-protocol-ribbon" aria-label="Compromisos y Garantías de Taller">
    <div class="work-container work-protocol-grid">
      <div class="work-protocol-box">
        <div class="work-protocol-icon">
          <Icon name="shield" size={24} />
        </div>
        <div>
          <strong class="work-protocol-heading">Repuestos 100% Genuinos</strong>
          <p class="work-protocol-text">Trazabilidad oficial de fabricante y componentes homologados de alta durabilidad.</p>
        </div>
      </div>
      <div class="work-protocol-box">
        <div class="work-protocol-icon">
          <Icon name="bolt" size={24} />
        </div>
        <div>
          <strong class="work-protocol-heading">Diagnóstico en 24 Horas</strong>
          <p class="work-protocol-text">Evaluación computarizada protocolizada con informe detallado de fallas.</p>
        </div>
      </div>
      <div class="work-protocol-box">
        <div class="work-protocol-icon">
          <Icon name="check" size={24} />
        </div>
        <div>
          <strong class="work-protocol-heading">Garantía Certificada</strong>
          <p class="work-protocol-text">Respaldo total sobre mano de obra especializada e intervenciones electrónicas.</p>
        </div>
      </div>
    </div>
  </section>

  {/* Workshop Step-by-Step Workflow */}
  <section class="work-stages-section" aria-label="Etapas de servicio en taller">
    <div class="work-container">
      <div class="work-stages-header">
        <span class="work-blueprint-tag">PROTOCOLO DE ATENCIÓN</span>
        <h3 class="work-stages-title">Flujo de Peritaje e Intervención en 4 Fases</h3>
      </div>
      <div class="work-stages-grid">
        <div class="work-stage-item">
          <span class="work-stage-num">FASE 01</span>
          <h4 class="work-stage-name">Ingreso & Peritaje</h4>
          <p class="work-stage-desc">Recepción fotográfica del equipo y orden de trabajo digitalizada con número de seguimiento.</p>
        </div>
        <div class="work-stage-item">
          <span class="work-stage-num">FASE 02</span>
          <h4 class="work-stage-name">Aislación ESD</h4>
          <p class="work-stage-desc">Desarme en banco con protección antiestática certificada y ordenamiento milimétrico.</p>
        </div>
        <div class="work-stage-item">
          <span class="work-stage-num">FASE 03</span>
          <h4 class="work-stage-name">Reparación de Precisión</h4>
          <p class="work-stage-desc">Sustitución de piezas originales con registro térmico y mediciones con osciloscopio.</p>
        </div>
        <div class="work-stage-item">
          <span class="work-stage-num">FASE 04</span>
          <h4 class="work-stage-name">Test de Estrés & Salida</h4>
          <p class="work-stage-desc">Ciclo continuo de 4 horas bajo carga máxima antes de emitir la garantía escrita.</p>
        </div>
      </div>
    </div>
  </section>

  {/* Cards: Workshop Modular Services */}
  {cards.length > 0 && (
    <section id="servicios" class="work-services-section">
      <div class="work-container">
        <div class="work-section-title-wrap">
          <h2 class="work-section-title">Especialidades y Procedimientos de Taller</h2>
          <p class="work-section-sub">Procedimientos protocolizados con repuestos originales y trazabilidad completa.</p>
        </div>

        <div class="work-cards-grid">
          {cards.map((card, index) => (
            <Card variant="bordered" class="work-card-piece">
              <div class="work-piece-id">
                <span class="work-part-no">PARTE #{String(index + 101).padStart(3, "0")}</span>
                <Icon name={(card.iconKey as any) || "wrench"} size={22} />
              </div>
              <h3 class="work-piece-title">{card.title}</h3>
              {card.description && <p class="work-piece-desc">{card.description}</p>}
              {card.badge && (
                <div class="work-piece-badge-wrap">
                  <Badge variant="neutral" size="sm">{card.badge}</Badge>
                </div>
              )}
              {card.linkUrl && (
                <div class="work-piece-action">
                  <a href={card.linkUrl} class="work-piece-link">
                    <span>Ver detalles del procedimiento</span>
                    <Icon name="external" size={14} />
                  </a>
                </div>
              )}
            </Card>
          ))}
        </div>
      </div>
    </section>
  )}

  {/* Contacts: Workshop Direct Intake */}
  {contacts && (
    <section id="contacto" class="work-contact-section">
      <div class="work-container">
        <div class="work-contact-box">
          <div class="work-contact-text">
            <h2 class="work-contact-title">Recepción de Equipos y Consultas</h2>
            <p class="work-contact-desc">Traiga su equipo a nuestro taller o coordine la evaluación técnica por mensajería.</p>
            
            <div class="work-contact-details">
              {contacts.phone && (
                <div class="work-contact-row">
                  <Icon name="phone" size={16} />
                  <span>Teléfono del taller: {contacts.phone}</span>
                </div>
              )}
              {contacts.email && (
                <div class="work-contact-row">
                  <Icon name="email" size={16} />
                  <span>Correo: {contacts.email}</span>
                </div>
              )}
              {contacts.instagramHandle && (
                <div class="work-contact-row">
                  <Icon name="instagram" size={16} />
                  <a href={`https://instagram.com/${contacts.instagramHandle.replace(/^@/, "")}`} target="_blank" rel="noopener noreferrer">
                    @{contacts.instagramHandle.replace(/^@/, "")}
                  </a>
                </div>
              )}
              {contacts.facebookUrl && (
                <div class="work-contact-row">
                  <Icon name="facebook" size={16} />
                  <a href={contacts.facebookUrl} target="_blank" rel="noopener noreferrer">
                    Facebook Oficial
                  </a>
                </div>
              )}
            </div>
          </div>

          <div class="work-contact-action">
            {contacts.whatsappNumber && (
              <WhatsAppButton phone={contacts.whatsappNumber} message={contacts.whatsappMessage} size="lg" label="Hablar con el técnico por WhatsApp" />
            )}
          </div>
        </div>
      </div>
    </section>
  )}

  {/* Footer */}
  <footer class="work-footer">
    <div class="work-container">
      <div class="work-footer-grid">
        <div class="work-footer-brand-col">
          <div class="work-footer-brand">
            {theme?.logoUrl ? (
              <img src={theme.logoUrl} alt={siteName} class="work-footer-logo" />
            ) : (
              <Icon name="wrench" size={20} />
            )}
            <span class="work-footer-title">{siteName}</span>
          </div>
          <p class="work-footer-desc">Taller y servicio técnico especializado. Diagnóstico preciso, repuestos trazables y garantía escrita.</p>
        </div>

        <div class="work-footer-nav-col">
          <span class="work-footer-heading">SECCIONES</span>
          <nav class="work-footer-nav" aria-label="Navegación pie de página">
            <a href="#inicio" class="work-footer-link">Inicio</a>
            <a href="#despiece" class="work-footer-link">Despiece</a>
            <a href="#garantias" class="work-footer-link">Protocolo</a>
            <a href="#servicios" class="work-footer-link">Servicios</a>
            <a href="#contacto" class="work-footer-link">Contacto</a>
          </nav>
        </div>

        {contacts && (
          <div class="work-footer-contact-col">
            <span class="work-footer-heading">ATENCIÓN DIRECTA</span>
            <div class="work-footer-contact-list">
              {contacts.phone && (
                <a href={`tel:${contacts.phone}`} class="work-footer-contact-link">
                  <Icon name="phone" size={14} />
                  <span>{contacts.phone}</span>
                </a>
              )}
              {contacts.email && (
                <a href={`mailto:${contacts.email}`} class="work-footer-contact-link">
                  <Icon name="email" size={14} />
                  <span>{contacts.email}</span>
                </a>
              )}
            </div>
            <div class="work-footer-socials">
              {contacts.whatsappNumber && (
                <a
                  href={generateWhatsAppUrl(contacts.whatsappNumber, contacts.whatsappMessage)}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="work-footer-social"
                  title="WhatsApp"
                  aria-label="WhatsApp"
                >
                  <Icon name="whatsapp" size={16} />
                </a>
              )}
              {contacts.instagramHandle && (
                <a
                  href={`https://instagram.com/${contacts.instagramHandle.replace(/^@/, "")}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="work-footer-social"
                  title="Instagram"
                  aria-label="Instagram"
                >
                  <Icon name="instagram" size={16} />
                </a>
              )}
              {contacts.facebookUrl && (
                <a
                  href={contacts.facebookUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="work-footer-social"
                  title="Facebook"
                  aria-label="Facebook"
                >
                  <Icon name="facebook" size={16} />
                </a>
              )}
            </div>
          </div>
        )}
      </div>

      <div class="work-footer-bottom">
        <span>© {new Date().getFullYear()} {siteName}. Todos los derechos reservados.</span>
      </div>
    </div>
  </footer>
</div>

<style>
  .template-workshop {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    font-family: var(--ds-theme-font, sans-serif);
    background-color: var(--ds-color-background, #12141a);
    color: var(--ds-color-text, #f1f5f9);
    border-top: 4px solid var(--ds-color-accent, #f59e0b);
  }

  .work-container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--ds-space-4, 1rem);
    box-sizing: border-box;
  }

  .work-header {
    background: rgba(0, 0, 0, 0.35);
    border-bottom: 2px solid rgba(255, 255, 255, 0.08);
    padding: var(--ds-space-3, 0.75rem) 0;
  }

  .work-header-flex {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--ds-space-3, 0.75rem);
  }

  .work-brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--ds-color-accent, #f59e0b);
  }

  .work-brand-logo {
    height: 28px;
    width: auto;
    object-fit: contain;
    max-width: 140px;
    border-radius: 4px;
  }

  .work-brand-title {
    font-weight: 700;
    font-size: 0.95rem;
    color: #ffffff;
    letter-spacing: 0.02em;
  }

  .work-nav {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  @media (max-width: 640px) {
    .work-nav {
      gap: 0.75rem;
    }
  }

  .work-nav-link {
    color: var(--ds-color-muted, #94a3b8);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 600;
    transition: color 0.15s ease;
  }

  .work-nav-link:hover {
    color: var(--ds-color-accent, #f59e0b);
  }

  .work-header-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: rgba(245, 158, 11, 0.15);
    border: 1px solid rgba(245, 158, 11, 0.4);
    color: var(--ds-color-accent, #f59e0b);
    padding: 0.25rem 0.65rem;
    border-radius: 4px;
    text-decoration: none;
    font-size: 0.75rem;
    font-weight: 700;
    transition: all 0.15s ease;
  }

  .work-header-cta:hover {
    background: var(--ds-color-accent, #f59e0b);
    color: #000000;
  }

  .work-voucher-ribbon {
    background: rgba(245, 158, 11, 0.12);
    border-bottom: 1px solid rgba(245, 158, 11, 0.3);
    overflow: hidden;
    padding: 0.65rem 0;
    white-space: nowrap;
  }

  .work-promo-track {
    display: flex;
    align-items: center;
    gap: 5rem;
    width: max-content;
    animation: workTicker 65s linear infinite;
  }

  .work-voucher-ribbon:hover .work-promo-track {
    animation-play-state: paused;
  }

  @keyframes workTicker {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .work-promo-item {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    font-size: 0.85rem;
  }

  .work-promo-badge {
    background: #e5a93c;
    color: #1c1103;
    font-size: 0.7rem;
    font-weight: 800;
    padding: 0.15rem 0.5rem;
    border-radius: 3px;
    letter-spacing: 0.05em;
  }

  .work-promo-title {
    font-weight: 600;
  }

  .work-promo-discount {
    color: var(--ds-color-accent, #f59e0b);
    font-weight: 700;
  }

  .work-promo-code {
    background: rgba(0, 0, 0, 0.6);
    color: #ffd57a;
    padding: 0.15rem 0.5rem;
    border-radius: 3px;
    border: 1px solid rgba(245, 158, 11, 0.4);
    font-weight: 700;
  }

  .work-promo-sep {
    color: rgba(245, 158, 11, 0.5);
    margin-left: 0.5rem;
  }

  .work-protocol-ribbon {
    padding: 2.5rem 0 1.5rem;
    background: rgba(15, 23, 42, 0.4);
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .work-protocol-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .work-protocol-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

