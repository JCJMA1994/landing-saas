---
import type { SiteTheme } from "../../domain/site/theme";
import type { SiteHero } from "../../domain/site/hero";
import type { SiteCard } from "../../domain/site/card";
import type { SitePromotion } from "../../domain/site/promotion";
import { type SiteContacts, generateWhatsAppUrl } from "../../domain/site/contact";
import { themeToCssVariables, serializeCssVariables } from "../../domain/design-system/tokens";
import Button from "../design-system/Button.astro";
import Badge from "../design-system/Badge.astro";
import Card from "../design-system/Card.astro";
import Icon from "../design-system/Icon.astro";
import WhatsAppButton from "../design-system/WhatsAppButton.astro";

interface Props {
  theme: SiteTheme;
  hero: SiteHero | null;
  cards: SiteCard[];
  promotions: SitePromotion[];
  contacts: SiteContacts | null;
  siteName?: string | undefined;
}

const { theme, hero, cards, promotions, contacts, siteName = "Cyber Performance" } = Astro.props;
const cssVars = serializeCssVariables(themeToCssVariables(theme));
const activePromotions = promotions.filter((p) => p.isActive);
---

<div class="template-cyber" style={cssVars} data-theme-root>
  {/* Cyber Telemetry Top Bar */}
  <header class="cyber-header">
    <div class="cyber-container cyber-header-content">
      <div class="cyber-brand">
        {theme?.logoUrl ? (
          <img src={theme.logoUrl} alt={siteName} class="cyber-brand-logo" />
        ) : (
          <span class="cyber-neon-flash">⚡</span>
        )}
        <span class="cyber-brand-title">{siteName}</span>
      </div>

      <nav class="cyber-nav" aria-label="Navegación principal">
        <a href="#inicio" class="cyber-nav-link">Inicio</a>
        <a href="#rendimiento" class="cyber-nav-link">Rendimiento</a>
        <a href="#servicios" class="cyber-nav-link">Servicios</a>
        <a href="#contacto" class="cyber-nav-link">Contacto</a>
      </nav>

      <div class="cyber-header-actions">
        {contacts?.whatsappNumber && (
          <a
            href={generateWhatsAppUrl(contacts.whatsappNumber, contacts.whatsappMessage)}
            target="_blank"
            rel="noopener noreferrer"
            class="cyber-header-cta"
            title="WhatsApp"
          >
            <Icon name="whatsapp" size={14} />
            <span>WhatsApp</span>
          </a>
        )}
        {contacts?.instagramHandle && (
          <a
            href={`https://instagram.com/${contacts.instagramHandle.replace(/^@/, "")}`}
            target="_blank"
            rel="noopener noreferrer"
            class="cyber-header-social"
            title="Instagram"
            aria-label="Instagram"
          >
            <Icon name="instagram" size={15} />
          </a>
        )}
        {contacts?.facebookUrl && (
          <a
            href={contacts.facebookUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="cyber-header-social"
            title="Facebook"
            aria-label="Facebook"
          >
            <Icon name="facebook" size={15} />
          </a>
        )}
        {contacts?.email && (
          <a
            href={`mailto:${contacts.email}`}
            class="cyber-header-social"
            title="Correo"
            aria-label="Correo"
          >
            <Icon name="email" size={15} />
          </a>
        )}
        {contacts?.phone && (
          <a href={`tel:${contacts.phone}`} class="cyber-header-phone" title="Teléfono">
            <Icon name="phone" size={13} />
            <span>{contacts.phone}</span>
          </a>
        )}
      </div>
    </div>
  </header>

  {/* Active Promotion: Kinetic Turbo Ticker */}
  {activePromotions.length > 0 && (
    <aside class="cyber-boost-bar" aria-label="Aceleraciones y Promociones">
      <div class="cyber-boost-track">
        {Array.from({ length: 4 }).flatMap(() => activePromotions).map((promo) => (
          <div class="cyber-boost-item">
            <span class="cyber-boost-badge">TURBO BOOST // ON</span>
            <span class="cyber-boost-title">{promo.title}</span>
            {promo.discountLabel && (
              <span class="cyber-boost-discount">[{promo.discountLabel}]</span>
            )}
            {promo.couponCode && (
              <code class="cyber-boost-code">CÓDIGO: {promo.couponCode}</code>
            )}
            <span class="cyber-boost-sep" aria-hidden="true">⚡</span>
          </div>
        ))}
      </div>
    </aside>
  )}

  {/* Hero: High Kinetic Cyber Chamber */}
  {hero && (
    <section id="inicio" class="cyber-hero-section">
      <div class="cyber-container cyber-hero-grid">
        <div class="cyber-hero-copy">
          <div class="cyber-lane-tag">
            <span class="cyber-slash">//</span>
            <span>{hero.badgeText || "COMPUTACIÓN DE ALTO RENDIMIENTO"}</span>
          </div>
          <h1 class="cyber-hero-title">{hero.headline}</h1>
          {hero.subheadline && <p class="cyber-hero-subtitle">{hero.subheadline}</p>}

          <div class="cyber-hero-actions">
            {hero.ctaText && hero.ctaLink && (
              <Button href={hero.ctaLink} variant="gradient" size="lg" class="cyber-btn-cut">
                {hero.ctaText}
              </Button>
            )}
            {contacts?.whatsappNumber && (
              <WhatsAppButton phone={contacts.whatsappNumber} message={contacts.whatsappMessage} size="lg" class="cyber-btn-cut" />
            )}
          </div>
        </div>

        <div class="cyber-hero-media">
          <div class="cyber-media-bevel">
            {hero.imageUrl ? (
              <div class="cyber-hero-img-wrap">
                <img src={hero.imageUrl} alt={hero.headline} class="cyber-hero-img" />
              </div>
            ) : (
              <div class="cyber-overclock-hud">
                <span class="cyber-hud-chip">VELOCIDAD DE NÚCLEO: MÁX</span>
                <div class="cyber-core-bars">
                  <span class="cyber-bar bar-1"></span>
                  <span class="cyber-bar bar-2"></span>
                  <span class="cyber-bar bar-3"></span>
                  <span class="cyber-bar bar-4"></span>
                </div>
                <span class="cyber-status-text">OVERCLOCK ESTABLE APLICADO</span>
              </div>
            )}
            <div class="cyber-glow-edge" aria-hidden="true"></div>
          </div>
        </div>
      </div>
    </section>
  )}

  {/* High-Octane Performance Stats Bar */}
  <section id="rendimiento" class="cyber-stats-bar" aria-label="Métricas de Rendimiento Extremo">
    <div class="cyber-container">
      <div class="cyber-stats-grid">
        <div class="cyber-stat-node">
          <span class="cyber-stat-indicator">SPEED // 01</span>
          <strong class="cyber-stat-val">+45% Overclock</strong>
          <span class="cyber-stat-lbl">Aceleración cinemática sostenida</span>
        </div>
        <div class="cyber-stat-node">
          <span class="cyber-stat-indicator">THERMAL // 02</span>
          <strong class="cyber-stat-val">Disipación Fría</strong>
          <span class="cyber-stat-lbl">Control térmico de grado industrial</span>
        </div>
        <div class="cyber-stat-node">
          <span class="cyber-stat-indicator">LATENCY // 03</span>
          <strong class="cyber-stat-val">&lt; 0.8ms</strong>
          <span class="cyber-stat-lbl">Respuesta táctil instantánea</span>
        </div>
      </div>
    </div>
  </section>

  {/* Cards: Overclocked Performance Matrix */}
  {cards.length > 0 && (
    <section id="servicios" class="cyber-cards-section">
      <div class="cyber-container">
        <div class="cyber-section-header">
          <span class="cyber-lane-tag">// MÓDULOS DE RENDIMIENTO</span>
          <h2 class="cyber-section-title">Aceleración y Arquitectura de Poder</h2>
        </div>

        <div class="cyber-cards-grid">
          {cards.map((card, idx) => (
            <Card variant="glass" class="cyber-card-module">
              <div class="cyber-card-top">
                <span class="cyber-core-id">NÚCLEO_{String(idx + 1).padStart(2, "0")}</span>
                <Icon name={(card.iconKey as any) || "bolt"} size={22} />
              </div>
              <h3 class="cyber-card-title">{card.title}</h3>
              {card.description && <p class="cyber-card-desc">{card.description}</p>}
              {card.badge && (
                <div class="cyber-card-badge">
                  <Badge variant="accent" size="sm">{card.badge}</Badge>
                </div>
              )}
              {card.linkUrl && (
                <div class="cyber-card-action">
                  <a href={card.linkUrl} class="cyber-card-link">
                    <span>Desplegar benchmark</span>
                    <Icon name="external" size={14} />
                  </a>
                </div>
              )}
            </Card>
          ))}
        </div>
      </div>
    </section>
  )}

  {/* Contacts: Kinetic Dispatch */}
  {contacts && (
    <section id="contacto" class="cyber-contact-section">
      <div class="cyber-container">
        <div class="cyber-contact-box">
          <div class="cyber-contact-info">
            <span class="cyber-lane-tag">// ENLACE DIRECTO</span>
            <h2 class="cyber-contact-title">Conexión de Baja Latencia</h2>
            <p class="cyber-contact-desc">Soporte directo para hardware extremo, configuraciones personalizadas y proyectos de alto calibre.</p>

            <div class="cyber-contact-chips">
              {contacts.phone && (
                <div class="cyber-chip">
                  <Icon name="phone" size={16} />
                  <span>{contacts.phone}</span>
                </div>
              )}
              {contacts.email && (
                <div class="cyber-chip">
                  <Icon name="email" size={16} />
                  <span>{contacts.email}</span>
                </div>
              )}
              {contacts.instagramHandle && (
                <div class="cyber-chip">
                  <Icon name="instagram" size={16} />
                  <a href={`https://instagram.com/${contacts.instagramHandle.replace(/^@/, "")}`} target="_blank" rel="noopener noreferrer">
                    @{contacts.instagramHandle.replace(/^@/, "")}
                  </a>
                </div>
              )}
              {contacts.facebookUrl && (
                <div class="cyber-chip">
                  <Icon name="facebook" size={16} />
                  <a href={contacts.facebookUrl} target="_blank" rel="noopener noreferrer">
                    Facebook Oficial
                  </a>
                </div>
              )}
            </div>
          </div>

          <div class="cyber-contact-btn-wrap">
            {contacts.whatsappNumber && (
              <WhatsAppButton phone={contacts.whatsappNumber} message={contacts.whatsappMessage} size="lg" label="Iniciar chat WhatsApp directo" class="cyber-btn-cut" />
            )}
          </div>
        </div>
      </div>
    </section>
  )}

  {/* Footer */}
  <footer class="cyber-footer">
    <div class="cyber-container">
      <div class="cyber-footer-grid">
        <div class="cyber-footer-brand-col">
          <div class="cyber-footer-brand">
            {theme?.logoUrl ? (
              <img src={theme.logoUrl} alt={siteName} class="cyber-footer-logo" />
            ) : (
              <span class="cyber-neon-flash">⚡</span>
            )}
            <span class="cyber-footer-title">{siteName}</span>
          </div>
          <p class="cyber-footer-desc">Arquitectura cinética de máximo desempeño, optimización de hardware y soporte de alto rendimiento.</p>
        </div>

        <div class="cyber-footer-nav-col">
          <span class="cyber-footer-heading">SECCIONES</span>
          <nav class="cyber-footer-nav" aria-label="Navegación pie de página">
            <a href="#inicio" class="cyber-footer-link">Inicio</a>
            <a href="#rendimiento" class="cyber-footer-link">Rendimiento</a>
            <a href="#servicios" class="cyber-footer-link">Servicios</a>
            <a href="#contacto" class="cyber-footer-link">Contacto</a>
          </nav>
        </div>

        {contacts && (
          <div class="cyber-footer-contact-col">
            <span class="cyber-footer-heading">CONEXIÓN DIRECTA</span>
            <div class="cyber-footer-contact-list">
              {contacts.phone && (
                <a href={`tel:${contacts.phone}`} class="cyber-footer-contact-link">
                  <Icon name="phone" size={14} />
                  <span>{contacts.phone}</span>
                </a>
              )}
              {contacts.email && (
                <a href={`mailto:${contacts.email}`} class="cyber-footer-contact-link">
                  <Icon name="email" size={14} />
                  <span>{contacts.email}</span>
                </a>
              )}
            </div>
            <div class="cyber-footer-socials">
              {contacts.whatsappNumber && (
                <a
                  href={generateWhatsAppUrl(contacts.whatsappNumber, contacts.whatsappMessage)}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="cyber-footer-social"
                  title="WhatsApp"
                  aria-label="WhatsApp"
                >
                  <Icon name="whatsapp" size={15} />
                </a>
              )}
              {contacts.instagramHandle && (
                <a
                  href={`https://instagram.com/${contacts.instagramHandle.replace(/^@/, "")}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="cyber-footer-social"
                  title="Instagram"
                  aria-label="Instagram"
                >
                  <Icon name="instagram" size={15} />
                </a>
              )}
              {contacts.facebookUrl && (
                <a
                  href={contacts.facebookUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="cyber-footer-social"
                  title="Facebook"
                  aria-label="Facebook"
                >
                  <Icon name="facebook" size={15} />
                </a>
              )}
            </div>
          </div>
        )}
      </div>

      <div class="cyber-footer-bottom">
        <span>© {new Date().getFullYear()} {siteName}. Todos los derechos reservados.</span>
      </div>
    </div>
  </footer>
</div>

<style>
  .template-cyber {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    font-family: var(--ds-font-space-grotesk, sans-serif);
    background-color: var(--ds-color-background, #05050c);
    color: var(--ds-color-text, #f8fafc);
    border-top: 3px solid #ec4899;
  }

  .cyber-container {
    width: 100%;
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 var(--ds-space-4, 1rem);
    box-sizing: border-box;
  }

  .cyber-header {
    background: #000;
    border-bottom: 1px solid rgba(236, 72, 153, 0.3);
    padding: var(--ds-space-2, 0.5rem) 0;
    font-size: var(--ds-text-xs, 0.75rem);
    font-family: var(--ds-font-mono);
  }

  .cyber-header-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--ds-space-3, 0.75rem);
  }

  .cyber-brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .cyber-brand-logo {
    height: 26px;
    width: auto;
    object-fit: contain;
    max-width: 130px;
    border-radius: 3px;
  }

  .cyber-brand-title {
    font-weight: 800;
    color: #ffffff;
  }

  .cyber-nav {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  @media (max-width: 640px) {
    .cyber-nav {
      gap: 0.75rem;
    }
  }

  .cyber-nav-link {
    color: var(--ds-color-muted, #94a3b8);
    text-decoration: none;
    font-size: 0.8rem;
    font-weight: 600;
    transition: color 0.15s ease;
  }

  .cyber-nav-link:hover {
    color: #ec4899;
  }

  .cyber-header-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: rgba(236, 72, 153, 0.15);
    border: 1px solid rgba(236, 72, 153, 0.4);
    color: #ec4899;
    padding: 0.25rem 0.65rem;
    border-radius: 3px;
    text-decoration: none;
    font-size: 0.75rem;
    font-weight: 700;
    transition: all 0.15s ease;
  }

  .cyber-header-cta:hover {
    background: #ec4899;
    color: #ffffff;
  }

  .cyber-thermal {
    color: var(--ds-color-muted, #94a3b8);
    font-size: 0.7rem;
  }

  .cyber-boost-bar {
    background: linear-gradient(90deg, rgba(236, 72, 153, 0.15), rgba(59, 130, 246, 0.15));
    border-bottom: 1px solid rgba(236, 72, 153, 0.35);
    overflow: hidden;
    padding: 0.65rem 0;
    white-space: nowrap;
    font-family: var(--ds-font-mono);
  }

  .cyber-boost-track {
    display: flex;
    align-items: center;
    gap: 5rem;
    width: max-content;
    animation: cyberTicker 65s linear infinite;
  }

  .cyber-boost-bar:hover .cyber-boost-track {
    animation-play-state: paused;
  }

  @keyframes cyberTicker {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .cyber-boost-item {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    font-size: 0.85rem;
  }

  .cyber-boost-badge {
    background: #ec4899;
    color: #ffffff;
    font-size: 0.68rem;
    font-weight: 800;
    padding: 0.15rem 0.5rem;
    border-radius: 2px;
    letter-spacing: 0.05em;
  }

  .cyber-boost-title {
    color: #f8fafc;
    font-weight: 600;
  }

  .cyber-boost-discount {
    color: #38bdf8;
    font-weight: 700;
  }

  .cyber-boost-code {
    background: #020617;
    color: #f472b6;
    padding: 0.15rem 0.5rem;
    border-radius: 2px;
    border: 1px solid rgba(236, 72, 153, 0.5);
    font-weight: 700;
  }

  .cyber-boost-sep {
    color: #ec4899;
    font-size: 0.75rem;
  }

  /* High-Octane Performance Stats Bar */
  .cyber-stats-bar {
    padding: 2.5rem 0 1.5rem;
    background: rgba(10, 5, 20, 0.6);
    border-top: 1px solid rgba(236, 72, 153, 0.15);
    border-bottom: 1px solid rgba(59, 130, 246, 0.15);
    font-family: var(--ds-font-mono);
  }

  .cyber-stats-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 768px) {
    .cyber-stats-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .cyber-stat-node {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(236, 72, 153, 0.2);
    border-left: 3px solid #ec4899;
    padding: 1.25rem;
    transition: transform 0.25s, border-color 0.25s, box-shadow 0.25s;
  }

  .cyber-stat-node:hover {
    transform: translateY(-3px);
    border-color: #38bdf8;
    border-left-color: #38bdf8;
    box-shadow: 0 0 20px -5px rgba(56, 189, 248, 0.3);
  }

  .cyber-stat-indicator {
    display: block;
    font-size: 0.68rem;
    color: #94a3b8;
    font-weight: 700;
    letter-spacing: 0.08em;
    margin-bottom: 0.3rem;
  }

  .cyber-stat-val {
    display: block;
    font-size: 1.4rem;
    font-weight: 900;
    color: #f8fafc;
    margin-bottom: 0.2rem;
  }

  .cyber-stat-lbl {
    font-size: 0.78rem;
    color: #64748b;
  }

  .cyber-hero-section {
    padding: var(--ds-space-12, 3rem) 0;
    position: relative;
  }

  .cyber-hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--ds-space-8, 2rem);
    align-items: center;
  }

  @media (min-width: 768px) {
    .cyber-hero-grid {
      grid-template-columns: 1.3fr 1fr;
    }
  }

  .cyber-lane-tag {
    font-size: var(--ds-text-xs, 0.75rem);
    font-family: var(--ds-font-mono);
    color: #ec4899;
    font-weight: 700;
    letter-spacing: 0.1em;
    display: block;
    margin-bottom: var(--ds-space-2, 0.5rem);
  }

  .cyber-slash {
    color: #3b82f6;
  }

  .cyber-hero-title {
    font-size: var(--ds-text-4xl, 2.75rem);
    font-weight: 900;
    line-height: 1.1;
    margin: 0 0 var(--ds-space-4, 1rem) 0;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .cyber-hero-subtitle {
    font-size: var(--ds-text-lg, 1.125rem);
    color: var(--ds-color-muted, #94a3b8);
    line-height: 1.6;
    margin: 0 0 var(--ds-space-8, 2rem) 0;
  }

  .cyber-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ds-space-3, 0.75rem);
  }

  .cyber-media-bevel {
    position: relative;
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - 25px), calc(100% - 25px) 100%, 0 100%);
    border: 1px solid #ec4899;
    background: rgba(15, 10, 25, 0.9);
    padding: var(--ds-space-8, 2rem);
    min-height: 220px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .cyber-overclock-hud {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--ds-space-4, 1rem);
    font-family: var(--ds-font-mono);
  }

  .cyber-hud-chip {
    font-size: 0.75rem;
    font-weight: 700;
    color: #ec4899;
    background: rgba(236, 72, 153, 0.15);
    padding: 0.3rem 0.75rem;
    border-radius: 2px;
    border: 1px solid rgba(236, 72, 153, 0.4);
  }

  .cyber-core-bars {
    display: flex;
    gap: 8px;
    height: 40px;
    align-items: flex-end;
  }

  .cyber-bar {
    width: 14px;
    background: #ec4899;
    border-radius: 2px 2px 0 0;
  }
  .bar-1 { height: 90%; background: #3b82f6; }
  .bar-2 { height: 100%; background: #ec4899; }
  .bar-3 { height: 95%; background: #f59e0b; }
  .bar-4 { height: 85%; background: #10b981; }

  .cyber-status-text {
    font-size: 0.7rem;
    color: var(--ds-color-muted, #94a3b8);
  }

  .cyber-glow-edge {
    position: absolute;
    inset: 0;
    border: 2px solid rgba(236, 72, 153, 0.5);
    pointer-events: none;
    box-shadow: inset 0 0 25px rgba(236, 72, 153, 0.3);
  }

  .cyber-cards-section {
    padding: var(--ds-space-12, 3rem) 0;
  }

  .cyber-section-header {
    margin-bottom: var(--ds-space-8, 2rem);
  }

  .cyber-section-title {
    font-size: var(--ds-text-2xl, 1.75rem);
    font-weight: 800;
    margin: 0;
