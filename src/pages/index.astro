---
import { SupabasePublicationRepository } from "../infrastructure/supabase/publication-repository";
import { SupabaseCampaignRepository } from "../infrastructure/supabase/campaign-repository";
import { SupabaseDomainRepository } from "../infrastructure/supabase/domain-repository";
import { resolveSiteCampaignUseCase } from "../application/campaign/manage-campaigns";
import {
  themeToCssVariables,
  serializeCssVariables,
} from "../domain/design-system/tokens";
import TemplateRenderer from "../components/templates/TemplateRenderer.astro";
import SeoHead from "../components/seo/SeoHead.astro";
import ConsentBanner from "../components/seo/ConsentBanner.astro";
import SellerLanding from "../components/marketing/SellerLanding.astro";
import "../styles/tokens.css";

const hostRouting = Astro.locals.hostRouting;

let siteSlug: string | null = null;
if (hostRouting?.kind === "subdomain") {
  siteSlug = hostRouting.slug;
} else if (hostRouting?.kind === "custom_domain") {
  const domainRepo = new SupabaseDomainRepository(Astro.locals.supabase);
  const verifiedDomain = await domainRepo.getVerifiedDomain(hostRouting.domain);
  if (verifiedDomain) {
    const { data: site } = await Astro.locals.supabase
      .from("sites")
      .select("slug")
      .eq("id", verifiedDomain.siteId)
      .maybeSingle();
    siteSlug = site?.slug ?? null;
  }
}

const publicationRepo = new SupabasePublicationRepository(Astro.locals.supabase);
const campaignRepo = new SupabaseCampaignRepository(Astro.locals.supabase);

let snapshot: any = null;
let activeCampaign: any = null;
let pageTitle = "Landing SaaS — Landings de Alta Conversión con Dominios Propios y Panel de Cliente";
let pageDescription =
  "Creamos landings prémium que convierten visitas en clientes para tu negocio. Velocidad en el Edge, dominios propios y panel de control privado autogestionable.";
let serializedStyle = "";

if (siteSlug) {
  const activePublication = await publicationRepo.getActivePublicationBySlug(siteSlug);
  if (!activePublication) {
    Astro.response.status = 404;
    pageTitle = "Sitio no encontrado";
  } else {
    snapshot = activePublication.snapshot;
    activeCampaign = await resolveSiteCampaignUseCase(
      activePublication.siteId,
      new Date(),
      campaignRepo
    );
    const cssVariables = themeToCssVariables(snapshot.theme);
    serializedStyle = serializeCssVariables(cssVariables);
    pageTitle = snapshot.siteName;
    pageDescription = snapshot.hero?.subheadline || `${pageTitle} — Landing Page`;
  }
}

// Otherwise (platform portal), list all published sites
const publishedSites = [];
if (!siteSlug) {
  const { data: sites } = await Astro.locals.supabase
    .from("sites")
    .select("id, name, slug");

  if (sites && sites.length > 0) {
    for (const s of sites) {
      const pub = await publicationRepo.getActivePublication(s.id);
      if (pub) {
        publishedSites.push({
          id: s.id,
          name: s.name,
          slug: s.slug,
          version: pub.version,
          publishedAt: pub.publishedAt,
          templateKey: pub.snapshot.templateKey,
        });
      }
    }
  }
}
---

<!doctype html>
<html lang="es" style={snapshot ? serializedStyle : ""}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {snapshot ? (
      <SeoHead
        snapshot={snapshot}
        host={Astro.request.headers.get("host") || "landingsaas.com"}
        pathname="/"
        customDomain={hostRouting?.kind === "custom_domain" ? hostRouting.domain : undefined}
      />
    ) : (
      <>
        <title>{pageTitle}</title>
        <meta name="description" content={pageDescription} />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Outfit:wght@600;700;800;900&display=swap" rel="stylesheet" />
        {siteSlug ? (
          <meta name="robots" content="noindex, nofollow" />
        ) : (
          <meta name="robots" content="index, follow" />
        )}
      </>
    )}
  </head>
  <body
    style={
      siteSlug
        ? "margin: 0; padding: 0; background: var(--ds-color-background, #0a0f1e); color: var(--ds-color-text, #f5f7ff); font-family: var(--ds-theme-font, Inter, system-ui, sans-serif);"
        : "margin: 0; padding: 0; min-height: 100vh; background: #060a14; color: #f1f5f9; font-family: Inter, system-ui, -apple-system, sans-serif;"
    }
  >
    {siteSlug ? (
      snapshot ? (
        <main>
          <TemplateRenderer
            templateKey={snapshot.templateKey}
            theme={snapshot.theme}
            hero={snapshot.hero}
            cards={snapshot.cards}
            promotions={snapshot.promotions}
            contacts={snapshot.contacts}
            siteName={snapshot.siteName}
            activeCampaign={activeCampaign}
          />
          <ConsentBanner />
        </main>
      ) : (
        <main style="min-height: 100vh; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; padding: 2rem; background: radial-gradient(circle at 50% 30%, #172a55 0, #0a0f1e 70%);">
          <div style="max-width: 32rem; border: 1px solid #293958; border-radius: 1.25rem; padding: 3rem 2rem; background: rgba(17, 26, 46, 0.9); box-shadow: 0 1.5rem 4rem rgba(0, 0, 0, 0.5);">
            <span style="font-size: 0.8rem; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; color: #91b7ff; display: block; margin-bottom: 0.75rem;">
              Landing SaaS
            </span>
            <h1 style="font-size: 2rem; margin: 0 0 1rem; color: #f5f7ff; line-height: 1.2;">
              Sitio en Construcción
            </h1>
            <p style="color: #b8c3dc; font-size: 1rem; line-height: 1.6; margin: 0 0 2rem;">
              El sitio con identificador <strong>"{siteSlug}"</strong> aún no cuenta con una versión publicada activa.
            </p>
          </div>
        </main>
      )
    ) : (
      <SellerLanding publishedSites={publishedSites} />
    )}
  </body>
</html>
