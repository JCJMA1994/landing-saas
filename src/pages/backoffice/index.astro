---
import { actions } from "astro:actions";
import { getPlatformBackofficeOverviewUseCase } from "../../application/saas/manage-subscription";
import { SupabaseSubscriptionRepository } from "../../infrastructure/supabase/subscription-repository";
import { PLAN_IDS } from "../../domain/saas/plan";
import "../../styles/admin.css";

if (!Astro.locals.user) {
  return Astro.redirect("/admin/login?redirect=/backoffice", 303);
}

const subRepo = new SupabaseSubscriptionRepository(Astro.locals.supabase);
const isSuperadmin = await subRepo.isPlatformSuperadmin(Astro.locals.user.id);

if (!isSuperadmin) {
  // Safe authorization guard: unauthorized users are redirected to standard admin
  return Astro.redirect("/admin", 303);
}

const logoutResult = Astro.getActionResult(actions.logout);
if (logoutResult?.data?.ok) return Astro.redirect("/admin/login", 303);

const changePlanResult = Astro.getActionResult(actions.changePlan);

let overview: any = null;
let errorLoading = false;

try {
  overview = await getPlatformBackofficeOverviewUseCase(true, subRepo);
} catch (e) {
  errorLoading = true;
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Platform Backoffice | Landing SaaS</title>
  </head>
  <body>
    <header class="shell topbar">
      <div>
        <strong style="color: #f59e0b;">Landing SaaS [SUPERADMIN]</strong>
      </div>
      <nav aria-label="Backoffice navigation">
        <ul class="nav-links">
          <li><a href="/admin" class="nav-link">Tenant Workspace</a></li>
          <li><a href="/backoffice" class="nav-link active">Platform Backoffice</a></li>
        </ul>
      </nav>
      <form method="POST" action={actions.logout}>
        <button type="submit">Sign out</button>
      </form>
    </header>

    <main class="shell dashboard">
      <p class="eyebrow" style="color: #f59e0b;">System-Wide Operations & Multi-Tenant Analytics</p>
      <h1>Platform Backoffice</h1>

      {changePlanResult?.data?.ok && changePlanResult.data.subscription && (
        <p class="success" role="status" style="background: #14532d; color: #bbf7d0; padding: .75rem 1rem; border-radius: 6px; margin-bottom: 1.5rem;">
          Successfully updated tenant plan to {changePlanResult.data.subscription.planId.toUpperCase()}!
        </p>
      )}

      {errorLoading || !overview ? (
        <p class="error" role="alert">Unable to load platform metrics. Ensure superadmin permissions are configured.</p>
      ) : (
        <>
          <!-- Global KPI Cards -->
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.25rem; margin-bottom: 2.5rem;">
            <div style="background: #1e293b; border: 1px solid #334155; border-radius: 8px; padding: 1.25rem;">
              <p style="margin: 0 0 .5rem; color: #94a3b8; font-size: .85rem; text-transform: uppercase;">Total Tenants</p>
              <p style="margin: 0; font-size: 2rem; font-weight: 700; color: #f8fafc;">
                {overview.totalTenants}
              </p>
            </div>

            <div style="background: #1e293b; border: 1px solid #334155; border-radius: 8px; padding: 1.25rem;">
              <p style="margin: 0 0 .5rem; color: #94a3b8; font-size: .85rem; text-transform: uppercase;">Active Subscriptions</p>
              <p style="margin: 0; font-size: 2rem; font-weight: 700; color: #22c55e;">
                {overview.activeSubscriptions}
              </p>
            </div>

            <div style="background: #1e293b; border: 1px solid #334155; border-radius: 8px; padding: 1.25rem;">
              <p style="margin: 0 0 .5rem; color: #94a3b8; font-size: .85rem; text-transform: uppercase;">Active Trials</p>
              <p style="margin: 0; font-size: 2rem; font-weight: 700; color: #38bdf8;">
                {overview.trialingSubscriptions}
              </p>
            </div>

            <div style="background: #1e293b; border: 1px solid #334155; border-radius: 8px; padding: 1.25rem;">
              <p style="margin: 0 0 .5rem; color: #94a3b8; font-size: .85rem; text-transform: uppercase;">Estimated MRR</p>
              <p style="margin: 0; font-size: 2rem; font-weight: 700; color: #f8fafc;">
                ${overview.estimatedMonthlyRecurringRevenueUsd}
                <span style="font-size: .85rem; color: #94a3b8; font-weight: 400;">/mo</span>
              </p>
            </div>
          </div>

          <!-- All Tenant Subscriptions Table -->
          <h2 style="font-size: 1.25rem; margin-bottom: 1rem; color: #f8fafc;">Tenant Subscriptions</h2>
          {overview.allSubscriptions.length === 0 ? (
            <p class="empty">No tenant subscriptions recorded yet.</p>
          ) : (
            <div style="overflow-x: auto; background: #1e293b; border: 1px solid #334155; border-radius: 8px;">
              <table style="width: 100%; border-collapse: collapse; text-align: left; color: #cbd5e1; font-size: .9rem;">
                <thead>
                  <tr style="border-bottom: 1px solid #334155; background: #0f172a;">
                    <th style="padding: .85rem 1rem;">Tenant ID</th>
                    <th style="padding: .85rem 1rem;">Plan</th>
                    <th style="padding: .85rem 1rem;">Status</th>
                    <th style="padding: .85rem 1rem;">Period Ends</th>
                    <th style="padding: .85rem 1rem;">Superadmin Override</th>
                  </tr>
                </thead>
                <tbody>
                  {overview.allSubscriptions.map((sub: any) => (
                    <tr style="border-bottom: 1px solid #334155;">
                      <td style="padding: .85rem 1rem; font-family: monospace;">{sub.tenantId}</td>
                      <td style="padding: .85rem 1rem; font-weight: 600; text-transform: uppercase;">
                        {sub.planId}
                      </td>
                      <td style="padding: .85rem 1rem;">
                        <span style={`padding: .2rem .5rem; border-radius: 4px; font-size: .75rem; text-transform: uppercase; ${sub.status === "active" ? "background: #166534; color: #bbf7d0;" : "background: #854d0e; color: #fef08a;"}`}>
                          {sub.status}
                        </span>
                      </td>
                      <td style="padding: .85rem 1rem; color: #94a3b8;">
                        {new Date(sub.currentPeriodEndsAt).toLocaleDateString()}
                      </td>
                      <td style="padding: .85rem 1rem;">
                        <form method="POST" action={actions.changePlan} style="display: flex; gap: .5rem; align-items: center;">
                          <input type="hidden" name="tenantId" value={sub.tenantId} />
                          <select name="planId" style="background: #0f172a; color: #f8fafc; border: 1px solid #475569; border-radius: 4px; padding: .25rem .5rem; font-size: .8rem;">
                            {PLAN_IDS.map((pId) => (
                              <option value={pId} selected={pId === sub.planId}>
                                {pId.toUpperCase()}
                              </option>
                            ))}
                          </select>
                          <button type="submit" style="background: #d97706; color: #ffffff; border: none; padding: .25rem .6rem; border-radius: 4px; font-size: .8rem; font-weight: 600; cursor: pointer;">
                            Apply
                          </button>
                        </form>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </>
      )}
    </main>
  </body>
</html>
