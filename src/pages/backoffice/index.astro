---
import { actions } from "astro:actions";
import { getPlatformBackofficeOverviewUseCase } from "../../application/saas/manage-subscription";
import { SupabaseSubscriptionRepository } from "../../infrastructure/supabase/subscription-repository";
import { createAdminClient } from "../../infrastructure/supabase/server";
import { parseServerEnv } from "../../infrastructure/config/env";
import { PLAN_IDS } from "../../domain/saas/plan";
import { TEMPLATE_KEYS, TEMPLATE_MANIFESTS, type TemplateKey } from "../../domain/template/manifest";
import { SupabasePaletteRepository } from "../../infrastructure/supabase/palette-repository";
import type { PlatformPalette } from "../../domain/site/palette";
import "../../styles/admin.css";

if (!Astro.locals.user) {
  return Astro.redirect("/admin/login?redirect=/backoffice", 303);
}

const subRepo = new SupabaseSubscriptionRepository(Astro.locals.supabase);
const isSuperadmin = await subRepo.isPlatformSuperadmin(Astro.locals.user.id);

if (!isSuperadmin) {
  return Astro.redirect("/admin", 303);
}

const logoutResult = Astro.getActionResult(actions.logout);
if (logoutResult?.data?.ok) return Astro.redirect("/admin/login", 303);

const changePlanResult = Astro.getActionResult(actions.changePlan);
const onboardResult = Astro.getActionResult(actions.onboardClient);
const createPaletteResult = Astro.getActionResult(actions.createPlatformPalette);
const deletePaletteResult = Astro.getActionResult(actions.deletePlatformPalette);

const paletteRepo = new SupabasePaletteRepository(Astro.locals.supabase);
const platformPalettes: PlatformPalette[] = await paletteRepo.listPalettes();

let overview: any = null;
let errorLoading = false;
let clientsList: any[] = [];

try {
  overview = await getPlatformBackofficeOverviewUseCase(true, subRepo);

  const env = parseServerEnv(import.meta.env, process.env);
  const adminClient = createAdminClient(env);

  // Fetch all superadmin IDs to strictly exclude them from being considered "clients"
  const { data: superadmins } = await adminClient
    .from("platform_superadmins")
    .select("user_id");
  const superadminUserIds = new Set(superadmins?.map((s) => s.user_id) || []);

  // Fetch all tenants with their sites
  const { data: tenants } = await adminClient
    .from("tenants")
    .select(`
      id,
      name,
      created_at,
      sites (id, name, slug, template_key)
    `)
    .order("created_at", { ascending: false });

  // Fetch members to identify tenant owners
  const { data: members } = await adminClient
    .from("tenant_members")
    .select("tenant_id, user_id, role")
    .eq("role", "owner");

  const { data: authUsers } = await adminClient.auth.admin.listUsers();
  const userEmailMap = new Map<string, string>();
  if (authUsers?.users) {
    for (const u of authUsers.users) {
      if (u.email) userEmailMap.set(u.id, u.email);
    }
  }

  const tenantOwnerMap = new Map<string, { userId: string; email: string }>();
  if (members) {
    for (const m of members) {
      const email = userEmailMap.get(m.user_id);
      if (email && !tenantOwnerMap.has(m.tenant_id)) {
        tenantOwnerMap.set(m.tenant_id, { userId: m.user_id, email });
      }
    }
  }

  // Combine with subscriptions
  const subMap = new Map<string, any>();
  if (overview?.allSubscriptions) {
    for (const s of overview.allSubscriptions) {
      subMap.set(s.tenantId, s);
    }
  }

  const superadminEmails = new Set<string>();
  if (superadmins) {
    for (const s of superadmins) {
      const email = userEmailMap.get(s.user_id);
      if (email) superadminEmails.add(email.toLowerCase());
    }
  }
  if (Astro.locals.user?.email) {
    superadminEmails.add(Astro.locals.user.email.toLowerCase());
  }

  if (tenants) {
    // Exclude any tenant owned by a superadmin — Superadmin is strictly NOT a client
    const realClientTenants = tenants.filter((t: any) => {
      const ownerInfo = tenantOwnerMap.get(t.id);
      if (!ownerInfo) return false;
      if (superadminUserIds.has(ownerInfo.userId)) return false;
      if (ownerInfo.email && superadminEmails.has(ownerInfo.email.toLowerCase())) return false;
      return true;
    });

    clientsList = realClientTenants.map((t: any) => {
      const sub = subMap.get(t.id);
      const ownerInfo = tenantOwnerMap.get(t.id);
      const site = Array.isArray(t.sites) && t.sites.length > 0 ? t.sites[0] : null;
      const rawTemplateKey = site?.template_key as TemplateKey | undefined;
      const templateKey: TemplateKey = rawTemplateKey && rawTemplateKey in TEMPLATE_MANIFESTS ? rawTemplateKey : "friendly-tech";
      const templateName = TEMPLATE_MANIFESTS[templateKey]?.name || (rawTemplateKey ?? "friendly-tech");
      return {
        tenantId: t.id,
        tenantName: t.name,
        createdAt: t.created_at,
        ownerEmail: ownerInfo?.email || "Sin email asignado",
        site,
        templateKey,
        templateName,
        planId: sub?.planId || "pro",
        status: sub?.status || "active",
        periodEndsAt: sub?.currentPeriodEndsAt || null,
      };
    });
  }
} catch (e) {
  errorLoading = true;
}
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Platform Master Dashboard | Landing SaaS</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Outfit:wght@600;700;800;900&display=swap" rel="stylesheet" />
  </head>
  <body class="superadmin-body">
    <!-- Top Navigation for Superadmin -->
    <header class="superadmin-topbar">
      <div class="topbar-container">
        <div class="brand-cluster">
          <div class="superadmin-badge-pulse">
            <span class="pulse-ring"></span>
            <span class="badge-core">SUPERADMIN</span>
          </div>
          <strong class="platform-title">Landing SaaS <span class="accent-text">Control Center</span></strong>
        </div>

        <nav class="superadmin-nav" aria-label="Navegación Superadmin">
          <a href="/backoffice" class="nav-item active">
            <span class="nav-icon">📊</span>
            Dashboard & Clientes
          </a>
          <a href="/" target="_blank" class="nav-item">
            <span class="nav-icon">🌐</span>
            Ver Landing de Ventas ↗
          </a>
        </nav>

        <div class="user-cluster">
          <div class="superadmin-pill" title="Sesión activa como Superadministrador">
            <span class="user-dot"></span>
            <span class="user-email">{Astro.locals.user.email}</span>
          </div>
          <form method="POST" action={actions.logout}>
            <button type="submit" class="btn-logout" title="Cerrar sesión">
              Salir
            </button>
          </form>
        </div>
      </div>
    </header>

    <main class="dashboard-content">
      <!-- Welcome & Header -->
      <div class="page-intro animate-fade-in">
        <div class="intro-text">
          <span class="eyebrow-amber">Panel Maestro de Control</span>
          <h1 class="page-title">Gestión de Clientes & Landings</h1>
          <p class="page-subtitle">
            Administrá tus clientes, dalos de alta con su template asignado y configurá sus landings con control total.
          </p>
        </div>
        <div class="intro-actions">
          <a href="#alta-cliente" class="btn-cta-gold">
            <span>➕ Dar de Alta Nuevo Cliente</span>
          </a>
        </div>
      </div>

      <!-- Action Feedback Banners -->
      {onboardResult?.data?.ok && onboardResult.data.client && (
        <div class="feedback-banner success animate-slide-down" role="status">
          <div class="banner-icon-glow">🎉</div>
          <div class="banner-details">
            <h3 class="banner-title">¡Cliente dado de alta exitosamente!</h3>
            <p class="banner-message">
              Se crearon las credenciales de acceso para <strong>{onboardResult.data.client.clientEmail}</strong> en el tenant <strong>{onboardResult.data.client.tenantName}</strong>. Su landing inicial <strong>"{onboardResult.data.client.siteName}"</strong> está lista.
            </p>
            <div class="banner-actions">
              <a href={`/admin/sites/${onboardResult.data.client.siteId}/theme`} class="btn-banner-primary">
                ⚙️ Configurar Landing del Cliente Ahora &rarr;
              </a>
              <a href={`/sites/${onboardResult.data.client.siteSlug}`} target="_blank" class="btn-banner-secondary">
                👁️ Ver Landing Pública (/sites/{onboardResult.data.client.siteSlug}) ↗
              </a>
            </div>
          </div>
        </div>
      )}

      {onboardResult?.data && !onboardResult.data.ok && (
        <div class="feedback-banner error animate-slide-down" role="alert">
          <div class="banner-icon-glow">⚠️</div>
          <div class="banner-details">
            <h3 class="banner-title">Error al procesar el alta</h3>
            <p class="banner-message">{onboardResult.data.error}</p>
          </div>
        </div>
      )}

      {changePlanResult?.data?.ok && changePlanResult.data.subscription && (
        <div class="feedback-banner success animate-slide-down" role="status">
          <div class="banner-icon-glow">✓</div>
          <div class="banner-details">
            <p class="banner-message">
              Plan actualizado a <strong>{changePlanResult.data.subscription.planId.toUpperCase()}</strong> correctamente.
            </p>
          </div>
        </div>
      )}

      {createPaletteResult?.data?.ok && (
        <div class="feedback-banner success animate-slide-down" role="status">
          <div class="banner-icon-glow">🎨</div>
          <div class="banner-details">
            <h3 class="banner-title">¡Paleta guardada en la plataforma!</h3>
            <p class="banner-message">La nueva combinación de colores ya está disponible para todos los clientes.</p>
          </div>
        </div>
      )}

      {createPaletteResult?.data && !createPaletteResult.data.ok && (
        <div class="feedback-banner error animate-slide-down" role="alert">
          <div class="banner-icon-glow">⚠️</div>
          <div class="banner-details">
            <h3 class="banner-title">Error al crear la paleta</h3>
            <p class="banner-message">{createPaletteResult.data.error}</p>
          </div>
        </div>
      )}

      {deletePaletteResult?.data?.ok && (
        <div class="feedback-banner success animate-slide-down" role="status">
          <div class="banner-icon-glow">🗑️</div>
          <div class="banner-details">
            <p class="banner-message">Paleta eliminada de la plataforma correctamente.</p>
          </div>
        </div>
      )}

      {errorLoading || !overview ? (
        <div class="error-panel">
          <p>No se pudieron cargar las métricas de la plataforma. Verificá permisos de superadmin.</p>
        </div>
      ) : (
        <>
          <!-- Global KPI Cards with animated glow -->
          <section class="kpi-section animate-fade-in">
            <div class="kpi-card">
              <div class="kpi-header">
                <span class="kpi-title">Clientes Reales Activos</span>
                <span class="kpi-badge">Tenants</span>
              </div>
              <strong class="kpi-number">{clientsList.length}</strong>
              <span class="kpi-trend">Excluye cuentas administrativas</span>
            </div>

            <div class="kpi-card highlight-green">
              <div class="kpi-header">
                <span class="kpi-title">Suscripciones Activas</span>
                <span class="kpi-badge green">Live</span>
              </div>
              <strong class="kpi-number text-green">{overview.activeSubscriptions}</strong>
              <span class="kpi-trend">Plataforma operando al 100%</span>
            </div>

            <div class="kpi-card highlight-cyan">
              <div class="kpi-header">
                <span class="kpi-title">En Período de Prueba</span>
                <span class="kpi-badge cyan">Trial</span>
              </div>
              <strong class="kpi-number text-cyan">{overview.trialingSubscriptions}</strong>
              <span class="kpi-trend">Oportunidades de conversión</span>
            </div>

            <div class="kpi-card highlight-gold">
              <div class="kpi-header">
                <span class="kpi-title">MRR Estimado</span>
                <span class="kpi-badge gold">Mensual</span>
              </div>
              <strong class="kpi-number text-gold">
                ${overview.estimatedMonthlyRecurringRevenueUsd}
                <span class="kpi-unit">USD/mo</span>
              </strong>
              <span class="kpi-trend">Ingresos recurrentes calculados</span>
            </div>
          </section>

          <!-- Onboard New Client Form Card -->
          <section id="alta-cliente" class="onboard-card animate-fade-in">
            <div class="card-header-cluster">
              <div class="header-icon-box">🚀</div>
              <div>
                <h2 class="card-headline">Alta Directa de Cliente</h2>
                <p class="card-subtext">
                  Ingresá los datos del cliente para crear su cuenta de acceso, su tenant aislado y su landing inicial con la dirección visual elegida.
                </p>
              </div>
            </div>

            <form method="POST" action={actions.onboardClient} class="onboard-grid-form" id="onboard-form">
              <!-- Tenant & Auth Details -->
              <div class="form-section-title">
                <span>1. Datos del Cliente & Cuenta de Acceso</span>
              </div>

              <div class="inputs-row-3">
                <div class="input-field">
                  <label for="tenantName">Nombre de Empresa o Cliente *</label>
                  <input type="text" id="tenantName" name="tenantName" required placeholder="Ej: Consultora TechNova" />
                  <span class="helper-text">Nombre legal o comercial del cliente</span>
                </div>

                <div class="input-field">
                  <label for="clientEmail">Email de Acceso del Cliente *</label>
                  <input type="email" id="clientEmail" name="clientEmail" required placeholder="cliente@technova.com" />
                  <span class="helper-text">Con este email ingresará al login</span>
                </div>

                <div class="input-field">
                  <div class="label-row">
                    <label for="clientPassword">Contraseña Inicial *</label>
                    <button type="button" id="btn-generate-password" class="btn-micro-action" title="Generar clave aleatoria">
                      ⚡ Generar
                    </button>
                  </div>
                  <div class="password-wrapper">
                    <input type="text" id="clientPassword" name="clientPassword" required minlength="8" value="Cliente2026!" />
                  </div>
                  <span class="helper-text">El cliente podrá cambiarla en su panel</span>
                </div>
              </div>

              <!-- Site & Template Details -->
              <div class="form-section-title" style="margin-top: 1.5rem;">
                <span>2. Configuración de la Landing Page Inicial</span>
              </div>

              <div class="inputs-row-4">
                <div class="input-field">
                  <label for="siteName">Nombre de la Landing *</label>
                  <input type="text" id="siteName" name="siteName" required placeholder="Ej: TechNova Soluciones" />
                  <span class="helper-text">Título visible de la landing</span>
                </div>

                <div class="input-field">
                  <label for="siteSlug">Slug / Identificador de URL *</label>
                  <input type="text" id="siteSlug" name="siteSlug" required placeholder="technova-soluciones" />
                  <span class="helper-text preview-slug" id="slug-preview">Ruta: /sites/technova-soluciones</span>
                </div>

                <div class="input-field">
                  <label for="templateKey">Dirección Visual / Template *</label>
                  <select id="templateKey" name="templateKey" required>
                    {TEMPLATE_KEYS.map((tKey) => (
                      <option value={tKey} selected={tKey === "friendly-tech"}>
                        {TEMPLATE_MANIFESTS[tKey].name} ({TEMPLATE_MANIFESTS[tKey].personality.split(",")[0]})
                      </option>
                    ))}
                  </select>
                  <span class="helper-text">Estilo visual y composición base</span>
                </div>

                <div class="input-field">
                  <label for="planId">Plan SaaS Asignado *</label>
                  <select id="planId" name="planId" required>
                    {PLAN_IDS.map((pId) => (
                      <option value={pId} selected={pId === "pro"}>
                        Plan {pId.toUpperCase()} {pId === "pro" ? "(Recomendado)" : ""}
                      </option>
                    ))}
                  </select>
                  <span class="helper-text">Define cuotas y funciones habilitadas</span>
                </div>
              </div>

              <div class="form-submit-row">
                <button type="submit" class="btn-create-client">
                  <span>Crear Cuenta de Cliente y Landing</span>
                  <span class="btn-chevron">&rarr;</span>
                </button>
              </div>
            </form>
          </section>

          <!-- Section: Client Directory Table -->
          <section class="directory-section animate-fade-in" style="margin-top: 4rem;">
            <div class="directory-header">
              <div>
                <h2 class="section-title">Directorio de Clientes</h2>
                <p class="section-subtitle">
                  Listado exclusivo de clientes dados de alta. Podés ingresar a configurar cualquier sitio directamente con tus permisos de superadmin.
                </p>
              </div>
              <div class="directory-counter">
                <span class="counter-number">{clientsList.length}</span>
                <span class="counter-text">{clientsList.length === 1 ? "cliente" : "clientes"}</span>
              </div>
            </div>

            {clientsList.length === 0 ? (
              <div class="empty-state-card">
                <div class="empty-icon">📂</div>
                <h3>No hay clientes registrados todavía</h3>
                <p>Completá el formulario de arriba para dar de alta a tu primer cliente.</p>
              </div>
            ) : (
              <div class="super-table-wrapper">
                <table class="super-table">
                  <thead>
                    <tr>
                      <th>Cliente / Empresa</th>
                      <th>Email de Acceso</th>
                      <th>Landing Asignada</th>
                      <th>Template</th>
                      <th>Plan SaaS</th>
                      <th>Configurar como Superadmin</th>
                    </tr>
                  </thead>
                  <tbody>
                    {clientsList.map((client) => (
                      <tr class="client-row">
                        <td class="col-tenant">
                          <strong class="tenant-name">{client.tenantName}</strong>
                          <span class="tenant-id">ID: {client.tenantId.substring(0, 8)}...</span>
                        </td>

                        <td class="col-email">
                          <span class="email-badge">{client.ownerEmail}</span>
                        </td>

                        <td class="col-site">
                          {client.site ? (
                            <div class="site-info-box">
                              <span class="site-title">{client.site.name}</span>
                              <div class="site-slug-row">
                                <span class="site-path">/sites/{client.site.slug}</span>
                                <a href={`/sites/${client.site.slug}`} target="_blank" class="link-preview-external" title="Ver landing en vivo">
                                  Ver ↗
                                </a>
                              </div>
                            </div>
                          ) : (
                            <span class="no-site-tag">Sin sitio activo</span>
                          )}
                        </td>

                        <td class="col-template">
                          {client.site ? (
                            <span class={`template-tag template-${client.templateKey}`}>
                              {client.templateName}
                            </span>
                          ) : (
                            <span>-</span>
                          )}
                        </td>

                        <td class="col-plan">
                          <form method="POST" action={actions.changePlan} class="plan-form">
                            <input type="hidden" name="tenantId" value={client.tenantId} />
                            <select name="planId" class="select-plan-compact">
                              {PLAN_IDS.map((pId) => (
                                <option value={pId} selected={pId === client.planId}>
                                  {pId.toUpperCase()}
                                </option>
                              ))}
                            </select>
                            <button type="submit" class="btn-plan-save" title="Guardar cambio de plan">
                              ✓
                            </button>
                          </form>
                        </td>

                        <td class="col-actions">
                          {client.site ? (
                            <div class="actions-group">
                              <a href={`/admin/sites/${client.site.id}/theme`} class="btn-manage-landing" title="Configurar Theme, Hero y Secciones">
                                <span>⚙️ Configurar Landing</span>
                              </a>
                            </div>
                          ) : (
                            <span class="muted-text">N/A</span>
                          )}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
          </section>

          <!-- Platform Brand Palettes Section -->
          <section class="section-card animate-fade-in" id="paletas-plataforma" style="margin-top: 2.5rem;">
            <div class="card-header-cluster">
              <div class="header-icon-box" style="background: rgba(168, 85, 247, 0.15); border-color: rgba(168, 85, 247, 0.4); color: #c084fc;">🎨</div>
              <div>
                <h2 class="card-headline">Paletas de Colores de la Plataforma</h2>
                <p class="card-subtext">
                  Como superadmin podés crear y gestionar paletas cromáticas armónicas que estarán disponibles con 1-clic para todos los clientes en su editor de themes.
                </p>
              </div>
            </div>

            <!-- Existing Palettes Grid -->
            <div class="palettes-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.25rem; margin-bottom: 2.5rem;">
              {platformPalettes.map((p) => (
                <div class="palette-card" style="background: rgba(15, 23, 42, 0.7); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 0.75rem; padding: 1.25rem; position: relative; display: flex; flex-direction: column; justify-content: space-between;">
                  <div>
                    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.75rem;">
                      <div>
                        <strong style="font-size: 1rem; color: #f8fafc; display: block;">{p.name}</strong>
                        {p.description && <span style="font-size: 0.75rem; color: #94a3b8; line-height: 1.3; display: block; margin-top: 0.2rem;">{p.description}</span>}
                      </div>
                      <span style={`font-size: 0.65rem; padding: 0.2rem 0.5rem; border-radius: 9999px; font-weight: 700; ${p.isSystem ? 'background: rgba(56, 189, 248, 0.15); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.3);' : 'background: rgba(168, 85, 247, 0.15); color: #c084fc; border: 1px solid rgba(168, 85, 247, 0.3);'}`}>
                        {p.isSystem ? 'SISTEMA' : 'PROPIA'}
                      </span>
                    </div>

                    <!-- 5 Color Swatches -->
                    <div style="display: flex; gap: 0.4rem; margin-bottom: 1rem; border-radius: 0.5rem; overflow: hidden; padding: 0.35rem; background: rgba(0,0,0,0.3);">
                      <div title={`Primario: ${p.primaryColor}`} style={`flex: 1; height: 32px; border-radius: 4px; background: ${p.primaryColor};`}></div>
                      <div title={`Secundario: ${p.secondaryColor}`} style={`flex: 1; height: 32px; border-radius: 4px; background: ${p.secondaryColor};`}></div>
                      <div title={`Acento: ${p.accentColor}`} style={`flex: 1; height: 32px; border-radius: 4px; background: ${p.accentColor};`}></div>
                      <div title={`Fondo: ${p.backgroundColor}`} style={`flex: 1; height: 32px; border-radius: 4px; background: ${p.backgroundColor}; border: 1px solid rgba(255,255,255,0.1);`}></div>
                      <div title={`Texto: ${p.textColor}`} style={`flex: 1; height: 32px; border-radius: 4px; background: ${p.textColor};`}></div>
                    </div>

                    <div style="font-size: 0.72rem; color: #64748b; font-family: monospace; display: flex; justify-content: space-between;">
                      <span>{p.primaryColor}</span>
                      <span>{p.accentColor}</span>
                      <span>{p.backgroundColor}</span>
                    </div>
                  </div>

                  {!p.isSystem && (
                    <form method="POST" action={actions.deletePlatformPalette} style="margin-top: 1rem; text-align: right;">
                      <input type="hidden" name="paletteId" value={p.id} />
