    <!-- Client-side Interactive Script -->
    <script>
      // Auto-generate slug from site name
      const siteNameInput = document.getElementById("siteName") as HTMLInputElement | null;
      const siteSlugInput = document.getElementById("siteSlug") as HTMLInputElement | null;
      const slugPreview = document.getElementById("slug-preview");

      function slugify(text: string): string {
        return text
          .toString()
          .toLowerCase()
          .trim()
          .normalize("NFD")
          .replace(/[\u0300-\u036f]/g, "")
          .replace(/[^a-z0-9\s-]/g, "")
          .replace(/[\s_]+/g, "-")
          .replace(/^-+|-+$/g, "");
      }

      if (siteNameInput && siteSlugInput) {
        let isSlugManuallyEdited = false;

        siteSlugInput.addEventListener("input", () => {
          isSlugManuallyEdited = true;
          if (slugPreview) slugPreview.textContent = `Ruta: /sites/${siteSlugInput.value}`;
        });

        siteNameInput.addEventListener("input", () => {
          if (!isSlugManuallyEdited) {
            const generated = slugify(siteNameInput.value);
            siteSlugInput.value = generated;
            if (slugPreview) slugPreview.textContent = `Ruta: /sites/${generated}`;
          }
        });
      }

      // Password Generator Button
      const generateBtn = document.getElementById("btn-generate-password");
      const passwordInput = document.getElementById("clientPassword") as HTMLInputElement | null;

      if (generateBtn && passwordInput) {
        generateBtn.addEventListener("click", () => {
          const chars = "abcdefghjkmnpqrstuvwxyzABCDEFGHJKLMNPQRSTUVWXYZ23456789!@#$%&*";
          let pass = "";
          for (let i = 0; i < 12; i++) {
            pass += chars.charAt(Math.floor(Math.random() * chars.length));
          }
          passwordInput.value = pass;
          passwordInput.type = "text";
        });
      }

      // Palette Live Preview & Color Pickers Sync
      const colorPairs = [
        { picker: "primaryColorPicker", text: "primaryColor" },
        { picker: "secondaryColorPicker", text: "secondaryColor" },
        { picker: "accentColorPicker", text: "accentColor" },
        { picker: "backgroundColorPicker", text: "backgroundColor" },
        { picker: "textColorPicker", text: "textColor" },
      ];

      function updatePaletteLivePreview() {
        const primary = (document.getElementById("primaryColor") as HTMLInputElement)?.value || "#38bdf8";
        const secondary = (document.getElementById("secondaryColor") as HTMLInputElement)?.value || "#818cf8";
        const accent = (document.getElementById("accentColor") as HTMLInputElement)?.value || "#f43f5e";
        const bg = (document.getElementById("backgroundColor") as HTMLInputElement)?.value || "#0a0f1e";
        const text = (document.getElementById("textColor") as HTMLInputElement)?.value || "#f8fafc";

        const container = document.getElementById("palette-live-preview");
        const badge = document.getElementById("preview-badge");
        const accentTag = document.getElementById("preview-accent-tag");
        const heading = document.getElementById("preview-heading");
        const subtext = document.getElementById("preview-subtext");
        const btn = document.getElementById("preview-btn");
        const accentBtn = document.getElementById("preview-accent-btn");

        if (container) {
          container.style.backgroundColor = bg;
          container.style.borderColor = primary + "55";
        }
        if (heading) heading.style.color = text;
        if (subtext) subtext.style.color = secondary;
        if (badge) {
          badge.style.color = primary;
          badge.style.backgroundColor = primary + "22";
          badge.style.borderColor = primary + "55";
        }
        if (accentTag) accentTag.style.color = accent;
        if (btn) {
          btn.style.backgroundColor = primary;
          btn.style.color = bg;
        }
        if (accentBtn) {
          accentBtn.style.backgroundColor = accent;
          accentBtn.style.color = "#ffffff";
        }
      }

      colorPairs.forEach(({ picker, text }) => {
        const pEl = document.getElementById(picker) as HTMLInputElement | null;
        const tEl = document.getElementById(text) as HTMLInputElement | null;

        if (pEl && tEl) {
          pEl.addEventListener("input", () => {
            tEl.value = pEl.value;
            updatePaletteLivePreview();
          });
          tEl.addEventListener("input", () => {
            if (/^#[0-9a-fA-F]{6}$/.test(tEl.value)) {
              pEl.value = tEl.value;
              updatePaletteLivePreview();
            }
          });
        }
      });

      updatePaletteLivePreview();
    </script>

