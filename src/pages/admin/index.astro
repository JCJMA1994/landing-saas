---
import { actions } from "astro:actions";
import { listAccessibleSites } from "../../application/sites/list-accessible-sites";
import { SiteRepositoryError, type AccessibleSite } from "../../application/sites/site-repository";
import { SupabaseSiteRepository } from "../../infrastructure/supabase/site-repository";
import { SupabaseSubscriptionRepository } from "../../infrastructure/supabase/subscription-repository";
import "../../styles/admin.css";

const logoutResult = Astro.getActionResult(actions.logout);
if (logoutResult?.data?.ok) return Astro.redirect("/admin/login", 303);

const subRepo = new SupabaseSubscriptionRepository(Astro.locals.supabase);
const isSuperadmin = Astro.locals.user ? await subRepo.isPlatformSuperadmin(Astro.locals.user.id) : false;

if (isSuperadmin) {
  return Astro.redirect("/backoffice", 303);
}

const repository = new SupabaseSiteRepository(async () => {
  const result = await Astro.locals.supabase.from("sites").select("id, name, slug").order("name");
  return { data: result.data, error: result.error };
});

let sites: AccessibleSite[] = [];
let loadError = false;
try {
  sites = await listAccessibleSites(Astro.locals.user, repository);
} catch (error) {
  loadError = error instanceof SiteRepositoryError;
  if (!loadError) throw error;
}

const siteIds = sites.map((s) => s.id);

// Fetch additional metadata for sites, tenant, and active publications
const [sitesMetaResult, pubsResult, membershipResult, subResult] = await Promise.all([
  siteIds.length > 0
    ? Astro.locals.supabase.from("sites").select("id, template_key, created_at").in("id", siteIds)
    : Promise.resolve({ data: [] }),
  siteIds.length > 0
    ? Astro.locals.supabase.from("site_publications").select("site_id, version, published_at").in("site_id", siteIds).eq("is_active", true)
    : Promise.resolve({ data: [] }),
  Astro.locals.supabase.from("tenant_members").select("role, tenants(name)").limit(1),
  Astro.locals.supabase.from("tenant_subscriptions").select("plan_id, status").limit(1),
]);

const metaMap = new Map((sitesMetaResult.data ?? []).map((m: any) => [m.id, m]));
const pubMap = new Map((pubsResult.data ?? []).map((p: any) => [p.site_id, p]));
const tenantName = (membershipResult.data?.[0]?.tenants as any)?.name || "Tu Empresa";
const userRole = membershipResult.data?.[0]?.role || "owner";
const subscriptionPlan = subResult.data?.[0]?.plan_id ? String(subResult.data[0].plan_id).toUpperCase() : "PRO";

const TEMPLATE_LABELS: Record<string, string> = {
  "tech-diagnostic": "Tech Diagnostic & Precision",
  "repair-workshop": "Workshop & Taller Especializado",
  "system-monitor": "Monitor & Telemetría",
  "tech-editorial": "Editorial Tecnológico",
  "cyber-performance": "Cyber Performance & Velocidad",
  "friendly-tech": "Friendly Tech & Cercano",
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Panel de Control | LaunchPulse Studio</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="client-workspace-body">
    <!-- Premium Top Navigation Bar -->
    <header class="client-header">
      <div class="shell header-inner">
        <div class="header-left">
          <a href="/admin" class="brand-badge" aria-label="LaunchPulse Inicio">
            <div class="brand-icon-tile">
              <svg viewBox="0 0 32 32" fill="none" width="22" height="22">
                <path d="M6 22 L16 5 L26 22 L20 20 L16 12 L12 20 Z" fill="url(#lp-dash-chevron)" />
                <path d="M10 25 L13 25 L14.5 21 L16 27 L17.5 24 L19 25 L22 25" stroke="#38bdf8" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                <circle cx="16" cy="14" r="2" fill="#ffffff" />
                <defs>
                  <linearGradient id="lp-dash-chevron" x1="0%" y1="0%" x2="0%" y2="100%">
                    <stop offset="0%" stop-color="#ffffff" />
                    <stop offset="65%" stop-color="#38bdf8" />
                    <stop offset="100%" stop-color="#6366f1" />
                  </linearGradient>
                </defs>
              </svg>
            </div>
            <div class="brand-text-group">
              <span class="brand-title">Launch<span class="brand-accent">Pulse</span></span>
              <span class="brand-subtitle">STUDIO & ENGINE</span>
            </div>
          </a>

          <nav class="client-nav" aria-label="Navegación principal">
            <a href="/admin" class="nav-item active">Sitios & Landings</a>
            <a href="/admin/members" class="nav-item">Equipo</a>
            <a href="/admin/billing" class="nav-item">Suscripción</a>
          </nav>
        </div>

        <div class="header-right">
          <div class="user-pill">
            <span class="user-status-dot"></span>
            <span class="user-email" title={Astro.locals.user?.email}>{Astro.locals.user?.email}</span>
            <span class="user-role-tag">{userRole}</span>
          </div>

          <form method="POST" action={actions.logout}>
            <button type="submit" class="btn-logout" title="Cerrar sesión">
              Salir
            </button>
          </form>
        </div>
      </div>
    </header>

    <main class="shell workspace-main">
      <!-- Welcome Hero Banner -->
      <section class="welcome-section">
        <div class="welcome-meta">
          <span class="badge-tenant">🏢 {tenantName}</span>
          <span class="badge-plan">Plan {subscriptionPlan}</span>
        </div>
        <h1 class="welcome-heading">Panel de Control de tu Landing</h1>
        <p class="welcome-sub">
          Personalizá el diseño, gestioná tus contenidos y publicá cambios con un solo clic.
        </p>
      </section>

      {logoutResult?.data && !logoutResult.data.ok && (
        <div class="alert-box error" role="alert">
          No se pudo cerrar sesión. Por favor intenta nuevamente.
        </div>
      )}

      {loadError ? (
        <div class="alert-box error" role="alert">
          Los sitios no están disponibles temporalmente. Por favor intenta de nuevo en unos momentos.
        </div>
      ) : sites.length === 0 ? (
        <div class="empty-state-card">
          <div class="empty-icon">🌐</div>
          <h2>No tenés ningún sitio asignado todavía</h2>
          <p>Contactá con soporte o a tu administrador de cuenta para aprovisionar tu primera landing page.</p>
        </div>
      ) : (
        <div class="sites-container">
          {sites.map((site) => {
            const meta = metaMap.get(site.id);
            const pub = pubMap.get(site.id);
            const templateKey = meta?.template_key || "tech-diagnostic";
            const templateName = TEMPLATE_LABELS[templateKey] || templateKey;
            const publicUrl = `/sites/${site.slug}`;
            const previewUrl = `/preview/${site.id}`;

            return (
              <article class="site-command-center">
                <!-- Site Identity Masthead Card -->
                <header class="site-card-header">
                  <div class="site-identity">
                    <div class="site-icon-avatar">🚀</div>
                    <div class="site-titles">
                      <div class="site-title-row">
                        <h2 class="site-name">{site.name}</h2>
                        {pub ? (
                          <span class="status-badge published">
                            <span class="status-pulse-dot"></span>
                            En Vivo (v{pub.version})
                          </span>
                        ) : (
                          <span class="status-badge draft">
                            🟡 Borrador Listo para Publicar
                          </span>
                        )}
                      </div>
                      <div class="site-url-row">
                        <span class="site-slug-label">Dirección Web:</span>
                        <a href={publicUrl} target="_blank" class="site-link-chip" title="Abrir landing en nueva pestaña">
                          <code>{publicUrl}</code>
                          <span class="link-arrow">↗</span>
                        </a>
                        <span class="template-chip">🎨 {templateName}</span>
                      </div>
                    </div>
                  </div>

                  <!-- Primary Quick Actions -->
                  <div class="header-action-buttons">
                    <a href={`/admin/sites/${site.id}/publish`} class="btn-action-highlight" title="Lanzar cambios a producción">
                      🚀 Publicar Cambios
                    </a>
                    <a href={publicUrl} target="_blank" class="btn-action-primary" title="Ver tu sitio tal como lo ven los visitantes">
                      👁️ Ver Landing Pública ↗
                    </a>
                    <a href={previewUrl} target="_blank" class="btn-action-secondary" title="Ver borradores antes de publicarlos">
                      🔍 Vista Previa Borrador ↗
                    </a>
                  </div>
                </header>

                <!-- Section 1: Onboarding Paso a Paso (7 Pasos Guiados) -->
                <section class="onboarding-guide-section">
                  <div class="section-intro-header">
                    <div class="section-badge-pill">RUTA GUIADA DE EDICIÓN</div>
                    <h3 class="section-heading-title">Paso a Paso para Personalizar tu Sitio</h3>
                    <p class="section-heading-desc">
                      Seguí estos 7 pasos para configurar tu landing de principio a fin, o ingresá directamente al paso que quieras modificar.
                    </p>
                  </div>

                  <div class="onboarding-steps-grid">
                    <!-- Paso 1: Plantilla Visual -->
                    <a href={`/admin/sites/${site.id}/template`} class="step-module-card">
                      <div class="step-module-top">
                        <span class="step-order-badge">PASO 1</span>
                        <span class="step-module-icon">⚡</span>
                      </div>
                      <strong class="step-module-title">Plantilla Visual</strong>
                      <p class="step-module-desc">Elegí el arquetipo de diseño y estructura adaptado a tu tipo de negocio.</p>
                      <span class="step-module-action">Elegir plantilla &rarr;</span>
                    </a>

                    <!-- Paso 2: Colores & Estilo -->
                    <a href={`/admin/sites/${site.id}/theme`} class="step-module-card">
                      <div class="step-module-top">
                        <span class="step-order-badge">PASO 2</span>
                        <span class="step-module-icon">🎨</span>
                      </div>
                      <strong class="step-module-title">Colores y Estilo</strong>
                      <p class="step-module-desc">Paleta corporativa, tipografía, radios redondeados y estilo de botones.</p>
                      <span class="step-module-action">Ajustar colores &rarr;</span>
                    </a>

                    <!-- Paso 3: Encabezado (Hero) -->
                    <a href={`/admin/sites/${site.id}/hero`} class="step-module-card">
                      <div class="step-module-top">
                        <span class="step-order-badge">PASO 3</span>
                        <span class="step-module-icon">📢</span>
                      </div>
                      <strong class="step-module-title">Encabezado (Hero)</strong>
                      <p class="step-module-desc">Titular de impacto, propuesta de valor y botón de llamada a la acción.</p>
                      <span class="step-module-action">Redactar hero &rarr;</span>
                    </a>

                    <!-- Paso 4: Servicios & Tarjetas -->
                    <a href={`/admin/sites/${site.id}/cards`} class="step-module-card">
                      <div class="step-module-top">
                        <span class="step-order-badge">PASO 4</span>
                        <span class="step-module-icon">💼</span>
                      </div>
                      <strong class="step-module-title">Servicios y Contenido</strong>
                      <p class="step-module-desc">Destacá tus servicios, beneficios y soluciones principales.</p>
                      <span class="step-module-action">Editar tarjetas &rarr;</span>
                    </a>

                    <!-- Paso 5: Identidad & Medios -->
                    <a href={`/admin/sites/${site.id}/media`} class="step-module-card">
                      <div class="step-module-top">
                        <span class="step-order-badge">PASO 5</span>
                        <span class="step-module-icon">🖼️</span>
                      </div>
                      <strong class="step-module-title">Identidad & Medios</strong>
                      <p class="step-module-desc">Subí tu logo, favicon de navegador e imágenes en alta calidad.</p>
                      <span class="step-module-action">Subir archivos &rarr;</span>
                    </a>

                    <!-- Paso 6: Contacto y WhatsApp -->
                    <a href={`/admin/sites/${site.id}/contacts`} class="step-module-card">
                      <div class="step-module-top">
                        <span class="step-order-badge">PASO 6</span>
                        <span class="step-module-icon">📞</span>
                      </div>
                      <strong class="step-module-title">Contacto & Redes</strong>
                      <p class="step-module-desc">Botón flotante de WhatsApp, teléfono, correo y ubicación comercial.</p>
                      <span class="step-module-action">Configurar canales &rarr;</span>
                    </a>

                    <!-- Paso 7: Publicar y Lanzar -->
                    <a href={`/admin/sites/${site.id}/publish`} class="step-module-card step-module-highlight">
                      <div class="step-module-top">
                        <span class="step-order-badge highlight-badge">PASO 7</span>
                        <span class="step-module-icon">🚀</span>
                      </div>
                      <strong class="step-module-title highlight-title">Publicar y Lanzar</strong>
                      <p class="step-module-desc">Lanzá tus cambios en vivo con respaldos inmutables y reversión en 1 clic.</p>
                      <span class="step-module-action highlight-action">Lanzar sitio &rarr;</span>
                    </a>
                  </div>
                </section>

                <!-- Section 2: Conectividad y Analítica (APARTE) -->
                <section class="management-tools-section">
                  <div class="section-intro-header">
                    <div class="section-badge-pill tool-badge">CONECTIVIDAD & ANALÍTICA</div>
                    <h3 class="section-heading-title">Herramientas de Crecimiento y Operación</h3>
                    <p class="section-heading-desc">
                      Configuraciones independientes de tu dominio web, métricas en tiempo real y promociones estacionales.
                    </p>
                  </div>

                  <div class="management-tools-grid">
                    <!-- Dominio Propio & DNS -->
                    <a href={`/admin/sites/${site.id}/domains`} class="management-tool-card">
                      <div class="tool-card-left">
                        <div class="tool-icon-box icon-domain">🌐</div>
                        <div class="tool-content">
                          <strong class="tool-title">Dominio Propio & DNS</strong>
                          <p class="tool-desc">
                            Conectá tu propio dominio personalizado (.com, .pe, etc.) con certificados SSL automáticos.
                          </p>
                        </div>
                      </div>
                      <span class="tool-action-pill">Configurar Dominio &rarr;</span>
                    </a>

                    <!-- Analíticas & Métricas -->
                    <a href={`/admin/sites/${site.id}/analytics`} class="management-tool-card">
                      <div class="tool-card-left">
                        <div class="tool-icon-box icon-analytics">📊</div>
                        <div class="tool-content">
                          <strong class="tool-title">Analíticas & Resultados</strong>
                          <p class="tool-desc">
                            Supervisá visitas reales, clics al botón de WhatsApp y conversiones sin cookies invasivas.
                          </p>
                        </div>
                      </div>
                      <span class="tool-action-pill">Ver Métricas &rarr;</span>
                    </a>

                    <!-- Campañas & Promociones -->
                    <a href={`/admin/sites/${site.id}/campaigns`} class="management-tool-card">
                      <div class="tool-card-left">
                        <div class="tool-icon-box icon-campaigns">🎯</div>
                        <div class="tool-content">
                          <strong class="tool-title">Campañas & Promociones</strong>
                          <p class="tool-desc">
                            Activá promociones por tiempo limitado (Black Friday, Cyber, etc.) con banners automáticos.
                          </p>
                        </div>
                      </div>
                      <span class="tool-action-pill">Gestionar Campañas &rarr;</span>
                    </a>
                  </div>
                </section>
              </article>
            );
          })}
        </div>
      )}
    </main>

    <style>
      /* =========================================================
         MOBILE-FIRST ADMIN DASHBOARD STYLES
         ========================================================= */

      .client-workspace-body {
        background: radial-gradient(circle at 50% 0%, #101c38 0%, #060a14 100%);
        min-height: 100vh;
        color: #f8fafc;
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, sans-serif;
      }

      /* Solid, non-bleeding sticky header */
      .client-header {
        background: #080e1d;
        border-bottom: 1px solid #1e2e4f;
        position: sticky;
        top: 0;
        z-index: 100;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
      }

      .header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.85rem 0;
        gap: 1.5rem;
      }

      .header-left {
        display: flex;
        align-items: center;
        gap: 2.5rem;
      }

      .brand-badge {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        text-decoration: none;
        color: inherit;
        transition: transform 0.2s ease;
      }

      .brand-badge:hover {
        transform: translateY(-1px);
      }

      .brand-icon-tile {
        width: 2.35rem;
        height: 2.35rem;
        border-radius: 0.65rem;
        background: radial-gradient(circle at 35% 25%, #18274d 0%, #080d1a 100%);
        border: 1px solid rgba(56, 189, 248, 0.35);
        display: grid;
        place-items: center;
        box-shadow: 0 0 14px rgba(56, 189, 248, 0.2);
      }

      .brand-text-group {
        display: flex;
        flex-direction: column;
        line-height: 1.1;
      }

      .brand-title {
        font-size: 1.15rem;
        font-weight: 900;
        letter-spacing: -0.02em;
        color: #f8fafc;
      }

      .brand-accent {
        color: #38bdf8;
        background: linear-gradient(135deg, #38bdf8 0%, #818cf8 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
      }

      .brand-subtitle {
        font-size: 0.6rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        color: #94a3b8;
      }

      .client-nav {
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }

      .nav-item {
        color: #94a3b8;
        text-decoration: none;
        font-size: 0.88rem;
        font-weight: 600;
        padding: 0.45rem 0.85rem;
        border-radius: 0.5rem;
        transition: all 0.2s ease;
      }

      .nav-item:hover {
        color: #f8fafc;
        background: rgba(255, 255, 255, 0.05);
      }

      .nav-item.active {
        color: #38bdf8;
        background: rgba(56, 189, 248, 0.1);
        font-weight: 700;
      }

      .header-right {
        display: flex;
        align-items: center;
        gap: 1rem;
      }

      .user-pill {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        background: rgba(17, 26, 46, 0.8);
        border: 1px solid rgba(56, 189, 248, 0.18);
        padding: 0.35rem 0.75rem;
        border-radius: 9999px;
        font-size: 0.82rem;
      }

      .user-status-dot {
        width: 0.5rem;
        height: 0.5rem;
        border-radius: 50%;
        background: #22c55e;
        box-shadow: 0 0 8px #22c55e;
      }

      .user-email {
        color: #cbd5e1;
        font-weight: 500;
        max-width: 180px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .user-role-tag {
        background: rgba(56, 189, 248, 0.15);
        color: #38bdf8;
        font-size: 0.68rem;
        font-weight: 800;
        text-transform: uppercase;
        padding: 0.15rem 0.4rem;
        border-radius: 0.35rem;
      }

      .btn-logout {
        background: rgba(239, 68, 68, 0.12);
        color: #fca5a5;
        border: 1px solid rgba(239, 68, 68, 0.25);
        font-size: 0.82rem;
        font-weight: 600;
        padding: 0.4rem 0.85rem;
        border-radius: 0.5rem;
        cursor: pointer;
        transition: all 0.2s ease;
      }

      .btn-logout:hover {
        background: rgba(239, 68, 68, 0.25);
        color: #ffffff;
      }

      /* Workspace Main */
      .workspace-main {
        padding: 2rem 0 5rem;
      }

      /* Welcome Section */
      .welcome-section {
        margin-bottom: 2rem;
      }

      .welcome-meta {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        margin-bottom: 0.6rem;
      }

      .badge-tenant {
        background: rgba(56, 189, 248, 0.15);
        color: #38bdf8;
        font-size: 0.78rem;
        font-weight: 700;
        padding: 0.25rem 0.65rem;
        border-radius: 0.4rem;
        border: 1px solid rgba(56, 189, 248, 0.3);
      }

      .badge-plan {
        background: rgba(168, 85, 247, 0.15);
        color: #d8b4fe;
        font-size: 0.78rem;
        font-weight: 800;
        padding: 0.25rem 0.65rem;
        border-radius: 0.4rem;
        border: 1px solid rgba(168, 85, 247, 0.3);
      }

      .welcome-heading {
        font-size: clamp(1.6rem, 3.8vw, 2.3rem);
        font-weight: 900;
        letter-spacing: -0.03em;
        margin: 0 0 0.4rem;
        color: #ffffff;
      }

      .welcome-sub {
        color: #94a3b8;
        font-size: 0.92rem;
        margin: 0;
        line-height: 1.5;
        max-width: 44rem;
      }

      /* Site Command Center */
      .site-command-center {
        background: #0d1527;
        border: 1px solid rgba(56, 189, 248, 0.22);
        border-radius: 1.25rem;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.45);
        overflow: hidden;
      }

      /* Site Card Header */
      .site-card-header {
        padding: 1.5rem;
        background: linear-gradient(180deg, rgba(20, 32, 60, 0.8) 0%, rgba(13, 21, 39, 0.95) 100%);
        border-bottom: 1px solid rgba(56, 189, 248, 0.12);
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
      }

      .site-identity {
        display: flex;
        align-items: center;
        gap: 1rem;
      }

      .site-icon-avatar {
        width: 3.2rem;
        height: 3.2rem;
        border-radius: 0.85rem;
        background: radial-gradient(circle at 30% 30%, #1e3a8a 0%, #0f172a 100%);
        border: 1px solid rgba(56, 189, 248, 0.4);
        display: grid;
        place-items: center;
        font-size: 1.5rem;
        box-shadow: 0 0 16px rgba(56, 189, 248, 0.2);
        flex-shrink: 0;
      }

      .site-titles {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
      }

      .site-title-row {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        flex-wrap: wrap;
      }

      .site-name {
        font-size: 1.4rem;
        font-weight: 800;
        margin: 0;
        color: #ffffff;
        letter-spacing: -0.02em;
      }

      .status-badge {
        font-size: 0.72rem;
        font-weight: 750;
        padding: 0.2rem 0.65rem;
        border-radius: 9999px;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
      }

      .status-badge.published {
        background: rgba(34, 197, 94, 0.15);
        color: #4ade80;
        border: 1px solid rgba(34, 197, 94, 0.35);
      }

      .status-pulse-dot {
        width: 0.45rem;
        height: 0.45rem;
        border-radius: 50%;
        background: #22c55e;
        box-shadow: 0 0 8px #22c55e;
      }

      .status-badge.draft {
        background: rgba(234, 179, 8, 0.15);
        color: #facc15;
        border: 1px solid rgba(234, 179, 8, 0.35);
      }

      .site-url-row {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        flex-wrap: wrap;
      }

      .site-slug-label {
