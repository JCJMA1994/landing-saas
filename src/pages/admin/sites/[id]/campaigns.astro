---
import { actions } from "astro:actions";
import { SupabaseCampaignRepository } from "../../../../infrastructure/supabase/campaign-repository";
import {
  CAMPAIGN_PRESETS,
  CAMPAIGN_INTENSITIES,
  CAMPAIGN_STATUSES,
} from "../../../../domain/campaign/campaign";
import { CAMPAIGN_PRESET_CONFIGS } from "../../../../domain/campaign/presets";
import SiteHeaderNav from "../../../../components/admin/SiteHeaderNav.astro";
import "../../../../styles/admin.css";

const logoutResult = Astro.getActionResult(actions.logout);
if (logoutResult?.data?.ok) return Astro.redirect("/admin/login", 303);

if (!Astro.locals.user) return Astro.redirect("/admin/login", 303);

const { id: siteId } = Astro.params;
if (!siteId) return Astro.redirect("/admin", 303);

// Fetch site details and verify tenant membership
const { data: siteData, error: siteError } = await Astro.locals.supabase
  .from("sites")
  .select("id, name, slug, tenant_id")
  .eq("id", siteId)
  .maybeSingle();

if (siteError || !siteData) {
  return Astro.redirect("/admin", 303);
}

const campaignRepo = new SupabaseCampaignRepository(Astro.locals.supabase);
const campaigns = await campaignRepo.listCampaigns(siteId);

const saveResult = Astro.getActionResult(actions.saveCampaign);
const deleteResult = Astro.getActionResult(actions.deleteCampaign);

const isSuccess = Boolean(saveResult?.data?.ok || deleteResult?.data?.ok);
const errorMessage =
  (saveResult && !saveResult.data?.ok ? saveResult.data?.error : null) ||
  (deleteResult && !deleteResult.data?.ok ? deleteResult.data?.error : null);

// Defaults for new campaign
const now = new Date();
const defaultStartsAt = now.toISOString().slice(0, 16);
const defaultEndsAt = new Date(now.getTime() + 7 * 24 * 60 * 60 * 1000).toISOString().slice(0, 16);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Motor de Campañas | {siteData.name}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <header class="shell topbar">
      <a href="/admin" style="text-decoration: none; color: #ffffff; display: flex; align-items: center; gap: .5rem; font-weight: 800; font-size: 1.1rem;">
        <span style="color: #ffffff;">Launch<span style="color: #38bdf8;">Pulse</span></span>
      </a>
      <nav aria-label="Admin navigation">
        <ul class="nav-links">
          <li><a href="/admin" class="nav-link active">Sitios</a></li>
          <li><a href="/admin/members" class="nav-link">Equipo</a></li>
          <li><a href="/admin/billing" class="nav-link">Suscripción</a></li>
        </ul>
      </nav>
      <form method="POST" action={actions.logout}>
        <button type="submit">Salir</button>
      </form>
    </header>

    <main class="shell dashboard">
      <SiteHeaderNav
        siteId={siteId}
        siteName={siteData.name}
        activeTab="campaigns"
      />

      <div style="margin-bottom: 1.5rem;">
        <h1 style="font-size: clamp(1.4rem, 3.5vw, 2.2rem); font-weight: 800; color: #f8fafc; margin: 0 0 0.4rem; letter-spacing: -0.02em; line-height: 1.15;">Campañas Estacionales</h1>
        <p class="muted" style="max-width: 44rem; margin: 0; font-size: 0.88rem; line-height: 1.5;">
          Programa ofertas temporales (Black Friday, Cyber, Verano) que se activen automáticamente según la fecha o enlaces UTM.
        </p>
      </div>

      {isSuccess && (
        <p class="badge" style="background: #1e4620; color: #a3e9a4; padding: .75rem 1rem; display: block; margin-bottom: 1.5rem;" role="status">
          Operación de campaña realizada exitosamente.
        </p>
      )}
      {errorMessage && <p class="error" role="alert">{errorMessage}</p>}

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr)); gap: 2rem; margin-bottom: 3rem; align-items: start;">
        <!-- Form Section -->
        <section class="panel" style="width: 100%;" aria-labelledby="create-campaign-title">
          <h2 id="create-campaign-title" style="margin-top: 0; font-size: 1.25rem;">Programar Nueva Campaña</h2>
          <form method="POST" action={actions.saveCampaign}>
            <input type="hidden" name="siteId" value={siteId} />
            <input type="hidden" name="tenantId" value={siteData.tenant_id} />

            <div class="field">
              <label for="name">Nombre de la Campaña</label>
              <input id="name" name="name" type="text" required maxlength="100" placeholder="e.g. Fiestas Patrias 2026" />
            </div>

            <div class="field">
              <label for="preset">Preset Estacional</label>
              <select id="preset" name="preset" required>
                {CAMPAIGN_PRESETS.map((p) => {
                  const cfg = CAMPAIGN_PRESET_CONFIGS[p];
                  return <option value={p}>{cfg.seasonalEmoji} {cfg.displayName}</option>;
                })}
              </select>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
              <div class="field">
                <label for="intensity">Intensidad</label>
                <select id="intensity" name="intensity" required>
                  {CAMPAIGN_INTENSITIES.map((i) => (
                    <option value={i} selected={i === "balanced"}>{i}</option>
                  ))}
                </select>
              </div>

              <div class="field">
                <label for="status">Estado</label>
                <select id="status" name="status" required>
                  {CAMPAIGN_STATUSES.map((s) => (
                    <option value={s} selected={s === "scheduled"}>{s}</option>
                  ))}
                </select>
              </div>
            </div>

            <div class="field">
              <label for="priority">Prioridad (Mayor número = Mayor precedencia)</label>
              <input id="priority" name="priority" type="number" value="10" min="0" max="1000" />
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
              <div class="field">
                <label for="startsAt">Fecha Inicio</label>
                <input id="startsAt" name="startsAt" type="datetime-local" required value={defaultStartsAt} />
              </div>

              <div class="field">
                <label for="endsAt">Fecha Fin</label>
                <input id="endsAt" name="endsAt" type="datetime-local" required value={defaultEndsAt} />
              </div>
            </div>

            <div class="field">
              <label for="bannerText">Texto del Banner (Opcional)</label>
              <input id="bannerText" name="bannerText" type="text" maxlength="200" placeholder="e.g. 20% de descuento en diagnósticos" />
            </div>

            <div class="field">
              <label for="bannerLink">Enlace del Banner (Opcional)</label>
              <input id="bannerLink" name="bannerLink" type="text" maxlength="300" placeholder="#promociones" />
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
              <div class="field">
                <label for="badgeText">Badge de Hero</label>
                <input id="badgeText" name="badgeText" type="text" maxlength="50" placeholder="e.g. Especial Julio" />
              </div>

              <div class="field">
                <label for="accentColor">Color de Acento (Hex)</label>
                <input id="accentColor" name="accentColor" type="text" maxlength="20" placeholder="#dc2626" />
              </div>
            </div>

            <div style="margin: 1.25rem 0; display: flex; align-items: center; gap: 0.6rem;">
              <input id="showCountdown" name="showCountdown" type="checkbox" style="width: auto;" />
              <label for="showCountdown" style="font-weight: 500;">Mostrar Countdown regresivo en Banner</label>
            </div>

            <button type="submit" class="button" style="width: 100%; margin-top: 1rem;">
              Guardar Campaña
            </button>
          </form>
        </section>

        <!-- Time-Travel Simulation Helper -->
        <section class="panel" style="width: 100%;">
          <h2 style="margin-top: 0; font-size: 1.25rem;">Simulación Temporal (Time-Travel)</h2>
          <p class="muted" style="font-size: 0.9rem;">
            Verifica cómo lucirá tu landing en fechas futuras sin esperar a que inicie la campaña ni alterar la producción activa.
          </p>

          <form action={`/preview/${siteId}`} method="GET" target="_blank" style="margin-top: 1.5rem;">
            <div class="field">
              <label for="simulateDate">Simular Fecha y Hora</label>
              <input id="simulateDate" name="simulateDate" type="datetime-local" required value={defaultStartsAt} />
            </div>
            <button type="submit" class="button" style="background: #233e66; color: #91b7ff; width: 100%;">
              Probar Landing en Fecha Simulada ↗
            </button>
          </form>
        </section>
      </div>

      <!-- Campaign List Section -->
      <section>
        <h2 style="margin-top: 0; font-size: 1.4rem;">Campañas Configuradas ({campaigns.length})</h2>
        <p class="muted" style="margin-top: 0; margin-bottom: 1.5rem; font-size: 0.9rem;">
          La campaña ganadora en cualquier momento se determina determinísticamente por: estado activo/programado + rango de fechas + prioridad más alta.
        </p>

        {campaigns.length === 0 ? (
          <div class="empty">
            No hay campañas configuradas para este sitio aún. Crea tu primera campaña arriba.
          </div>
        ) : (
          <div style="overflow-x: auto;">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Campaña</th>
                  <th>Preset</th>
                  <th>Intensidad</th>
                  <th>Prioridad</th>
                  <th>Ventana de Tiempo</th>
                  <th>Estado</th>
                  <th>Acciones</th>
                </tr>
              </thead>
              <tbody>
                {campaigns.map((camp) => {
                  const cfg = CAMPAIGN_PRESET_CONFIGS[camp.preset];
                  const startDateStr = new Date(camp.startsAt).toLocaleDateString();
                  const endDateStr = new Date(camp.endsAt).toLocaleDateString();
                  return (
                    <tr>
                      <td>
                        <strong style="color: #f5f7ff; display: block;">{camp.name}</strong>
                        {camp.bannerText && (
                          <span class="muted" style="font-size: 0.8rem;">
                            "{camp.bannerText}"
                          </span>
                        )}
                      </td>
                      <td>
                        <span class="badge" style="background: #172a55; color: #91b7ff;">
                          {cfg.seasonalEmoji} {cfg.displayName}
                        </span>
                      </td>
                      <td>
                        <span class="badge">{camp.intensity}</span>
                      </td>
                      <td>
                        <strong>{camp.priority}</strong>
                      </td>
                      <td style="font-size: 0.85rem;">
                        {startDateStr} &rarr; {endDateStr}
                      </td>
                      <td>
                        <span
                          class="badge"
                          style={
                            camp.status === "active"
                              ? "background: #1e4620; color: #a3e9a4;"
                              : camp.status === "scheduled"
                                ? "background: #4a3818; color: #ffd57a;"
                                : "background: #1b263b; color: #8292b3;"
                          }
                        >
                          {camp.status}
                        </span>
                      </td>
                      <td>
                        <form method="POST" action={actions.deleteCampaign} style="margin: 0;">
                          <input type="hidden" name="id" value={camp.id} />
                          <input type="hidden" name="siteId" value={siteId} />
                          <input type="hidden" name="tenantId" value={siteData.tenant_id} />
                          <button
                            type="submit"
                            class="button-danger"
                            style="padding: 0.35rem 0.65rem; font-size: 0.8rem;"
                            onclick="return confirm('¿Eliminar esta campaña?');"
                          >
                            Eliminar
                          </button>
                        </form>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        )}
      </section>
    </main>
  </body>
</html>
