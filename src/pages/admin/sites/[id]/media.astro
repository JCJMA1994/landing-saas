---
import { actions } from "astro:actions";
import { SupabaseMediaRepository } from "../../../../infrastructure/supabase/media-repository";
import { SupabaseStorageGateway } from "../../../../infrastructure/supabase/storage-gateway";
import type { MediaAsset } from "../../../../domain/site/media";
import SiteHeaderNav from "../../../../components/admin/SiteHeaderNav.astro";
import "../../../../styles/admin.css";

const logoutResult = Astro.getActionResult(actions.logout);
if (logoutResult?.data?.ok) return Astro.redirect("/admin/login", 303);

if (!Astro.locals.user) return Astro.redirect("/admin/login", 303);

const { id: siteId } = Astro.params;
if (!siteId) return Astro.redirect("/admin", 303);

// Fetch site details and verify tenant membership
const { data: siteData, error: siteError } = await Astro.locals.supabase
  .from("sites")
  .select("id, name, slug, tenant_id")
  .eq("id", siteId)
  .maybeSingle();

if (siteError || !siteData) {
  return Astro.redirect("/admin", 303);
}

const mediaRepo = new SupabaseMediaRepository(Astro.locals.supabase);
const storageGateway = new SupabaseStorageGateway(Astro.locals.supabase);
const assets: MediaAsset[] = await mediaRepo.listBySite(siteId);

const uploadResult = Astro.getActionResult(actions.uploadMediaAsset);
const deleteResult = Astro.getActionResult(actions.deleteMediaAsset);

const isSuccess = Boolean((uploadResult?.data && uploadResult.data.ok) || (deleteResult?.data && deleteResult.data.ok));
const errorMessage = uploadResult && !uploadResult.data?.ok 
  ? uploadResult.data?.error 
  : deleteResult && !deleteResult.data?.ok 
  ? deleteResult.data?.error 
  : null;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Galería Multimedia (Borrador) | {siteData.name}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <header class="shell topbar">
      <a href="/admin" style="text-decoration: none; color: #ffffff; display: flex; align-items: center; gap: .5rem; font-weight: 800; font-size: 1.1rem;">
        <span style="color: #ffffff;">Launch<span style="color: #38bdf8;">Pulse</span></span>
      </a>
      <nav aria-label="Admin navigation">
        <ul class="nav-links">
          <li><a href="/admin" class="nav-link active">Sitios</a></li>
          <li><a href="/admin/members" class="nav-link">Equipo</a></li>
          <li><a href="/admin/billing" class="nav-link">Suscripción</a></li>
        </ul>
      </nav>
      <form method="POST" action={actions.logout}>
        <button type="submit">Salir</button>
      </form>
    </header>

    <main class="shell dashboard">
      <SiteHeaderNav
        siteId={siteId}
        siteName={siteData.name}
        activeTab="media"
      />

      <div style="margin-bottom: 1.5rem;">
        <h1 style="font-size: clamp(1.4rem, 3.5vw, 2.2rem); font-weight: 800; color: #f8fafc; margin: 0 0 0.4rem; letter-spacing: -0.02em; line-height: 1.15;">Identidad y Medios</h1>
        <p class="muted" style="max-width: 44rem; margin: 0; font-size: 0.88rem; line-height: 1.5;">
          Sube tus logos, favicon e imágenes para que tus plantillas luzcan profesionales y representen tu marca.
        </p>
      </div>

      {isSuccess && <p class="badge" style="background: #1e4620; color: #a3e9a4; padding: .75rem 1rem; display: block; margin-bottom: 1.5rem;" role="status">Archivo multimedia subido o eliminado con éxito.</p>}
      {errorMessage && <p class="error" role="alert">{errorMessage}</p>}

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr)); gap: 2rem; align-items: start;">
        <section class="panel" style="width: 100%;" aria-labelledby="upload-asset-title">
          <h2 id="upload-asset-title" style="margin-top: 0;">Subir Nuevo Archivo</h2>
          <form method="POST" action={actions.uploadMediaAsset} enctype="multipart/form-data">
            <input type="hidden" name="siteId" value={siteId} />
            <input type="hidden" name="tenantId" value={siteData.tenant_id} />

            <div class="field">
              <label for="file">Seleccionar Imagen (JPEG, PNG, WebP &bull; Máx. 5MB)</label>
              <input id="file" name="file" type="file" accept="image/jpeg,image/png,image/webp" required />
            </div>

            <div class="field">
              <label for="altText">Texto Alternativo Accesible (Máx. 160 caracteres)</label>
              <input id="altText" name="altText" type="text" required maxlength="160" placeholder="Describí qué muestra esta imagen..." />
            </div>

            <button type="submit" style="margin-top: 1rem;">Subir Archivo (Borrador)</button>
          </form>
        </section>

        <section aria-labelledby="assets-list-title">
          <h2 id="assets-list-title" style="margin-top: 0;">Archivos Subidos ({assets.length})</h2>
          {assets.length === 0 ? (
            <p class="empty">No hay archivos multimedia subidos para este sitio todavía.</p>
          ) : (
            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr)); gap: 1rem;">
              {assets.map((asset) => {
                const url = storageGateway.getUrl(asset.filePath);
                return (
                  <div class="site-card" style="padding: 1rem; display: flex; flex-direction: column; justify-content: space-between;">
                    <div>
                      <div style="width: 100%; height: 8rem; background: #0c1426; border-radius: .5rem; overflow: hidden; display: grid; place-items: center; border: 1px solid #293958;">
                        <img src={url} alt={asset.altText} style="width: 100%; height: 100%; object-fit: cover;" loading="lazy" />
                      </div>
                      <p style="font-size: .8rem; margin: .5rem 0 .25rem; font-weight: 700; word-break: break-all;">{asset.altText}</p>
                      <p class="muted" style="font-size: .75rem; margin: 0;">{(asset.fileSizeBytes / 1024).toFixed(1)} KB &bull; {asset.mimeType.split('/')[1]}</p>
                    </div>
                    {asset.id && (
                      <form method="POST" action={actions.deleteMediaAsset} style="margin-top: 1rem;">
                        <input type="hidden" name="siteId" value={siteId} />
                        <input type="hidden" name="tenantId" value={siteData.tenant_id} />
                        <input type="hidden" name="assetId" value={asset.id} />
                        <button type="submit" class="button-danger" style="padding: .4rem .75rem; font-size: .85rem; width: 100%;" onclick="return confirm('¿Eliminar este archivo?');">Eliminar</button>
                      </form>
                    )}
                  </div>
                );
              })}
            </div>
          )}
          <div style="margin-top: 2rem; display: flex; justify-content: space-between; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
            <a href={`/admin/sites/${siteId}/cards`} class="nav-link">&larr; Paso 3: Servicios</a>
            <a href={`/admin/sites/${siteId}/contacts`} class="button" style="background: #0284c7; color: #fff; text-decoration: none; font-size: 0.85rem;">
              Omitir / Siguiente Paso &rarr;
            </a>
          </div>
        </section>
      </div>

      <div style="margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid #293958; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
        <span class="muted" style="font-size: 0.9rem;">
          ¿Imágenes listas? Continúa para configurar tus vías de contacto y botón de WhatsApp.
        </span>
        <div style="display: flex; gap: 0.75rem;">
          <a href={`/admin/sites/${siteId}/cards`} class="button" style="background: #1e293b; color: #94a3b8; text-decoration: none; border: 1px solid #334155;">
            &larr; Paso Anterior
          </a>
          <a href={`/admin/sites/${siteId}/contacts`} class="button" style="background: #0284c7; color: #ffffff; text-decoration: none; font-weight: 700;">
            Continuar al Paso 5: Contacto & Redes &rarr;
          </a>
        </div>
      </div>
    </main>
  </body>
</html>
