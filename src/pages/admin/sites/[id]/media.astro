---
import { actions } from "astro:actions";
import { SupabaseMediaRepository } from "../../../../infrastructure/supabase/media-repository";
import { SupabaseStorageGateway } from "../../../../infrastructure/supabase/storage-gateway";
import type { MediaAsset } from "../../../../domain/site/media";
import "../../../../styles/admin.css";

const logoutResult = Astro.getActionResult(actions.logout);
if (logoutResult?.data?.ok) return Astro.redirect("/admin/login", 303);

const { id: siteId } = Astro.params;
if (!siteId) return Astro.redirect("/admin", 303);

const { data: siteData, error: siteError } = await Astro.locals.supabase
  .from("sites")
  .select("id, name, slug, tenant_id")
  .eq("id", siteId)
  .maybeSingle();

if (siteError || !siteData) {
  return Astro.redirect("/admin", 303);
}

const mediaRepo = new SupabaseMediaRepository(Astro.locals.supabase);
const storageGateway = new SupabaseStorageGateway(Astro.locals.supabase);
const assets: MediaAsset[] = await mediaRepo.listBySite(siteId);

const uploadResult = Astro.getActionResult(actions.uploadMediaAsset);
const deleteResult = Astro.getActionResult(actions.deleteMediaAsset);

const errorMessage =
  (uploadResult && !uploadResult.data?.ok ? uploadResult.data?.error : null) ??
  (deleteResult && !deleteResult.data?.ok ? deleteResult.data?.error : null);
const isSuccess = Boolean(uploadResult?.data?.ok || deleteResult?.data?.ok);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Media & Assets (Draft) | {siteData.name}</title>
  </head>
  <body>
    <header class="shell topbar">
      <strong>Landing SaaS</strong>
      <nav aria-label="Admin navigation">
        <ul class="nav-links">
          <li><a href="/admin" class="nav-link active">Sites</a></li>
          <li><a href="/admin/members" class="nav-link">Members</a></li>
        </ul>
      </nav>
      <form method="POST" action={actions.logout}>
        <button type="submit">Sign out</button>
      </form>
    </header>

    <main class="shell dashboard">
      <p class="eyebrow">Site Storage &bull; <span class="badge" style="background: #e5a93c; color: #1c1103;">Draft Mode</span></p>
      <h1>{siteData.name} &mdash; Media Assets</h1>
      <p class="muted">Upload and manage visual assets (JPEG, PNG, WebP &bull; Max 5MB per file).</p>

      <nav aria-label="Site sections" style="margin-bottom: 2rem;">
        <ul class="nav-links" style="border-bottom: 1px solid #293958; padding-bottom: .75rem;">
          <li><a href={`/admin/sites/${siteId}/template`} class="nav-link">Template</a></li>
          <li><a href={`/admin/sites/${siteId}/theme`} class="nav-link">Theme</a></li>
          <li><a href={`/admin/sites/${siteId}/hero`} class="nav-link">Hero</a></li>
          <li><a href={`/admin/sites/${siteId}/cards`} class="nav-link">Cards</a></li>
          <li><a href={`/admin/sites/${siteId}/promotions`} class="nav-link">Promotions</a></li>
          <li><a href={`/admin/sites/${siteId}/contacts`} class="nav-link">Contacts</a></li>
          <li><a href={`/admin/sites/${siteId}/media`} class="nav-link active">Media</a></li>
          <li><a href={`/admin/sites/${siteId}/campaigns`} class="nav-link">Campaigns</a></li>
          <li><a href={`/admin/sites/${siteId}/publish`} class="nav-link">Publish & History</a></li>
          <li><a href={`/preview/${siteId}`} target="_blank" class="nav-link" style="color: #ffd57a;">Preview ↗</a></li>
        </ul>
      </nav>

      {isSuccess && <p class="badge" style="background: #1e4620; color: #a3e9a4; padding: .75rem 1rem; display: block; margin-bottom: 1.5rem;" role="status">Asset uploaded or removed successfully.</p>}
      {errorMessage && <p class="error" role="alert">{errorMessage}</p>}

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr)); gap: 2rem; align-items: start;">
        <section class="panel" style="width: 100%;" aria-labelledby="upload-asset-title">
          <h2 id="upload-asset-title" style="margin-top: 0;">Upload New Asset</h2>
          <form method="POST" action={actions.uploadMediaAsset} enctype="multipart/form-data">
            <input type="hidden" name="siteId" value={siteId} />
            <input type="hidden" name="tenantId" value={siteData.tenant_id} />

            <div class="field">
              <label for="file">Select Image (JPEG, PNG, WebP &bull; Max 5MB)</label>
              <input id="file" name="file" type="file" accept="image/jpeg,image/png,image/webp" required />
            </div>

            <div class="field">
              <label for="altText">Accessibility Alt Text (Max 160 chars)</label>
              <input id="altText" name="altText" type="text" required maxlength="160" placeholder="Describe the image content..." />
            </div>

            <button type="submit" style="margin-top: 1rem;">Upload Image (Draft)</button>
          </form>
        </section>

        <section aria-labelledby="assets-list-title">
          <h2 id="assets-list-title" style="margin-top: 0;">Uploaded Assets ({assets.length})</h2>
          {assets.length === 0 ? (
            <p class="empty">No assets uploaded yet for this site.</p>
          ) : (
            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr)); gap: 1rem;">
              {assets.map((asset) => {
                const url = storageGateway.getUrl(asset.filePath);
                return (
                  <div class="site-card" style="padding: 1rem; display: flex; flex-direction: column; justify-content: space-between;">
                    <div>
                      <div style="width: 100%; height: 8rem; background: #0c1426; border-radius: .5rem; overflow: hidden; display: grid; place-items: center; border: 1px solid #293958;">
                        <img src={url} alt={asset.altText} style="width: 100%; height: 100%; object-fit: cover;" loading="lazy" />
                      </div>
                      <p style="font-size: .8rem; margin: .5rem 0 .25rem; font-weight: 700; word-break: break-all;">{asset.altText}</p>
                      <p class="muted" style="font-size: .75rem; margin: 0;">{(asset.fileSizeBytes / 1024).toFixed(1)} KB &bull; {asset.mimeType.split('/')[1]}</p>
                    </div>
                    {asset.id && (
                      <form method="POST" action={actions.deleteMediaAsset} style="margin-top: 1rem;">
                        <input type="hidden" name="siteId" value={siteId} />
                        <input type="hidden" name="tenantId" value={siteData.tenant_id} />
                        <input type="hidden" name="assetId" value={asset.id} />
                        <button type="submit" class="button-danger" style="width: 100%; padding: .4rem .5rem; font-size: .8rem;" onclick="return confirm('Delete this image?');">Delete</button>
                      </form>
                    )}
                  </div>
                );
              })}
            </div>
          )}
          <div style="margin-top: 2rem;">
            <a href="/admin" class="nav-link">&larr; Back to Sites</a>
          </div>
        </section>
      </div>
    </main>
  </body>
</html>
