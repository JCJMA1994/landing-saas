---
import { actions } from "astro:actions";
import { SupabaseHeroRepository } from "../../../../infrastructure/supabase/hero-repository";
import {
  DEFAULT_SITE_HERO,
  type SiteHero,
} from "../../../../domain/site/hero";
import "../../../../styles/admin.css";

const logoutResult = Astro.getActionResult(actions.logout);
if (logoutResult?.data?.ok) return Astro.redirect("/admin/login", 303);

const { id: siteId } = Astro.params;
if (!siteId) return Astro.redirect("/admin", 303);

// Fetch site details and verify tenant membership
const { data: siteData, error: siteError } = await Astro.locals.supabase
  .from("sites")
  .select("id, name, slug, tenant_id")
  .eq("id", siteId)
  .maybeSingle();

if (siteError || !siteData) {
  return Astro.redirect("/admin", 303);
}

const heroRepo = new SupabaseHeroRepository(Astro.locals.supabase);
const existingHero = await heroRepo.getHero(siteId);

const hero: SiteHero = existingHero ?? {
  siteId,
  ...DEFAULT_SITE_HERO,
};

const saveResult = Astro.getActionResult(actions.saveSiteHero);
const isSuccess = Boolean(saveResult?.data?.ok);
const errorMessage = saveResult && !saveResult.data?.ok ? saveResult.data?.error : null;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Hero Content (Draft) | {siteData.name}</title>
  </head>
  <body>
    <header class="shell topbar">
      <strong>Landing SaaS</strong>
      <nav aria-label="Admin navigation">
        <ul class="nav-links">
          <li><a href="/admin" class="nav-link active">Sites</a></li>
          <li><a href="/admin/members" class="nav-link">Members</a></li>
        </ul>
      </nav>
      <form method="POST" action={actions.logout}>
        <button type="submit">Sign out</button>
      </form>
    </header>

    <main class="shell dashboard">
      <p class="eyebrow">Site Content &bull; <span class="badge" style="background: #e5a93c; color: #1c1103;">Draft Mode</span></p>
      <h1>{siteData.name} &mdash; Hero Section</h1>
      <p class="muted">Craft the primary headline, message, and call to action. Saved as draft until publication.</p>

      <nav aria-label="Site sections" style="margin-bottom: 2rem;">
        <ul class="nav-links" style="border-bottom: 1px solid #293958; padding-bottom: .75rem;">
          <li><a href={`/admin/sites/${siteId}/template`} class="nav-link">Template</a></li>
          <li><a href={`/admin/sites/${siteId}/theme`} class="nav-link">Theme</a></li>
          <li><a href={`/admin/sites/${siteId}/hero`} class="nav-link active">Hero</a></li>
          <li><a href={`/admin/sites/${siteId}/cards`} class="nav-link">Cards</a></li>
          <li><a href={`/admin/sites/${siteId}/promotions`} class="nav-link">Promotions</a></li>
          <li><a href={`/admin/sites/${siteId}/contacts`} class="nav-link">Contacts</a></li>
          <li><a href={`/admin/sites/${siteId}/media`} class="nav-link">Media</a></li>
          <li><a href={`/admin/sites/${siteId}/campaigns`} class="nav-link">Campaigns</a></li>
          <li><a href={`/admin/sites/${siteId}/publish`} class="nav-link">Publish & History</a></li>
          <li><a href={`/preview/${siteId}`} target="_blank" class="nav-link" style="color: #ffd57a;">Preview ↗</a></li>
        </ul>
      </nav>

      {isSuccess && <p class="badge" style="background: #1e4620; color: #a3e9a4; padding: .75rem 1rem; display: block; margin-bottom: 1.5rem;" role="status">Hero draft saved successfully.</p>}
      {errorMessage && <p class="error" role="alert">{errorMessage}</p>}

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr)); gap: 2rem; align-items: start;">
        <section class="panel" style="width: 100%;" aria-labelledby="hero-form-title">
          <h2 id="hero-form-title" style="margin-top: 0;">Hero Copy & Action</h2>
          <form method="POST" action={actions.saveSiteHero}>
            <input type="hidden" name="siteId" value={siteId} />
            <input type="hidden" name="tenantId" value={siteData.tenant_id} />

            <div class="field">
              <label for="headline">Headline (Max 160 chars)</label>
              <input id="headline" name="headline" type="text" required maxlength="160" value={hero.headline} />
            </div>

            <div class="field">
              <label for="subheadline">Subheadline (Max 320 chars)</label>
              <input id="subheadline" name="subheadline" type="text" required maxlength="320" value={hero.subheadline} />
            </div>

            <div class="field">
              <label for="badgeText">Badge / Eyebrow (Optional)</label>
              <input id="badgeText" name="badgeText" type="text" maxlength="60" value={hero.badgeText ?? ""} />
            </div>

            <div class="field">
              <label for="ctaText">CTA Button Text (Max 40 chars)</label>
              <input id="ctaText" name="ctaText" type="text" required maxlength="40" value={hero.ctaText} />
            </div>

            <div class="field">
              <label for="ctaLink">CTA Button Link</label>
              <input id="ctaLink" name="ctaLink" type="text" required maxlength="256" placeholder="https://... or /contact or #plans" value={hero.ctaLink} />
            </div>

            <button type="submit" style="margin-top: 1rem;">Save Hero (Draft)</button>
          </form>
        </section>

        <aside class="panel" style="width: 100%;" aria-label="Hero Component Preview">
          <h2 style="margin-top: 0;">Component Preview</h2>
          <p class="muted">Live demonstration of how the hero appears.</p>
          <div style="padding: 2rem; border: 1px dashed #536483; border-radius: 1rem; margin-top: 1.5rem; background: #0c1426;">
            {hero.badgeText && <span class="eyebrow" style="display: block; margin-bottom: .5rem;">{hero.badgeText}</span>}
            <h3 style="font-size: 1.75rem; margin: .5rem 0 1rem; line-height: 1.2;">{hero.headline}</h3>
            <p class="muted" style="margin-bottom: 1.5rem;">{hero.subheadline}</p>
            <a href={hero.ctaLink} class="button" style="text-decoration: none; display: inline-block;">{hero.ctaText}</a>
          </div>
          <div style="margin-top: 2rem;">
            <a href="/admin" class="nav-link">&larr; Back to Sites</a>
          </div>
        </aside>
      </div>
    </main>
  </body>
</html>
