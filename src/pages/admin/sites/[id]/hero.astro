---
import { actions } from "astro:actions";
import { SupabaseHeroRepository } from "../../../../infrastructure/supabase/hero-repository";
import { SupabaseMediaRepository } from "../../../../infrastructure/supabase/media-repository";
import { SupabaseStorageGateway } from "../../../../infrastructure/supabase/storage-gateway";
import { DEFAULT_SITE_HERO } from "../../../../domain/site/hero";
import SiteHeaderNav from "../../../../components/admin/SiteHeaderNav.astro";
import "../../../../styles/admin.css";

const logoutResult = Astro.getActionResult(actions.logout);
if (logoutResult?.data?.ok) return Astro.redirect("/admin/login", 303);

if (!Astro.locals.user) return Astro.redirect("/admin/login", 303);

const { id: siteId } = Astro.params;
if (!siteId) return Astro.redirect("/admin", 303);

// Fetch site details and verify tenant membership
const { data: siteData, error: siteError } = await Astro.locals.supabase
  .from("sites")
  .select("id, name, slug, tenant_id")
  .eq("id", siteId)
  .maybeSingle();

if (siteError || !siteData) {
  return Astro.redirect("/admin", 303);
}

const heroRepo = new SupabaseHeroRepository(Astro.locals.supabase);
const existingHero = await heroRepo.getHero(siteId);
const hero = existingHero ?? { siteId, ...DEFAULT_SITE_HERO };

const mediaRepo = new SupabaseMediaRepository(Astro.locals.supabase);
const storageGateway = new SupabaseStorageGateway(Astro.locals.supabase);
const mediaAssets = await mediaRepo.listBySite(siteId);

const saveResult = Astro.getActionResult(actions.saveSiteHero);
const isSuccess = Boolean(saveResult?.data && saveResult.data.ok);
const errorMessage = saveResult && !saveResult.data?.ok ? saveResult.data?.error : null;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Hero Principal (Borrador) | {siteData.name}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <header class="shell topbar">
      <a href="/admin" style="text-decoration: none; color: #ffffff; display: flex; align-items: center; gap: .5rem; font-weight: 800; font-size: 1.1rem;">
        <span style="color: #ffffff;">Launch<span style="color: #38bdf8;">Pulse</span></span>
      </a>
      <nav aria-label="Admin navigation">
        <ul class="nav-links">
          <li><a href="/admin" class="nav-link active">Sitios</a></li>
          <li><a href="/admin/members" class="nav-link">Equipo</a></li>
          <li><a href="/admin/billing" class="nav-link">Suscripción</a></li>
        </ul>
      </nav>
      <form method="POST" action={actions.logout}>
        <button type="submit">Salir</button>
      </form>
    </header>

    <main class="shell dashboard">
      <SiteHeaderNav
        siteId={siteId}
        siteName={siteData.name}
        activeTab="hero"
      />

      <div style="margin-bottom: 1.5rem;">
        <h1 style="font-size: clamp(1.4rem, 3.5vw, 2.2rem); font-weight: 800; color: #f8fafc; margin: 0 0 0.4rem; letter-spacing: -0.02em; line-height: 1.15;">Encabezado Principal</h1>
        <p class="muted" style="max-width: 44rem; margin: 0; font-size: 0.88rem; line-height: 1.5;">
          Redacta el titular principal, la propuesta de valor y el botón de llamada a la acción que verán tus visitantes al entrar.
        </p>
      </div>

      {isSuccess && <p class="badge" style="background: #1e4620; color: #a3e9a4; padding: .75rem 1rem; display: block; margin-bottom: 1.5rem;" role="status">Borrador del Hero guardado con éxito.</p>}
      {errorMessage && <p class="error" role="alert">{errorMessage}</p>}

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr)); gap: 2rem; align-items: start;">
        <section class="panel" style="width: 100%;" aria-labelledby="hero-form-title">
          <h2 id="hero-form-title" style="margin-top: 0;">Textos y Acción del Hero</h2>
          <form method="POST" action={actions.saveSiteHero}>
            <input type="hidden" name="siteId" value={siteId} />
            <input type="hidden" name="tenantId" value={siteData.tenant_id} />

            <div class="field">
              <label for="headline">Titular Principal (Máx. 160 caracteres)</label>
              <input id="headline" name="headline" type="text" required maxlength="160" value={hero.headline} />
            </div>

            <div class="field">
              <label for="subheadline">Subtítulo Descriptivo (Máx. 320 caracteres)</label>
              <input id="subheadline" name="subheadline" type="text" required maxlength="320" value={hero.subheadline} />
            </div>

            <div class="field">
              <label for="badgeText">Insignia / Etiqueta Superior (Opcional, máx. 60 caracteres)</label>
              <input id="badgeText" name="badgeText" type="text" maxlength="60" value={hero.badgeText ?? ""} />
            </div>

            <div class="field">
              <label for="ctaText">Texto del Botón CTA (Máx. 40 caracteres)</label>
              <input id="ctaText" name="ctaText" type="text" required maxlength="40" value={hero.ctaText} />
            </div>

            <div class="field">
              <label for="ctaLink">Enlace del Botón CTA (ej. #contacto o enlace web)</label>
              <input id="ctaLink" name="ctaLink" type="text" required maxlength="256" placeholder="#contacto o https://..." value={hero.ctaLink} />
            </div>

            <div class="field">
              <label for="imageUrl">Imagen Visual del Hero (Opcional)</label>
              <input id="imageUrl" name="imageUrl" type="text" maxlength="512" placeholder="https://... o seleccioná abajo" value={hero.imageUrl ?? ""} />
              {mediaAssets.length > 0 && (
                <div style="margin-top: .75rem;">
                  <span style="font-size: .8rem; color: #94a3b8; display: block; margin-bottom: .5rem;">Hacé clic en una imagen para seleccionarla:</span>
                  <div style="display: flex; gap: .75rem; flex-wrap: wrap;">
                    {mediaAssets.map((asset) => {
                      const assetUrl = storageGateway.getUrl(asset.filePath);
                      return (
                        <button
                          type="button"
                          onclick={`document.getElementById('imageUrl').value = '${assetUrl}';`}
                          style="background: #0c1426; border: 1px solid #293958; border-radius: .4rem; padding: .25rem; cursor: pointer; display: flex; align-items: center; gap: .4rem;"
                          title={asset.altText}
                        >
                          <img src={assetUrl} alt={asset.altText} style="width: 2.5rem; height: 2.5rem; object-fit: cover; border-radius: .25rem;" />
                          <span style="font-size: .75rem; color: #f8fafc; max-width: 7rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">{asset.altText}</span>
                        </button>
                      );
                    })}
                  </div>
                </div>
              )}
            </div>

            <button type="submit" style="margin-top: 1rem;">Guardar Borrador del Hero</button>
          </form>
        </section>

        <aside class="panel" style="width: 100%;" aria-label="Vista Previa del Componente Hero">
          <h2 style="margin-top: 0;">Vista Previa del Componente</h2>
          <p class="muted">Demostración en vivo de cómo se verá el hero en tu landing.</p>
          <div style="padding: 2rem; border: 1px dashed #536483; border-radius: 1rem; margin-top: 1.5rem; background: #0c1426;">
            {hero.imageUrl && (
              <div style="margin-bottom: 1.5rem; border-radius: .5rem; overflow: hidden; border: 1px solid #293958; max-height: 14rem;">
                <img src={hero.imageUrl} alt="Vista previa Hero" style="width: 100%; height: 100%; object-fit: cover; display: block;" />
              </div>
            )}
            {hero.badgeText && <span class="eyebrow" style="display: block; margin-bottom: .5rem;">{hero.badgeText}</span>}
            <h3 style="font-size: 1.75rem; margin: .5rem 0 1rem; line-height: 1.2;">{hero.headline}</h3>
            <p class="muted" style="margin-bottom: 1.5rem;">{hero.subheadline}</p>
            <a href={hero.ctaLink} class="button" style="text-decoration: none; display: inline-block;">{hero.ctaText}</a>
          </div>
          <div style="margin-top: 2rem; display: flex; justify-content: space-between; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
            <a href={`/admin/sites/${siteId}/template`} class="nav-link">&larr; Paso 1: Plantilla</a>
            <a href={`/admin/sites/${siteId}/cards`} class="button" style="background: #0284c7; color: #fff; text-decoration: none; font-size: 0.85rem;">
              Omitir / Siguiente Paso &rarr;
            </a>
          </div>
        </aside>
      </div>

      <div style="margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid #293958; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
        <span class="muted" style="font-size: 0.9rem;">
          ¿Listo con el encabezado? Continúa para detallar tus servicios o tarjetas destacadas.
        </span>
        <div style="display: flex; gap: 0.75rem;">
          <a href={`/admin/sites/${siteId}/template`} class="button" style="background: #1e293b; color: #94a3b8; text-decoration: none; border: 1px solid #334155;">
            &larr; Paso Anterior
          </a>
          <a href={`/admin/sites/${siteId}/cards`} class="button" style="background: #0284c7; color: #ffffff; text-decoration: none; font-weight: 700;">
            Continuar al Paso 3: Servicios &rarr;
          </a>
        </div>
      </div>
    </main>
  </body>
</html>
