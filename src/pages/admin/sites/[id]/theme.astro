---
import { actions } from "astro:actions";
import { SupabaseThemeRepository } from "../../../../infrastructure/supabase/theme-repository";
import { SupabasePaletteRepository } from "../../../../infrastructure/supabase/palette-repository";
import {
  DEFAULT_SITE_THEME,
  THEME_BUTTON_VARIANTS,
  THEME_CARD_VARIANTS,
  THEME_FONTS,
  THEME_RADII,
  type SiteTheme,
} from "../../../../domain/site/theme";
import "../../../../styles/admin.css";

const logoutResult = Astro.getActionResult(actions.logout);
if (logoutResult?.data?.ok) return Astro.redirect("/admin/login", 303);

const { id: siteId } = Astro.params;
if (!siteId) return Astro.redirect("/admin", 303);

// Fetch site details and verify tenant membership
const { data: siteData, error: siteError } = await Astro.locals.supabase
  .from("sites")
  .select("id, name, slug, tenant_id")
  .eq("id", siteId)
  .maybeSingle();

if (siteError || !siteData) {
  return Astro.redirect("/admin", 303);
}

const themeRepo = new SupabaseThemeRepository(Astro.locals.supabase);
const paletteRepo = new SupabasePaletteRepository(Astro.locals.supabase);

const [existingTheme, platformPalettes] = await Promise.all([
  themeRepo.getTheme(siteId),
  paletteRepo.listPalettes(),
]);

const theme: SiteTheme = existingTheme ?? {
  siteId,
  ...DEFAULT_SITE_THEME,
};

const saveResult = Astro.getActionResult(actions.saveSiteTheme);
const isSuccess = Boolean(saveResult?.data?.ok);
const errorMessage = saveResult && !saveResult.data?.ok ? saveResult.data?.error : null;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Theme Settings (Draft) | {siteData.name}</title>
  </head>
  <body>
    <header class="shell topbar">
      <strong>Landing SaaS</strong>
      <nav aria-label="Admin navigation">
        <ul class="nav-links">
          <li><a href="/admin" class="nav-link active">Sites</a></li>
          <li><a href="/admin/members" class="nav-link">Members</a></li>
        </ul>
      </nav>
      <form method="POST" action={actions.logout}>
        <button type="submit">Sign out</button>
      </form>
    </header>

    <main class="shell dashboard">
      <p class="eyebrow">Site Configuration &bull; <span class="badge" style="background: #e5a93c; color: #1c1103;">Draft Mode</span></p>
      <h1>{siteData.name} &mdash; Theme Tokens</h1>
      <p class="muted">Configure base visual tokens and identity. Changes are saved as draft until published.</p>

      <nav aria-label="Site sections" style="margin-bottom: 2rem;">
        <ul class="nav-links" style="border-bottom: 1px solid #293958; padding-bottom: .75rem;">
          <li><a href={`/admin/sites/${siteId}/template`} class="nav-link">Template</a></li>
          <li><a href={`/admin/sites/${siteId}/theme`} class="nav-link active">Theme</a></li>
          <li><a href={`/admin/sites/${siteId}/hero`} class="nav-link">Hero</a></li>
          <li><a href={`/admin/sites/${siteId}/cards`} class="nav-link">Cards</a></li>
          <li><a href={`/admin/sites/${siteId}/promotions`} class="nav-link">Promotions</a></li>
          <li><a href={`/admin/sites/${siteId}/contacts`} class="nav-link">Contacts</a></li>
          <li><a href={`/admin/sites/${siteId}/media`} class="nav-link">Media</a></li>
          <li><a href={`/admin/sites/${siteId}/campaigns`} class="nav-link">Campaigns</a></li>
          <li><a href={`/admin/sites/${siteId}/publish`} class="nav-link">Publish & History</a></li>
          <li><a href={`/preview/${siteId}`} target="_blank" class="nav-link" style="color: #ffd57a;">Preview ↗</a></li>
        </ul>
      </nav>

      {isSuccess && <p class="badge" style="background: #1e4620; color: #a3e9a4; padding: .75rem 1rem; display: block; margin-bottom: 1.5rem;" role="status">Theme draft saved successfully.</p>}
      {errorMessage && <p class="error" role="alert">{errorMessage}</p>}

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr)); gap: 2rem; align-items: start;">
        <section class="panel" style="width: 100%;" aria-labelledby="theme-form-title">
          <h2 id="theme-form-title" style="margin-top: 0;">Color & Style Tokens</h2>
          <form method="POST" action={actions.saveSiteTheme}>
            <input type="hidden" name="siteId" value={siteId} />
            <input type="hidden" name="tenantId" value={siteData.tenant_id} />

            <!-- 1-Click Platform Palette Selector -->
            <div style="background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(56, 189, 248, 0.25); border-radius: 0.75rem; padding: 1.25rem; margin-bottom: 1.75rem;">
              <div style="margin-bottom: 0.75rem;">
                <strong style="font-size: 0.95rem; color: #f8fafc; display: block;">🎨 Paletas de Marca Globales (1-Clic)</strong>
                <span style="font-size: 0.78rem; color: #94a3b8;">Hacé clic en cualquier paleta para cargar automáticamente sus 5 colores en el formulario:</span>
              </div>

              <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 0.75rem;">
                {platformPalettes.map((p) => (
                  <button
                    type="button"
                    class="btn-apply-palette"
                    data-primary={p.primaryColor}
                    data-secondary={p.secondaryColor}
                    data-accent={p.accentColor}
                    data-bg={p.backgroundColor}
                    data-text={p.textColor}
                    style="display: flex; flex-direction: column; gap: 0.45rem; background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 0.5rem; padding: 0.65rem; cursor: pointer; text-align: left; transition: all 0.2s;"
                  >
                    <span style="font-size: 0.78rem; font-weight: 700; color: #f8fafc; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                      {p.name}
                    </span>
                    <div style="display: flex; gap: 2px; height: 14px; border-radius: 3px; overflow: hidden; width: 100%;">
                      <span style={`flex: 1; background: ${p.primaryColor};`}></span>
                      <span style={`flex: 1; background: ${p.secondaryColor};`}></span>
                      <span style={`flex: 1; background: ${p.accentColor};`}></span>
                      <span style={`flex: 1; background: ${p.backgroundColor}; border: 1px solid rgba(255,255,255,0.1);`}></span>
                      <span style={`flex: 1; background: ${p.textColor};`}></span>
                    </div>
                  </button>
                ))}
              </div>
            </div>

            <div class="field">
              <label for="primaryColor">Primary Color (Hex)</label>
              <input id="primaryColor" name="primaryColor" type="text" pattern="^#[0-9a-fA-F]{6}$" required value={theme.primaryColor} />
            </div>

            <div class="field">
              <label for="secondaryColor">Secondary Color (Hex)</label>
              <input id="secondaryColor" name="secondaryColor" type="text" pattern="^#[0-9a-fA-F]{6}$" required value={theme.secondaryColor} />
            </div>

            <div class="field">
              <label for="accentColor">Accent Color (Hex)</label>
              <input id="accentColor" name="accentColor" type="text" pattern="^#[0-9a-fA-F]{6}$" required value={theme.accentColor} />
            </div>

            <div class="field">
              <label for="backgroundColor">Background Color (Hex)</label>
              <input id="backgroundColor" name="backgroundColor" type="text" pattern="^#[0-9a-fA-F]{6}$" required value={theme.backgroundColor} />
            </div>

            <div class="field">
              <label for="textColor">Text Color (Hex)</label>
              <input id="textColor" name="textColor" type="text" pattern="^#[0-9a-fA-F]{6}$" required value={theme.textColor} />
            </div>

            <div class="field">
              <label for="fontKey">Typography</label>
              <select id="fontKey" name="fontKey" required>
                {THEME_FONTS.map((font) => (
                  <option value={font} selected={font === theme.fontKey}>{font}</option>
                ))}
              </select>
            </div>

            <div class="field">
              <label for="radiusKey">Corner Radius</label>
              <select id="radiusKey" name="radiusKey" required>
                {THEME_RADII.map((radius) => (
                  <option value={radius} selected={radius === theme.radiusKey}>{radius}</option>
                ))}
              </select>
            </div>

            <div class="field">
              <label for="buttonVariant">Button Style</label>
              <select id="buttonVariant" name="buttonVariant" required>
                {THEME_BUTTON_VARIANTS.map((variant) => (
                  <option value={variant} selected={variant === theme.buttonVariant}>{variant}</option>
                ))}
              </select>
            </div>

            <div class="field">
              <label for="cardVariant">Card Variant</label>
              <select id="cardVariant" name="cardVariant" required>
                {THEME_CARD_VARIANTS.map((variant) => (
                  <option value={variant} selected={variant === theme.cardVariant}>{variant}</option>
                ))}
              </select>
            </div>

            <button type="submit" style="margin-top: 1rem;">Save Theme (Draft)</button>
          </form>
        </section>

        <aside class="panel" style="width: 100%;" aria-label="Palette Preview">
          <h2 style="margin-top: 0;">Visual Tokens Preview</h2>
          <p class="muted">Live preview of selected brand palette tokens.</p>
          <div style="display: grid; gap: 1rem; margin-top: 1.5rem;">
            <div id="live-theme-preview-box" style={`background: ${theme.backgroundColor}; color: ${theme.textColor}; padding: 1.5rem; border: 1px solid #304365; border-radius: .75rem; transition: all 0.25s;`}>
              <h3 id="preview-brand-h3" style={`color: ${theme.primaryColor}; margin-top: 0;`}>Brand Heading</h3>
              <p id="preview-brand-p" style="margin-bottom: 1rem;">Sample text rendered with selected background and text contrast tokens.</p>
              <div style="display: flex; gap: .75rem; align-items: center; flex-wrap: wrap;">
                <span id="preview-brand-primary-btn" style={`background: ${theme.primaryColor}; color: #ffffff; padding: .5rem 1rem; border-radius: .5rem; font-weight: 700;`}>Primary</span>
                <span id="preview-brand-secondary-btn" style={`background: ${theme.secondaryColor}; color: #ffffff; padding: .5rem 1rem; border-radius: .5rem; font-weight: 700;`}>Secondary</span>
                <span id="preview-brand-accent-btn" style={`background: ${theme.accentColor}; color: #000000; padding: .5rem 1rem; border-radius: .5rem; font-weight: 700;`}>Accent</span>
              </div>
            </div>
          </div>
          <div style="margin-top: 2rem;">
            <a href="/admin" class="nav-link">&larr; Back to Sites</a>
          </div>
        </aside>
      </div>
    </main>

    <script>
      const primaryInput = document.getElementById("primaryColor") as HTMLInputElement | null;
      const secondaryInput = document.getElementById("secondaryColor") as HTMLInputElement | null;
      const accentInput = document.getElementById("accentColor") as HTMLInputElement | null;
      const bgInput = document.getElementById("backgroundColor") as HTMLInputElement | null;
      const textInput = document.getElementById("textColor") as HTMLInputElement | null;

      const previewBox = document.getElementById("live-theme-preview-box");
      const previewH3 = document.getElementById("preview-brand-h3");
      const previewPrimary = document.getElementById("preview-brand-primary-btn");
      const previewSecondary = document.getElementById("preview-brand-secondary-btn");
      const previewAccent = document.getElementById("preview-brand-accent-btn");

      function updateLiveTokens() {
        if (!previewBox || !primaryInput || !secondaryInput || !accentInput || !bgInput || !textInput) return;
        previewBox.style.backgroundColor = bgInput.value;
        previewBox.style.color = textInput.value;
        if (previewH3) previewH3.style.color = primaryInput.value;
        if (previewPrimary) previewPrimary.style.backgroundColor = primaryInput.value;
        if (previewSecondary) previewSecondary.style.backgroundColor = secondaryInput.value;
        if (previewAccent) previewAccent.style.backgroundColor = accentInput.value;
      }

      [primaryInput, secondaryInput, accentInput, bgInput, textInput].forEach((input) => {
        input?.addEventListener("input", updateLiveTokens);
      });

      // Palette buttons click
      const paletteBtns = document.querySelectorAll<HTMLButtonElement>(".btn-apply-palette");
      paletteBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
          if (primaryInput && btn.dataset.primary) primaryInput.value = btn.dataset.primary;
          if (secondaryInput && btn.dataset.secondary) secondaryInput.value = btn.dataset.secondary;
          if (accentInput && btn.dataset.accent) accentInput.value = btn.dataset.accent;
          if (bgInput && btn.dataset.bg) bgInput.value = btn.dataset.bg;
          if (textInput && btn.dataset.text) textInput.value = btn.dataset.text;
          updateLiveTokens();
        });
      });
    </script>
  </body>
</html>
