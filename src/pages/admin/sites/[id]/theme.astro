---
import { actions } from "astro:actions";
import { SupabaseThemeRepository } from "../../../../infrastructure/supabase/theme-repository";
import { SupabasePaletteRepository } from "../../../../infrastructure/supabase/palette-repository";
import { SupabaseMediaRepository } from "../../../../infrastructure/supabase/media-repository";
import { SupabaseStorageGateway } from "../../../../infrastructure/supabase/storage-gateway";
import {
  DEFAULT_SITE_THEME,
  THEME_BUTTON_VARIANTS,
  THEME_CARD_VARIANTS,
  THEME_FONTS,
  THEME_RADII,
  type SiteTheme,
} from "../../../../domain/site/theme";
import SiteHeaderNav from "../../../../components/admin/SiteHeaderNav.astro";
import "../../../../styles/admin.css";

const logoutResult = Astro.getActionResult(actions.logout);
if (logoutResult?.data?.ok) return Astro.redirect("/admin/login", 303);

const { id: siteId } = Astro.params;
if (!siteId) return Astro.redirect("/admin", 303);

// Fetch site details and verify tenant membership
const { data: siteData, error: siteError } = await Astro.locals.supabase
  .from("sites")
  .select("id, name, slug, tenant_id")
  .eq("id", siteId)
  .maybeSingle();

if (siteError || !siteData) {
  return Astro.redirect("/admin", 303);
}

const themeRepo = new SupabaseThemeRepository(Astro.locals.supabase);
const paletteRepo = new SupabasePaletteRepository(Astro.locals.supabase);
const mediaRepo = new SupabaseMediaRepository(Astro.locals.supabase);
const storageGateway = new SupabaseStorageGateway(Astro.locals.supabase);

const [existingTheme, platformPalettes, mediaAssets] = await Promise.all([
  themeRepo.getTheme(siteId),
  paletteRepo.listPalettes(),
  mediaRepo.listBySite(siteId),
]);

const theme: SiteTheme = existingTheme ?? {
  siteId,
  ...DEFAULT_SITE_THEME,
};

const saveResult = Astro.getActionResult(actions.saveSiteTheme);
const isSuccess = Boolean(saveResult?.data?.ok);
const errorMessage = saveResult && !saveResult.data?.ok ? saveResult.data?.error : null;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Theme Settings (Draft) | {siteData.name}</title>
  </head>
  <body>
    <header class="shell topbar">
      <a href="/admin" style="text-decoration: none; color: #ffffff; display: flex; align-items: center; gap: .5rem; font-weight: 800; font-size: 1.1rem;">
        <span style="color: #ffffff;">Launch<span style="color: #38bdf8;">Pulse</span></span>
      </a>
      <nav aria-label="Admin navigation">
        <ul class="nav-links">
          <li><a href="/admin" class="nav-link active">Sitios</a></li>
          <li><a href="/admin/members" class="nav-link">Equipo</a></li>
          <li><a href="/admin/billing" class="nav-link">Suscripción</a></li>
        </ul>
      </nav>
      <form method="POST" action={actions.logout}>
        <button type="submit">Salir</button>
      </form>
    </header>

    <main class="shell dashboard">
      <SiteHeaderNav
        siteId={siteId}
        siteName={siteData.name}
        activeTab="theme"
      />

      <div style="margin-bottom: 2rem;">
        <p class="eyebrow" style="color: #38bdf8;">Paso 1 de 7 &bull; Colores y Tipografía</p>
        <h1 style="font-size: clamp(1.8rem, 4vw, 2.5rem); margin: 0.25rem 0 0.5rem;">{siteData.name} &mdash; Tema & Colores</h1>
        <p class="muted" style="max-width: 48rem; margin: 0;">
          Configura la paleta de colores y estilos de tu marca. Todos los ajustes se guardan en borrador de forma segura para no afectar tu versión pública hasta que decidas publicar.
        </p>
      </div>

      {isSuccess && <p class="badge" style="background: #1e4620; color: #a3e9a4; padding: .75rem 1rem; display: block; margin-bottom: 1.5rem;" role="status">Theme draft saved successfully.</p>}
      {errorMessage && <p class="error" role="alert">{errorMessage}</p>}

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr)); gap: 2rem; align-items: start;">
        <section class="panel" style="width: 100%;" aria-labelledby="theme-form-title">
          <h2 id="theme-form-title" style="margin-top: 0;">Color & Style Tokens</h2>
          <form method="POST" action={actions.saveSiteTheme}>
            <input type="hidden" name="siteId" value={siteId} />
            <input type="hidden" name="tenantId" value={siteData.tenant_id} />

            <!-- IDENTIDAD DE MARCA & LOGOS -->
            <div style="background: rgba(15, 23, 42, 0.7); border: 1px solid rgba(56, 189, 248, 0.3); border-radius: 0.75rem; padding: 1.25rem; margin-bottom: 1.75rem;">
              <h3 style="margin: 0 0 0.4rem 0; font-size: 1.05rem; color: #38bdf8; display: flex; align-items: center; gap: 0.5rem;">
                🛡️ Identidad de Marca (Logo & Favicon)
              </h3>
              <p style="font-size: 0.82rem; color: #94a3b8; margin: 0 0 1.25rem 0; line-height: 1.4;">
                Diferenciá los elementos de tu marca: el <strong>Logo</strong> aparece en el encabezado de navegación, mientras que el <strong>Favicon</strong> es el icono 1:1 de la pestaña del navegador. Ninguno de estos utiliza la ilustración del Hero.
              </p>

              <!-- Logo de Marca -->
              <div class="field" style="margin-bottom: 1.25rem;">
                <label for="logoUrl" style="display: flex; justify-content: space-between; align-items: center;">
                  <span>Logo de Marca (Barra de Navegación)</span>
                  <span style="font-size: 0.75rem; color: #38bdf8; font-weight: normal;">Recomendado: horizontal o transparente</span>
                </label>
                <div style="display: flex; gap: 0.5rem;">
                  <input
                    id="logoUrl"
                    name="logoUrl"
                    type="text"
                    maxlength="512"
                    placeholder="https://... o seleccioná de tus archivos"
                    value={theme.logoUrl ?? ""}
                    style="flex: 1;"
                  />
                  <button
                    type="button"
                    onclick="const el = document.getElementById('logoUrl'); if (el) { el.value = ''; el.dispatchEvent(new Event('input')); }"
                    style="background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.4); color: #fca5a5; padding: 0.4rem 0.75rem; border-radius: 0.375rem; cursor: pointer; font-size: 0.8rem;"
                    title="Quitar logo"
                  >
                    Quitar
                  </button>
                </div>
                {mediaAssets.length > 0 && (
                  <div style="margin-top: 0.6rem;">
                    <span style="font-size: 0.75rem; color: #94a3b8; display: block; margin-bottom: 0.35rem;">Elegir de tus archivos subidos:</span>
                    <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                      {mediaAssets.map((asset) => {
                        const assetUrl = storageGateway.getUrl(asset.filePath);
                        return (
                          <button
                            type="button"
                            onclick={`const el = document.getElementById('logoUrl'); if (el) { el.value = '${assetUrl}'; el.dispatchEvent(new Event('input')); }`}
                            style="background: #0c1426; border: 1px solid #293958; border-radius: 0.375rem; padding: 0.25rem 0.5rem; cursor: pointer; display: flex; align-items: center; gap: 0.4rem;"
                            title={asset.altText}
                          >
                            <img src={assetUrl} alt={asset.altText} style="width: 1.5rem; height: 1.5rem; object-fit: contain; border-radius: 0.25rem; background: #000;" />
                            <span style="font-size: 0.72rem; color: #f8fafc; max-width: 6rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">{asset.altText}</span>
                          </button>
                        );
                      })}
                    </div>
                  </div>
                )}
              </div>

              <!-- Favicon de Pestaña -->
              <div class="field" style="margin-bottom: 0.5rem;">
                <label for="faviconUrl" style="display: flex; justify-content: space-between; align-items: center;">
                  <span>Favicon de Pestaña (Navegador)</span>
                  <span style="font-size: 0.75rem; color: #f59e0b; font-weight: normal;">Icono 1:1 cuadrado (32x32 o 64x64)</span>
                </label>
                <div style="display: flex; gap: 0.5rem;">
                  <input
                    id="faviconUrl"
                    name="faviconUrl"
                    type="text"
                    maxlength="512"
                    placeholder="https://... o seleccioná de tus archivos"
                    value={theme.faviconUrl ?? ""}
                    style="flex: 1;"
                  />
                  <button
                    type="button"
                    onclick="const el = document.getElementById('faviconUrl'); if (el) { el.value = ''; el.dispatchEvent(new Event('input')); }"
                    style="background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.4); color: #fca5a5; padding: 0.4rem 0.75rem; border-radius: 0.375rem; cursor: pointer; font-size: 0.8rem;"
                    title="Usar icono por defecto"
                  >
                    Por defecto
                  </button>
                </div>
                {mediaAssets.length > 0 && (
                  <div style="margin-top: 0.6rem;">
                    <span style="font-size: 0.75rem; color: #94a3b8; display: block; margin-bottom: 0.35rem;">Elegir de tus archivos subidos:</span>
                    <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                      {mediaAssets.map((asset) => {
                        const assetUrl = storageGateway.getUrl(asset.filePath);
                        return (
                          <button
                            type="button"
                            onclick={`const el = document.getElementById('faviconUrl'); if (el) { el.value = '${assetUrl}'; el.dispatchEvent(new Event('input')); }`}
                            style="background: #0c1426; border: 1px solid #293958; border-radius: 0.375rem; padding: 0.25rem 0.5rem; cursor: pointer; display: flex; align-items: center; gap: 0.4rem;"
                            title={asset.altText}
                          >
                            <img src={assetUrl} alt={asset.altText} style="width: 1.5rem; height: 1.5rem; object-fit: contain; border-radius: 0.25rem; background: #000;" />
                            <span style="font-size: 0.72rem; color: #f8fafc; max-width: 6rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">{asset.altText}</span>
                          </button>
                        );
                      })}
                    </div>
                  </div>
                )}
              </div>
            </div>

            <!-- 1-Click Platform Palette Selector -->
            <div style="background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(56, 189, 248, 0.25); border-radius: 0.75rem; padding: 1.25rem; margin-bottom: 1.75rem;">
              <div style="margin-bottom: 0.75rem;">
                <strong style="font-size: 0.95rem; color: #f8fafc; display: block;">🎨 Paletas de Marca Globales (1-Clic)</strong>
                <span style="font-size: 0.78rem; color: #94a3b8;">Hacé clic en cualquier paleta para cargar automáticamente sus 5 colores en el formulario:</span>
              </div>

              <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 0.75rem;">
                {platformPalettes.map((p) => (
                  <button
                    type="button"
                    class="btn-apply-palette"
                    data-primary={p.primaryColor}
                    data-secondary={p.secondaryColor}
                    data-accent={p.accentColor}
                    data-bg={p.backgroundColor}
                    data-text={p.textColor}
                    style="display: flex; flex-direction: column; gap: 0.45rem; background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 0.5rem; padding: 0.65rem; cursor: pointer; text-align: left; transition: all 0.2s;"
                  >
                    <span style="font-size: 0.78rem; font-weight: 700; color: #f8fafc; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                      {p.name}
                    </span>
                    <div style="display: flex; gap: 2px; height: 14px; border-radius: 3px; overflow: hidden; width: 100%;">
                      <span style={`flex: 1; background: ${p.primaryColor};`}></span>
                      <span style={`flex: 1; background: ${p.secondaryColor};`}></span>
                      <span style={`flex: 1; background: ${p.accentColor};`}></span>
                      <span style={`flex: 1; background: ${p.backgroundColor}; border: 1px solid rgba(255,255,255,0.1);`}></span>
                      <span style={`flex: 1; background: ${p.textColor};`}></span>
                    </div>
                  </button>
                ))}
              </div>
            </div>

            <div class="field">
              <label for="primaryColor">Primary Color (Hex)</label>
              <input id="primaryColor" name="primaryColor" type="text" pattern="^#[0-9a-fA-F]{6}$" required value={theme.primaryColor} />
            </div>

            <div class="field">
              <label for="secondaryColor">Secondary Color (Hex)</label>
              <input id="secondaryColor" name="secondaryColor" type="text" pattern="^#[0-9a-fA-F]{6}$" required value={theme.secondaryColor} />
            </div>

            <div class="field">
              <label for="accentColor">Accent Color (Hex)</label>
              <input id="accentColor" name="accentColor" type="text" pattern="^#[0-9a-fA-F]{6}$" required value={theme.accentColor} />
            </div>

            <div class="field">
              <label for="backgroundColor">Background Color (Hex)</label>
              <input id="backgroundColor" name="backgroundColor" type="text" pattern="^#[0-9a-fA-F]{6}$" required value={theme.backgroundColor} />
            </div>

            <div class="field">
              <label for="textColor">Text Color (Hex)</label>
              <input id="textColor" name="textColor" type="text" pattern="^#[0-9a-fA-F]{6}$" required value={theme.textColor} />
            </div>

            <div class="field">
              <label for="fontKey">Typography</label>
              <select id="fontKey" name="fontKey" required>
                {THEME_FONTS.map((font) => (
                  <option value={font} selected={font === theme.fontKey}>{font}</option>
                ))}
              </select>
            </div>

            <div class="field">
              <label for="radiusKey">Corner Radius</label>
              <select id="radiusKey" name="radiusKey" required>
                {THEME_RADII.map((radius) => (
                  <option value={radius} selected={radius === theme.radiusKey}>{radius}</option>
                ))}
              </select>
            </div>

            <div class="field">
              <label for="buttonVariant">Button Style</label>
              <select id="buttonVariant" name="buttonVariant" required>
                {THEME_BUTTON_VARIANTS.map((variant) => (
                  <option value={variant} selected={variant === theme.buttonVariant}>{variant}</option>
                ))}
              </select>
            </div>

            <div class="field">
              <label for="cardVariant">Card Variant</label>
              <select id="cardVariant" name="cardVariant" required>
                {THEME_CARD_VARIANTS.map((variant) => (
                  <option value={variant} selected={variant === theme.cardVariant}>{variant}</option>
                ))}
              </select>
            </div>

            <button type="submit" style="margin-top: 1rem;">Save Theme (Draft)</button>
          </form>
        </section>

        <aside class="panel" style="width: 100%;" aria-label="Palette Preview">
          <h2 style="margin-top: 0;">Identidad & Vista Previa</h2>
          <p class="muted">Previsualizá la pestaña de navegador y los tokens de tu marca en tiempo real.</p>

          <!-- Mockup de Pestaña del Navegador (Favicon) -->
          <div style="background: #1e293b; border: 1px solid #334155; border-radius: 0.5rem; padding: 0.75rem; margin-top: 1.25rem;">
            <span style="font-size: 0.7rem; text-transform: uppercase; color: #94a3b8; letter-spacing: 0.05em; display: block; margin-bottom: 0.4rem;">Pestaña del Navegador (Favicon)</span>
            <div style="display: inline-flex; align-items: center; gap: 0.5rem; background: #0f172a; border: 1px solid #334155; border-radius: 0.375rem; padding: 0.4rem 0.75rem; max-width: 100%;">
              <img
                id="live-favicon-preview"
                src={theme.faviconUrl || theme.logoUrl || "/favicon.svg"}
                alt="Favicon Preview"
                style="width: 16px; height: 16px; object-fit: contain; border-radius: 2px;"
              />
              <span style="font-size: 0.78rem; color: #e2e8f0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-weight: 500;">
                {siteData.name} — Oficial
              </span>
              <span style="font-size: 0.75rem; color: #64748b; margin-left: 0.5rem;">&times;</span>
            </div>
          </div>

          <!-- Mockup de Barra de Navegación (Header Brand) -->
          <div style="background: #1e293b; border: 1px solid #334155; border-radius: 0.5rem; padding: 0.75rem; margin-top: 1rem;">
            <span style="font-size: 0.7rem; text-transform: uppercase; color: #94a3b8; letter-spacing: 0.05em; display: block; margin-bottom: 0.4rem;">Encabezado de Navegación (Header)</span>
            <div id="live-header-preview-bar" style={`background: ${theme.backgroundColor}; border: 1px solid #304365; border-radius: 0.375rem; padding: 0.6rem 0.8rem; display: flex; align-items: center; justify-content: space-between; gap: 0.5rem;`}>
              <div style="display: flex; align-items: center; gap: 0.5rem;">
                <img
                  id="live-logo-preview"
                  src={theme.logoUrl || ""}
                  alt="Logo Preview"
                  style={`height: 22px; width: auto; max-width: 90px; object-fit: contain; display: ${theme.logoUrl ? "inline-block" : "none"};`}
                />
                <span id="live-logo-fallback-icon" style={`display: ${theme.logoUrl ? "none" : "inline-block"}; color: ${theme.primaryColor}; font-size: 1rem;`}>⚡</span>
                <strong id="live-header-site-name" style={`font-size: 0.82rem; color: ${theme.textColor};`}>{siteData.name}</strong>
              </div>
              <span id="live-header-preview-cta" style={`font-size: 0.7rem; background: ${theme.primaryColor}; color: #ffffff; padding: 0.25rem 0.5rem; border-radius: 0.25rem; font-weight: 700;`}>Contacto</span>
            </div>
          </div>

          <!-- Live Theme Tokens Box -->
          <div style="display: grid; gap: 1rem; margin-top: 1rem;">
            <div id="live-theme-preview-box" style={`background: ${theme.backgroundColor}; color: ${theme.textColor}; padding: 1.5rem; border: 1px solid #304365; border-radius: .75rem; transition: all 0.25s;`}>
              <h3 id="preview-brand-h3" style={`color: ${theme.primaryColor}; margin-top: 0;`}>Brand Heading</h3>
              <p id="preview-brand-p" style="margin-bottom: 1rem;">Sample text rendered with selected background and text contrast tokens.</p>
              <div style="display: flex; gap: .75rem; align-items: center; flex-wrap: wrap;">
                <span id="preview-brand-primary-btn" style={`background: ${theme.primaryColor}; color: #ffffff; padding: .5rem 1rem; border-radius: .5rem; font-weight: 700;`}>Primary</span>
                <span id="preview-brand-secondary-btn" style={`background: ${theme.secondaryColor}; color: #ffffff; padding: .5rem 1rem; border-radius: .5rem; font-weight: 700;`}>Secondary</span>
                <span id="preview-brand-accent-btn" style={`background: ${theme.accentColor}; color: #000000; padding: .5rem 1rem; border-radius: .5rem; font-weight: 700;`}>Accent</span>
              </div>
            </div>
          </div>
          <div style="margin-top: 2rem;">
            <a href="/admin" class="nav-link">&larr; Back to Sites</a>
          </div>
        </aside>
      </div>
    </main>

    <script>
      const logoInput = document.getElementById("logoUrl") as HTMLInputElement | null;
      const faviconInput = document.getElementById("faviconUrl") as HTMLInputElement | null;
      const primaryInput = document.getElementById("primaryColor") as HTMLInputElement | null;
      const secondaryInput = document.getElementById("secondaryColor") as HTMLInputElement | null;
      const accentInput = document.getElementById("accentColor") as HTMLInputElement | null;
      const bgInput = document.getElementById("backgroundColor") as HTMLInputElement | null;
      const textInput = document.getElementById("textColor") as HTMLInputElement | null;

      const liveFavicon = document.getElementById("live-favicon-preview") as HTMLImageElement | null;
      const liveLogo = document.getElementById("live-logo-preview") as HTMLImageElement | null;
      const liveLogoFallback = document.getElementById("live-logo-fallback-icon");
      const liveHeaderBar = document.getElementById("live-header-preview-bar");
      const liveHeaderSiteName = document.getElementById("live-header-site-name");
      const liveHeaderCta = document.getElementById("live-header-preview-cta");

      const previewBox = document.getElementById("live-theme-preview-box");
      const previewH3 = document.getElementById("preview-brand-h3");
      const previewPrimary = document.getElementById("preview-brand-primary-btn");
      const previewSecondary = document.getElementById("preview-brand-secondary-btn");
      const previewAccent = document.getElementById("preview-brand-accent-btn");

      function updateBrandMedia() {
        const logoVal = logoInput?.value.trim() || "";
        const favVal = faviconInput?.value.trim() || "";

        if (liveLogo && liveLogoFallback) {
          if (logoVal) {
            liveLogo.src = logoVal;
            liveLogo.style.display = "inline-block";
            liveLogoFallback.style.display = "none";
          } else {
            liveLogo.style.display = "none";
            liveLogoFallback.style.display = "inline-block";
          }
        }

        if (liveFavicon) {
          liveFavicon.src = favVal || logoVal || "/favicon.svg";
        }
      }

      function updateLiveTokens() {
        if (!previewBox || !primaryInput || !secondaryInput || !accentInput || !bgInput || !textInput) return;
        previewBox.style.backgroundColor = bgInput.value;
        previewBox.style.color = textInput.value;
        if (previewH3) previewH3.style.color = primaryInput.value;
        if (previewPrimary) previewPrimary.style.backgroundColor = primaryInput.value;
        if (previewSecondary) previewSecondary.style.backgroundColor = secondaryInput.value;
        if (previewAccent) previewAccent.style.backgroundColor = accentInput.value;

        if (liveHeaderBar) liveHeaderBar.style.backgroundColor = bgInput.value;
        if (liveHeaderSiteName) liveHeaderSiteName.style.color = textInput.value;
        if (liveHeaderCta) liveHeaderCta.style.backgroundColor = primaryInput.value;
        if (liveLogoFallback) (liveLogoFallback as HTMLElement).style.color = primaryInput.value;
      }

      [logoInput, faviconInput].forEach((input) => {
        input?.addEventListener("input", updateBrandMedia);
      });

      [primaryInput, secondaryInput, accentInput, bgInput, textInput].forEach((input) => {
        input?.addEventListener("input", updateLiveTokens);
      });

      // Palette buttons click
      const paletteBtns = document.querySelectorAll<HTMLButtonElement>(".btn-apply-palette");
      paletteBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
          if (primaryInput && btn.dataset.primary) primaryInput.value = btn.dataset.primary;
          if (secondaryInput && btn.dataset.secondary) secondaryInput.value = btn.dataset.secondary;
          if (accentInput && btn.dataset.accent) accentInput.value = btn.dataset.accent;
          if (bgInput && btn.dataset.bg) bgInput.value = btn.dataset.bg;
          if (textInput && btn.dataset.text) textInput.value = btn.dataset.text;
          updateLiveTokens();
        });
      });
    </script>
  </body>
</html>
