---
import { actions } from "astro:actions";
import { SupabaseContactRepository } from "../../../../infrastructure/supabase/contact-repository";
import { type SiteContacts, generateWhatsAppUrl } from "../../../../domain/site/contact";
import "../../../../styles/admin.css";

const logoutResult = Astro.getActionResult(actions.logout);
if (logoutResult?.data?.ok) return Astro.redirect("/admin/login", 303);

if (!Astro.locals.user) return Astro.redirect("/admin/login", 303);

const { id: siteId } = Astro.params;
if (!siteId) return Astro.redirect("/admin", 303);

// Fetch site details and verify tenant membership
const { data: siteData, error: siteError } = await Astro.locals.supabase
  .from("sites")
  .select("id, name, slug, tenant_id")
  .eq("id", siteId)
  .maybeSingle();

if (siteError || !siteData) {
  return Astro.redirect("/admin", 303);
}

const contactRepo = new SupabaseContactRepository(Astro.locals.supabase);
const existingContacts = await contactRepo.getContacts(siteId);
const contacts: SiteContacts = existingContacts ?? { siteId };

const saveResult = Astro.getActionResult(actions.saveSiteContacts);
const isSuccess = Boolean(saveResult?.data && saveResult.data.ok);
const errorMessage = saveResult && !saveResult.data?.ok ? saveResult.data?.error : null;

const waPreviewUrl = contacts.whatsappNumber
  ? generateWhatsAppUrl(contacts.whatsappNumber, contacts.whatsappMessage ?? undefined)
  : null;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Contacto & Canales Directos (Borrador) | {siteData.name}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <header class="shell topbar">
      <a href="/admin" style="text-decoration: none; color: #ffffff; display: flex; align-items: center; gap: .5rem; font-weight: 800; font-size: 1.1rem;">
        <span style="color: #ffffff;">Launch<span style="color: #38bdf8;">Pulse</span></span>
      </a>
      <nav aria-label="Admin navigation">
        <ul class="nav-links">
          <li><a href="/admin" class="nav-link active">Sitios</a></li>
          <li><a href="/admin/members" class="nav-link">Equipo</a></li>
          <li><a href="/admin/billing" class="nav-link">Suscripción</a></li>
        </ul>
      </nav>
      <form method="POST" action={actions.logout}>
        <button type="submit">Salir</button>
      </form>
    </header>

    <main class="shell dashboard">
      <p class="eyebrow">Módulos del Sitio &bull; <span class="badge" style="background: #e5a93c; color: #1c1103;">Modo Borrador</span></p>
      <h1>{siteData.name} &mdash; Canales de Contacto Directo</h1>
      <p class="muted">Configurá el número de WhatsApp para conversiones inmediatas y tus perfiles oficiales de redes sociales.</p>

      <nav aria-label="Secciones del sitio" style="margin-bottom: 2rem;">
        <ul class="nav-links" style="border-bottom: 1px solid #293958; padding-bottom: .75rem;">
          <li><a href={`/admin/sites/${siteId}/template`} class="nav-link">Plantilla</a></li>
          <li><a href={`/admin/sites/${siteId}/theme`} class="nav-link">Tema</a></li>
          <li><a href={`/admin/sites/${siteId}/hero`} class="nav-link">Hero</a></li>
          <li><a href={`/admin/sites/${siteId}/cards`} class="nav-link">Tarjetas</a></li>
          <li><a href={`/admin/sites/${siteId}/promotions`} class="nav-link">Promociones</a></li>
          <li><a href={`/admin/sites/${siteId}/contacts`} class="nav-link active">Contacto</a></li>
          <li><a href={`/admin/sites/${siteId}/media`} class="nav-link">Multimedia</a></li>
          <li><a href={`/admin/sites/${siteId}/campaigns`} class="nav-link">Campañas</a></li>
          <li><a href={`/admin/sites/${siteId}/publish`} class="nav-link">Publicar</a></li>
          <li><a href={`/admin/sites/${siteId}/domains`} class="nav-link">Dominios</a></li>
          <li><a href={`/admin/sites/${siteId}/analytics`} class="nav-link">Analíticas</a></li>
          <li><a href={`/preview/${siteId}`} target="_blank" class="nav-link" style="color: #ffd57a;">Vista Previa ↗</a></li>
        </ul>
      </nav>

      {isSuccess && <p class="badge" style="background: #1e4620; color: #a3e9a4; padding: .75rem 1rem; display: block; margin-bottom: 1.5rem;" role="status">Borrador de contactos actualizado con éxito.</p>}
      {errorMessage && <p class="error" role="alert">{errorMessage}</p>}

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr)); gap: 2rem; align-items: start;">
        <section class="panel" style="width: 100%;" aria-labelledby="contacts-form-title">
          <h2 id="contacts-form-title" style="margin-top: 0;">Canales de Atención</h2>
          <form method="POST" action={actions.saveSiteContacts}>
            <input type="hidden" name="siteId" value={siteId} />
            <input type="hidden" name="tenantId" value={siteData.tenant_id} />

            <div class="field">
              <label for="whatsappNumber">Número de WhatsApp (Formato internacional, ej. +51912345678 o +5491122334455)</label>
              <input id="whatsappNumber" name="whatsappNumber" type="text" pattern="^\+[1-9][0-9]{6,14}$" placeholder="+51912345678" value={contacts.whatsappNumber ?? ""} />
            </div>

            <div class="field">
              <label for="whatsappMessage">Mensaje Predeterminado de WhatsApp</label>
              <input id="whatsappMessage" name="whatsappMessage" type="text" maxlength="140" placeholder="¡Hola! Quisiera solicitar información sobre sus servicios..." value={contacts.whatsappMessage ?? ""} />
            </div>

            <div class="field">
              <label for="instagramHandle">Usuario de Instagram (sin el @)</label>
              <input id="instagramHandle" name="instagramHandle" type="text" maxlength="30" placeholder="mimarca" value={contacts.instagramHandle ?? ""} />
            </div>

            <div class="field">
              <label for="facebookUrl">Página de Facebook (URL completa)</label>
              <input id="facebookUrl" name="facebookUrl" type="url" maxlength="256" placeholder="https://facebook.com/mimarca" value={contacts.facebookUrl ?? ""} />
            </div>

            <div class="field">
              <label for="email">Correo Electrónico de Contacto</label>
              <input id="email" name="email" type="email" maxlength="254" placeholder="contacto@empresa.com" value={contacts.email ?? ""} />
            </div>

            <div class="field">
              <label for="phone">Teléfono de Llamadas / Oficina</label>
              <input id="phone" name="phone" type="text" maxlength="30" placeholder="+51 912 345 678" value={contacts.phone ?? ""} />
            </div>

            <button type="submit" style="margin-top: 1rem;">Guardar Contactos (Borrador)</button>
          </form>
        </section>

        <aside class="panel" style="width: 100%;" aria-label="Resumen de Canales">
          <h2 style="margin-top: 0;">Resumen de Canales</h2>
          <p class="muted">Estado en vivo de las vías de comunicación configuradas.</p>

          <div style="display: grid; gap: 1rem; margin-top: 1.5rem;">
            <div style="padding: 1rem; border: 1px solid #304365; border-radius: .75rem;">
              <strong>WhatsApp Directo:</strong>
              {contacts.whatsappNumber ? (
                <p style="margin: .5rem 0 0;">
                  <code>{contacts.whatsappNumber}</code>
                  {waPreviewUrl && (
                    <span style="display: block; margin-top: .5rem;">
                      <a href={waPreviewUrl} target="_blank" rel="noopener noreferrer" class="badge badge-admin" style="text-decoration: none;">Probar enlace a WhatsApp &rarr;</a>
                    </span>
                  )}
                </p>
              ) : (
                <p class="muted" style="margin: .5rem 0 0;">No configurado</p>
              )}
            </div>

            <div style="padding: 1rem; border: 1px solid #304365; border-radius: .75rem;">
              <strong>Perfil de Instagram:</strong>
              {contacts.instagramHandle ? (
                <p style="margin: .5rem 0 0;">
                  <a href={`https://instagram.com/${contacts.instagramHandle}`} target="_blank" rel="noopener noreferrer" class="nav-link">@{contacts.instagramHandle}</a>
                </p>
              ) : (
                <p class="muted" style="margin: .5rem 0 0;">No configurado</p>
              )}
            </div>

            <div style="padding: 1rem; border: 1px solid #304365; border-radius: .75rem;">
              <strong>Correo Oficial:</strong>
              {contacts.email ? (
                <p style="margin: .5rem 0 0;"><code>{contacts.email}</code></p>
              ) : (
                <p class="muted" style="margin: .5rem 0 0;">No configurado</p>
              )}
            </div>
          </div>

          <div style="margin-top: 2rem;">
            <a href="/admin" class="nav-link">&larr; Volver al Panel</a>
          </div>
        </aside>
      </div>
    </main>
  </body>
</html>
