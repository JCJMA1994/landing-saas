---
import { actions } from "astro:actions";
import { SupabaseContactRepository } from "../../../../infrastructure/supabase/contact-repository";
import { generateWhatsAppUrl, type SiteContacts } from "../../../../domain/site/contact";
import "../../../../styles/admin.css";

const logoutResult = Astro.getActionResult(actions.logout);
if (logoutResult?.data?.ok) return Astro.redirect("/admin/login", 303);

const { id: siteId } = Astro.params;
if (!siteId) return Astro.redirect("/admin", 303);

const { data: siteData, error: siteError } = await Astro.locals.supabase
  .from("sites")
  .select("id, name, slug, tenant_id")
  .eq("id", siteId)
  .maybeSingle();

if (siteError || !siteData) {
  return Astro.redirect("/admin", 303);
}

const contactRepo = new SupabaseContactRepository(Astro.locals.supabase);
const existingContacts = await contactRepo.getContacts(siteId);

const contacts: SiteContacts = existingContacts ?? { siteId };

const saveResult = Astro.getActionResult(actions.saveSiteContacts);
const isSuccess = Boolean(saveResult?.data?.ok);
const errorMessage = saveResult && !saveResult.data?.ok ? saveResult.data?.error : null;

const waPreviewUrl = contacts.whatsappNumber ? generateWhatsAppUrl(contacts.whatsappNumber, contacts.whatsappMessage) : null;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Contact & Socials (Draft) | {siteData.name}</title>
  </head>
  <body>
    <header class="shell topbar">
      <strong>Landing SaaS</strong>
      <nav aria-label="Admin navigation">
        <ul class="nav-links">
          <li><a href="/admin" class="nav-link active">Sites</a></li>
          <li><a href="/admin/members" class="nav-link">Members</a></li>
        </ul>
      </nav>
      <form method="POST" action={actions.logout}>
        <button type="submit">Sign out</button>
      </form>
    </header>

    <main class="shell dashboard">
      <p class="eyebrow">Site Modules &bull; <span class="badge" style="background: #e5a93c; color: #1c1103;">Draft Mode</span></p>
      <h1>{siteData.name} &mdash; Direct Channels</h1>
      <p class="muted">Configure WhatsApp conversion numbers and official social media profiles.</p>

      <nav aria-label="Site sections" style="margin-bottom: 2rem;">
        <ul class="nav-links" style="border-bottom: 1px solid #293958; padding-bottom: .75rem;">
          <li><a href={`/admin/sites/${siteId}/template`} class="nav-link">Template</a></li>
          <li><a href={`/admin/sites/${siteId}/theme`} class="nav-link">Theme</a></li>
          <li><a href={`/admin/sites/${siteId}/hero`} class="nav-link">Hero</a></li>
          <li><a href={`/admin/sites/${siteId}/cards`} class="nav-link">Cards</a></li>
          <li><a href={`/admin/sites/${siteId}/promotions`} class="nav-link">Promotions</a></li>
          <li><a href={`/admin/sites/${siteId}/contacts`} class="nav-link active">Contacts</a></li>
          <li><a href={`/admin/sites/${siteId}/media`} class="nav-link">Media</a></li>
          <li><a href={`/admin/sites/${siteId}/campaigns`} class="nav-link">Campaigns</a></li>
          <li><a href={`/admin/sites/${siteId}/publish`} class="nav-link">Publish & History</a></li>
          <li><a href={`/preview/${siteId}`} target="_blank" class="nav-link" style="color: #ffd57a;">Preview ↗</a></li>
        </ul>
      </nav>

      {isSuccess && <p class="badge" style="background: #1e4620; color: #a3e9a4; padding: .75rem 1rem; display: block; margin-bottom: 1.5rem;" role="status">Contacts draft updated successfully.</p>}
      {errorMessage && <p class="error" role="alert">{errorMessage}</p>}

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr)); gap: 2rem; align-items: start;">
        <section class="panel" style="width: 100%;" aria-labelledby="contacts-form-title">
          <h2 id="contacts-form-title" style="margin-top: 0;">Channels & Handles</h2>
          <form method="POST" action={actions.saveSiteContacts}>
            <input type="hidden" name="siteId" value={siteId} />
            <input type="hidden" name="tenantId" value={siteData.tenant_id} />

            <div class="field">
              <label for="whatsappNumber">WhatsApp Number (E.164, e.g. +5491122334455)</label>
              <input id="whatsappNumber" name="whatsappNumber" type="text" pattern="^\+[1-9][0-9]{6,14}$" placeholder="+5491122334455" value={contacts.whatsappNumber ?? ""} />
            </div>

            <div class="field">
              <label for="whatsappMessage">Default Pre-filled WhatsApp Message</label>
              <input id="whatsappMessage" name="whatsappMessage" type="text" maxlength="140" placeholder="Hello! I would like to request info..." value={contacts.whatsappMessage ?? ""} />
            </div>

            <div class="field">
              <label for="instagramHandle">Instagram Username (without @)</label>
              <input id="instagramHandle" name="instagramHandle" type="text" maxlength="30" placeholder="mybrand" value={contacts.instagramHandle ?? ""} />
            </div>

            <div class="field">
              <label for="facebookUrl">Facebook URL</label>
              <input id="facebookUrl" name="facebookUrl" type="url" maxlength="256" placeholder="https://facebook.com/mybrand" value={contacts.facebookUrl ?? ""} />
            </div>

            <div class="field">
              <label for="email">Contact Email</label>
              <input id="email" name="email" type="email" maxlength="254" placeholder="support@brand.com" value={contacts.email ?? ""} />
            </div>

            <div class="field">
              <label for="phone">Display Phone Number</label>
              <input id="phone" name="phone" type="text" maxlength="30" placeholder="+1 (555) 019-2834" value={contacts.phone ?? ""} />
            </div>

            <button type="submit" style="margin-top: 1rem;">Save Contacts (Draft)</button>
          </form>
        </section>

        <aside class="panel" style="width: 100%;" aria-label="Channels Preview">
          <h2 style="margin-top: 0;">Channels Summary</h2>
          <p class="muted">Live status of configured communications.</p>

          <div style="display: grid; gap: 1rem; margin-top: 1.5rem;">
            <div style="padding: 1rem; border: 1px solid #304365; border-radius: .75rem;">
              <strong>WhatsApp Direct:</strong>
              {contacts.whatsappNumber ? (
                <p style="margin: .5rem 0 0;">
                  <code>{contacts.whatsappNumber}</code>
                  {waPreviewUrl && (
                    <span style="display: block; margin-top: .5rem;">
                      <a href={waPreviewUrl} target="_blank" rel="noopener noreferrer" class="badge badge-admin" style="text-decoration: none;">Test WhatsApp Link &rarr;</a>
                    </span>
                  )}
                </p>
              ) : (
                <p class="muted" style="margin: .5rem 0 0;">Not configured</p>
              )}
            </div>

            <div style="padding: 1rem; border: 1px solid #304365; border-radius: .75rem;">
              <strong>Instagram Profile:</strong>
              {contacts.instagramHandle ? (
                <p style="margin: .5rem 0 0;">
                  <a href={`https://instagram.com/${contacts.instagramHandle}`} target="_blank" rel="noopener noreferrer" class="nav-link">@{contacts.instagramHandle}</a>
                </p>
              ) : (
                <p class="muted" style="margin: .5rem 0 0;">Not configured</p>
              )}
            </div>

            <div style="padding: 1rem; border: 1px solid #304365; border-radius: .75rem;">
              <strong>Official Email:</strong>
              {contacts.email ? (
                <p style="margin: .5rem 0 0;"><code>{contacts.email}</code></p>
              ) : (
                <p class="muted" style="margin: .5rem 0 0;">Not configured</p>
              )}
            </div>
          </div>

          <div style="margin-top: 2rem;">
            <a href="/admin" class="nav-link">&larr; Back to Sites</a>
          </div>
        </aside>
      </div>
    </main>
  </body>
</html>
