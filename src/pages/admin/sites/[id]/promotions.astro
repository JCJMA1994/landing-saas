---
import { actions } from "astro:actions";
import { SupabasePromotionRepository } from "../../../../infrastructure/supabase/promotion-repository";
import "../../../../styles/admin.css";

const logoutResult = Astro.getActionResult(actions.logout);
if (logoutResult?.data?.ok) return Astro.redirect("/admin/login", 303);

if (!Astro.locals.user) return Astro.redirect("/admin/login", 303);

const { id: siteId } = Astro.params;
if (!siteId) return Astro.redirect("/admin", 303);

// Fetch site details and verify tenant membership
const { data: siteData, error: siteError } = await Astro.locals.supabase
  .from("sites")
  .select("id, name, slug, tenant_id")
  .eq("id", siteId)
  .maybeSingle();

if (siteError || !siteData) {
  return Astro.redirect("/admin", 303);
}

const promoRepo = new SupabasePromotionRepository(Astro.locals.supabase);
const promotions = await promoRepo.listPromotions(siteId);

const saveResult = Astro.getActionResult(actions.saveSitePromotion);
const deleteResult = Astro.getActionResult(actions.deleteSitePromotion);

const isSuccess = Boolean((saveResult?.data && saveResult.data.ok) || (deleteResult?.data && deleteResult.data.ok));
const errorMessage = saveResult && !saveResult.data?.ok 
  ? saveResult.data?.error 
  : deleteResult && !deleteResult.data?.ok 
  ? deleteResult.data?.error 
  : null;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Promociones & Ofertas (Borrador) | {siteData.name}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <header class="shell topbar">
      <a href="/admin" style="text-decoration: none; color: #ffffff; display: flex; align-items: center; gap: .5rem; font-weight: 800; font-size: 1.1rem;">
        <span style="color: #ffffff;">Launch<span style="color: #38bdf8;">Pulse</span></span>
      </a>
      <nav aria-label="Admin navigation">
        <ul class="nav-links">
          <li><a href="/admin" class="nav-link active">Sitios</a></li>
          <li><a href="/admin/members" class="nav-link">Equipo</a></li>
          <li><a href="/admin/billing" class="nav-link">Suscripción</a></li>
        </ul>
      </nav>
      <form method="POST" action={actions.logout}>
        <button type="submit">Salir</button>
      </form>
    </header>

    <main class="shell dashboard">
      <p class="eyebrow">Módulos del Sitio &bull; <span class="badge" style="background: #e5a93c; color: #1c1103;">Modo Borrador</span></p>
      <h1>{siteData.name} &mdash; Promociones & Ofertas</h1>
      <p class="muted">Gestioná ofertas comerciales, cupones de descuento y períodos de validez de tus campañas promocionales.</p>

      <nav aria-label="Secciones del sitio" style="margin-bottom: 2rem;">
        <ul class="nav-links" style="border-bottom: 1px solid #293958; padding-bottom: .75rem;">
          <li><a href={`/admin/sites/${siteId}/template`} class="nav-link">Plantilla</a></li>
          <li><a href={`/admin/sites/${siteId}/theme`} class="nav-link">Tema</a></li>
          <li><a href={`/admin/sites/${siteId}/hero`} class="nav-link">Hero</a></li>
          <li><a href={`/admin/sites/${siteId}/cards`} class="nav-link">Tarjetas</a></li>
          <li><a href={`/admin/sites/${siteId}/promotions`} class="nav-link active">Promociones</a></li>
          <li><a href={`/admin/sites/${siteId}/contacts`} class="nav-link">Contacto</a></li>
          <li><a href={`/admin/sites/${siteId}/media`} class="nav-link">Multimedia</a></li>
          <li><a href={`/admin/sites/${siteId}/campaigns`} class="nav-link">Campañas</a></li>
          <li><a href={`/admin/sites/${siteId}/publish`} class="nav-link">Publicar</a></li>
          <li><a href={`/admin/sites/${siteId}/domains`} class="nav-link">Dominios</a></li>
          <li><a href={`/admin/sites/${siteId}/analytics`} class="nav-link">Analíticas</a></li>
          <li><a href={`/preview/${siteId}`} target="_blank" class="nav-link" style="color: #ffd57a;">Vista Previa ↗</a></li>
        </ul>
      </nav>

      {isSuccess && <p class="badge" style="background: #1e4620; color: #a3e9a4; padding: .75rem 1rem; display: block; margin-bottom: 1.5rem;" role="status">Promoción guardada o eliminada con éxito.</p>}
      {errorMessage && <p class="error" role="alert">{errorMessage}</p>}

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr)); gap: 2rem; align-items: start;">
        <section class="panel" style="width: 100%;" aria-labelledby="add-promo-title">
          <h2 id="add-promo-title" style="margin-top: 0;">Crear Promoción</h2>
          <form method="POST" action={actions.saveSitePromotion}>
            <input type="hidden" name="siteId" value={siteId} />
            <input type="hidden" name="tenantId" value={siteData.tenant_id} />

            <div class="field">
              <label for="title">Título de la Promoción (Máx. 100 caracteres)</label>
              <input id="title" name="title" type="text" required maxlength="100" placeholder="ej. Descuento de Lanzamiento" />
            </div>

            <div class="field">
              <label for="description">Descripción y Condiciones (Máx. 400 caracteres)</label>
              <input id="description" name="description" type="text" required maxlength="400" placeholder="Detalles de la oferta y requisitos..." />
            </div>

            <div class="field">
              <label for="discountLabel">Etiqueta de Descuento (Opcional)</label>
              <input id="discountLabel" name="discountLabel" type="text" maxlength="30" placeholder="ej. 25% OFF, 2x1" />
            </div>

            <div class="field">
              <label for="couponCode">Código de Cupón (Opcional)</label>
              <input id="couponCode" name="couponCode" type="text" maxlength="30" placeholder="ej. PROMO2026" />
            </div>

            <div class="field">
              <label for="startsAt">Fecha de Inicio (Opcional)</label>
              <input id="startsAt" name="startsAt" type="datetime-local" />
            </div>

            <div class="field">
              <label for="endsAt">Fecha de Finalización (Opcional)</label>
              <input id="endsAt" name="endsAt" type="datetime-local" />
            </div>

            <button type="submit" style="margin-top: 1rem;">Guardar Promoción (Borrador)</button>
          </form>
        </section>

        <section aria-labelledby="promo-list-title">
          <h2 id="promo-list-title" style="margin-top: 0;">Promociones Registradas ({promotions.length})</h2>
          {promotions.length === 0 ? (
            <p class="empty">No hay promociones activas registradas todavía.</p>
          ) : (
            <ul style="list-style: none; padding: 0; display: grid; gap: 1rem;">
              {promotions.map((promo) => (
                <li class="site-card">
                  <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem;">
                    <div>
                      {promo.discountLabel && <span class="badge badge-owner" style="margin-bottom: .5rem;">{promo.discountLabel}</span>}
                      <h3 style="margin: .25rem 0 .5rem;">{promo.title}</h3>
                      <p class="muted" style="margin-bottom: .75rem;">{promo.description}</p>
                      {promo.couponCode && <p style="font-size: .85rem;">Cupón: <code>{promo.couponCode}</code></p>}
                    </div>
                    {promo.id && (
                      <form method="POST" action={actions.deleteSitePromotion}>
                        <input type="hidden" name="siteId" value={siteId} />
                        <input type="hidden" name="tenantId" value={siteData.tenant_id} />
                        <input type="hidden" name="promotionId" value={promo.id} />
                        <button type="submit" class="button-danger" style="padding: .4rem .75rem; font-size: .85rem;" onclick="return confirm('¿Eliminar esta promoción?');">Eliminar</button>
                      </form>
                    )}
                  </div>
                </li>
              ))}
            </ul>
          )}
          <div style="margin-top: 2rem;">
            <a href="/admin" class="nav-link">&larr; Volver al Panel</a>
          </div>
        </section>
      </div>
    </main>
  </body>
</html>
