---
import { actions } from "astro:actions";
import { SupabasePromotionRepository } from "../../../../infrastructure/supabase/promotion-repository";
import type { SitePromotion } from "../../../../domain/site/promotion";
import "../../../../styles/admin.css";

const logoutResult = Astro.getActionResult(actions.logout);
if (logoutResult?.data?.ok) return Astro.redirect("/admin/login", 303);

const { id: siteId } = Astro.params;
if (!siteId) return Astro.redirect("/admin", 303);

const { data: siteData, error: siteError } = await Astro.locals.supabase
  .from("sites")
  .select("id, name, slug, tenant_id")
  .eq("id", siteId)
  .maybeSingle();

if (siteError || !siteData) {
  return Astro.redirect("/admin", 303);
}

const promoRepo = new SupabasePromotionRepository(Astro.locals.supabase);
const promotions: SitePromotion[] = await promoRepo.listPromotions(siteId);

const saveResult = Astro.getActionResult(actions.saveSitePromotion);
const deleteResult = Astro.getActionResult(actions.deleteSitePromotion);

const errorMessage =
  (saveResult && !saveResult.data?.ok ? saveResult.data?.error : null) ??
  (deleteResult && !deleteResult.data?.ok ? deleteResult.data?.error : null);
const isSuccess = Boolean(saveResult?.data?.ok || deleteResult?.data?.ok);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Promotions & Discounts (Draft) | {siteData.name}</title>
  </head>
  <body>
    <header class="shell topbar">
      <strong>Landing SaaS</strong>
      <nav aria-label="Admin navigation">
        <ul class="nav-links">
          <li><a href="/admin" class="nav-link active">Sites</a></li>
          <li><a href="/admin/members" class="nav-link">Members</a></li>
        </ul>
      </nav>
      <form method="POST" action={actions.logout}>
        <button type="submit">Sign out</button>
      </form>
    </header>

    <main class="shell dashboard">
      <p class="eyebrow">Site Modules &bull; <span class="badge" style="background: #e5a93c; color: #1c1103;">Draft Mode</span></p>
      <h1>{siteData.name} &mdash; Promotions & Offers</h1>
      <p class="muted">Manage commercial offers, discount coupons and schedule validity windows.</p>

      <nav aria-label="Site sections" style="margin-bottom: 2rem;">
        <ul class="nav-links" style="border-bottom: 1px solid #293958; padding-bottom: .75rem;">
          <li><a href={`/admin/sites/${siteId}/template`} class="nav-link">Template</a></li>
          <li><a href={`/admin/sites/${siteId}/theme`} class="nav-link">Theme</a></li>
          <li><a href={`/admin/sites/${siteId}/hero`} class="nav-link">Hero</a></li>
          <li><a href={`/admin/sites/${siteId}/cards`} class="nav-link">Cards</a></li>
          <li><a href={`/admin/sites/${siteId}/promotions`} class="nav-link active">Promotions</a></li>
          <li><a href={`/admin/sites/${siteId}/contacts`} class="nav-link">Contacts</a></li>
          <li><a href={`/admin/sites/${siteId}/media`} class="nav-link">Media</a></li>
          <li><a href={`/admin/sites/${siteId}/campaigns`} class="nav-link">Campaigns</a></li>
          <li><a href={`/admin/sites/${siteId}/publish`} class="nav-link">Publish & History</a></li>
          <li><a href={`/preview/${siteId}`} target="_blank" class="nav-link" style="color: #ffd57a;">Preview ↗</a></li>
        </ul>
      </nav>

      {isSuccess && <p class="badge" style="background: #1e4620; color: #a3e9a4; padding: .75rem 1rem; display: block; margin-bottom: 1.5rem;" role="status">Promotion saved or removed successfully.</p>}
      {errorMessage && <p class="error" role="alert">{errorMessage}</p>}

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr)); gap: 2rem; align-items: start;">
        <section class="panel" style="width: 100%;" aria-labelledby="add-promo-title">
          <h2 id="add-promo-title" style="margin-top: 0;">Create Promotion</h2>
          <form method="POST" action={actions.saveSitePromotion}>
            <input type="hidden" name="siteId" value={siteId} />
            <input type="hidden" name="tenantId" value={siteData.tenant_id} />

            <div class="field">
              <label for="title">Title (Max 100 chars)</label>
              <input id="title" name="title" type="text" required maxlength="100" placeholder="e.g. Early Bird Discount" />
            </div>

            <div class="field">
              <label for="description">Description (Max 400 chars)</label>
              <input id="description" name="description" type="text" required maxlength="400" placeholder="Terms and promotional details..." />
            </div>

            <div class="field">
              <label for="discountLabel">Discount Label (Optional)</label>
              <input id="discountLabel" name="discountLabel" type="text" maxlength="30" placeholder="e.g. 25% OFF" />
            </div>

            <div class="field">
              <label for="couponCode">Coupon Code (Optional)</label>
              <input id="couponCode" name="couponCode" type="text" maxlength="30" placeholder="e.g. LAUNCH2026" />
            </div>

            <div class="field">
              <label for="startsAt">Starts At (Optional)</label>
              <input id="startsAt" name="startsAt" type="datetime-local" />
            </div>

            <div class="field">
              <label for="endsAt">Ends At (Optional)</label>
              <input id="endsAt" name="endsAt" type="datetime-local" />
            </div>

            <button type="submit" style="margin-top: 1rem;">Save Promotion (Draft)</button>
          </form>
        </section>

        <section aria-labelledby="promo-list-title">
          <h2 id="promo-list-title" style="margin-top: 0;">Current Promotions ({promotions.length})</h2>
          {promotions.length === 0 ? (
            <p class="empty">No promotions created yet.</p>
          ) : (
            <ul style="list-style: none; padding: 0; display: grid; gap: 1rem;">
              {promotions.map((promo) => (
                <li class="site-card">
                  <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem;">
                    <div>
                      {promo.discountLabel && <span class="badge badge-owner" style="margin-bottom: .5rem;">{promo.discountLabel}</span>}
                      <h3 style="margin: .25rem 0 .5rem;">{promo.title}</h3>
                      <p class="muted" style="margin-bottom: .75rem;">{promo.description}</p>
                      {promo.couponCode && <p style="font-size: .85rem;">Coupon: <code>{promo.couponCode}</code></p>}
                    </div>
                    {promo.id && (
                      <form method="POST" action={actions.deleteSitePromotion}>
                        <input type="hidden" name="siteId" value={siteId} />
                        <input type="hidden" name="tenantId" value={siteData.tenant_id} />
                        <input type="hidden" name="promotionId" value={promo.id} />
                        <button type="submit" class="button-danger" style="padding: .4rem .75rem; font-size: .85rem;" onclick="return confirm('Delete this promotion?');">Delete</button>
                      </form>
                    )}
                  </div>
                </li>
              ))}
            </ul>
          )}
          <div style="margin-top: 2rem;">
            <a href="/admin" class="nav-link">&larr; Back to Sites</a>
          </div>
        </section>
      </div>
    </main>
  </body>
</html>
