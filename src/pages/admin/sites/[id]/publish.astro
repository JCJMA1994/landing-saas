---
import { actions } from "astro:actions";
import { SupabasePublicationRepository } from "../../../../infrastructure/supabase/publication-repository";
import { SupabaseThemeRepository } from "../../../../infrastructure/supabase/theme-repository";
import { SupabaseHeroRepository } from "../../../../infrastructure/supabase/hero-repository";
import { SupabaseCardRepository } from "../../../../infrastructure/supabase/card-repository";
import { SupabasePromotionRepository } from "../../../../infrastructure/supabase/promotion-repository";
import { SupabaseContactRepository } from "../../../../infrastructure/supabase/contact-repository";
import {
  createPublicationSnapshot,
  calculateSnapshotChecksum,
} from "../../../../domain/publication/snapshot";
import { DEFAULT_SITE_THEME } from "../../../../domain/site/theme";
import { isTemplateKey, type TemplateKey } from "../../../../domain/template/manifest";
import { parseServerEnv } from "../../../../infrastructure/config/env";
import SiteHeaderNav from "../../../../components/admin/SiteHeaderNav.astro";
import "../../../../styles/admin.css";

const env = parseServerEnv(import.meta.env, process.env);

const logoutResult = Astro.getActionResult(actions.logout);
if (logoutResult?.data?.ok) return Astro.redirect("/admin/login", 303);

if (!Astro.locals.user) return Astro.redirect("/admin/login", 303);

const { id: siteId } = Astro.params;
if (!siteId) return Astro.redirect("/admin", 303);

// Fetch site details and verify tenant membership
const { data: siteData, error: siteError } = await Astro.locals.supabase
  .from("sites")
  .select("id, name, slug, tenant_id, template_key")
  .eq("id", siteId)
  .maybeSingle();

if (siteError || !siteData) {
  return Astro.redirect("/admin", 303);
}

const liveUrl = env.appHostname === "localhost"
  ? `/sites/${siteData.slug}`
  : `https://${siteData.slug}.${env.appHostname}`;

const publicationRepo = new SupabasePublicationRepository(Astro.locals.supabase);
const themeRepo = new SupabaseThemeRepository(Astro.locals.supabase);
const heroRepo = new SupabaseHeroRepository(Astro.locals.supabase);
const cardRepo = new SupabaseCardRepository(Astro.locals.supabase);
const promoRepo = new SupabasePromotionRepository(Astro.locals.supabase);
const contactRepo = new SupabaseContactRepository(Astro.locals.supabase);

const [activePublication, history, existingTheme, hero, cards, promotions, contacts] =
  await Promise.all([
    publicationRepo.getActivePublication(siteId),
    publicationRepo.listHistory(siteId),
    themeRepo.getTheme(siteId),
    heroRepo.getHero(siteId),
    cardRepo.listCards(siteId),
    promoRepo.listPromotions(siteId),
    contactRepo.getContacts(siteId),
  ]);

const templateKey: TemplateKey = isTemplateKey(siteData.template_key)
  ? (siteData.template_key as TemplateKey)
  : "tech-diagnostic";

// Calculate draft snapshot and checksum to check if pending changes exist
const draftSnapshot = createPublicationSnapshot({
  siteId: siteData.id,
  siteName: siteData.name,
  siteSlug: siteData.slug,
  templateKey,
  theme: existingTheme ?? { siteId, ...DEFAULT_SITE_THEME },
  hero,
  cards,
  promotions,
  contacts,
});
const draftChecksum = await calculateSnapshotChecksum(draftSnapshot);

const hasPendingChanges = !activePublication || activePublication.checksum !== draftChecksum;
const nextVersion = history.length > 0 ? Math.max(...history.map((h) => h.version)) + 1 : 1;

const publishResult = Astro.getActionResult(actions.publishSite);
const rollbackResult = Astro.getActionResult(actions.rollbackSite);

const actionSuccess = publishResult?.data?.ok
  ? `Versión ${publishResult.data.version} publicada exitosamente con verificación SHA-256.`
  : rollbackResult?.data?.ok
    ? `Reversión exitosa: se creó la versión inmutable ${rollbackResult.data.version}.`
    : null;

const actionError = publishResult && !publishResult.data?.ok
  ? publishResult.data?.error
  : rollbackResult && !rollbackResult.data?.ok
    ? rollbackResult.data?.error
    : null;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Publicación e Historial | {siteData.name}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <header class="shell topbar">
      <a href="/admin" style="text-decoration: none; color: #ffffff; display: flex; align-items: center; gap: .5rem; font-weight: 800; font-size: 1.1rem;">
        <span style="color: #ffffff;">Launch<span style="color: #38bdf8;">Pulse</span></span>
      </a>
      <nav aria-label="Admin navigation">
        <ul class="nav-links">
          <li><a href="/admin" class="nav-link active">Sitios</a></li>
          <li><a href="/admin/members" class="nav-link">Equipo</a></li>
          <li><a href="/admin/billing" class="nav-link">Suscripción</a></li>
        </ul>
      </nav>
      <form method="POST" action={actions.logout}>
        <button type="submit">Salir</button>
      </form>
    </header>

    <main class="shell dashboard">
      <SiteHeaderNav
        siteId={siteId}
        siteName={siteData.name}
        activeTab="publish"
        status={activePublication ? "published" : "draft"}
        hasPendingChanges={hasPendingChanges}
      />

      <div class="publish-page-intro">
        <h1 class="publish-main-heading">Publicar y Estado del Sitio</h1>
        <p class="publish-main-subheading">
          Lanza las novedades de tu sitio a internet con un solo clic. Cada versión queda respaldada de forma inmutable para que puedas auditarla o restaurarla cuando quieras.
        </p>
      </div>

      {actionSuccess && (
        <div class="alert-banner alert-success" role="status">
          <span class="alert-icon">✓</span>
          <span>{actionSuccess}</span>
        </div>
      )}
      {actionError && (
        <div class="alert-banner alert-error" role="alert">
          <span class="alert-icon">⚠️</span>
          <span>{actionError}</span>
        </div>
      )}

      <div class="publish-cards-grid">
        <!-- Status Card -->
        <section class="publish-card">
          <div class="publish-card-header">
            <h2 class="publish-card-title">Estado de Publicación</h2>
          </div>
          
          <div class="publish-card-body">
            <div class="status-indicator-box">
              <span class="status-field-label">Versión en Vivo</span>
              {activePublication ? (
                <div class="status-live-row">
                  <span class="version-live-tag">v{activePublication.version}</span>
                  <span class="badge-status-active">ACTIVA EN VIVO</span>
                </div>
              ) : (
                <span class="badge-status-draft">SIN PUBLICAR (En Construcción)</span>
              )}
            </div>

            {activePublication && (
              <div class="status-meta-group">
                <div class="status-meta-row">
                  <span class="status-field-label">Fecha de publicación:</span>
                  <strong class="status-date-value">
                    {new Date(activePublication.publishedAt).toLocaleString()}
                  </strong>
                </div>
                <details class="security-details">
                  <summary class="security-summary">
                    <span class="security-check-label">✓ Versión verificada</span> &bull; <span class="security-link">Ver detalles SHA-256</span>
                  </summary>
                  <code class="security-checksum-code">
                    {activePublication.checksum}
                  </code>
                </details>
              </div>
            )}

            <div class="sync-status-box">
              <span class="status-field-label">Sincronización con la web:</span>
              {hasPendingChanges ? (
                <div class="sync-banner sync-pending">
                  <span class="sync-icon">⚠️</span>
                  <span>Tienes cambios guardados que aún no son visibles para el público. Haz clic en "Publicar Cambios en Vivo" para lanzarlos.</span>
                </div>
              ) : (
                <div class="sync-banner sync-synced">
                  <span class="sync-icon">✓</span>
                  <span>Tu sitio web está completamente al día. La versión pública coincide 100% con tu borrador.</span>
                </div>
              )}
            </div>
          </div>

          <div class="publish-card-actions">
            <a href={`/preview/${siteId}`} target="_blank" class="btn-action btn-preview">
              Ver Preview de Borrador ↗
            </a>
            {activePublication && (
              <a href={liveUrl} target="_blank" class="btn-action btn-live">
                Ver Sitio en Vivo ↗
              </a>
            )}
          </div>
        </section>

        <!-- Publish Action Card -->
        <section class="publish-card">
          <div class="publish-card-header">
            <h2 class="publish-card-title">Lanzar Nueva Versión</h2>
          </div>
          <div class="publish-card-body">
            <p class="publish-explanation">
              Al publicar, todos los cambios que editaste (diseño, contenidos, imágenes, redes y contacto) se aplicarán inmediatamente a tu sitio web en internet.
            </p>

            <form method="POST" action={actions.publishSite} class="publish-form">
              <input type="hidden" name="siteId" value={siteId} />
              <input type="hidden" name="tenantId" value={siteData.tenant_id} />
              
              <div class="next-version-box">
                <span class="status-field-label">Próxima versión a publicar:</span>
                <div class="next-version-row">
                  <strong class="next-version-tag">v{nextVersion}</strong>
                  <span class="template-pill-badge">{templateKey}</span>
                </div>
                <span class="next-version-hint">Se creará un respaldo inmutable con verificación criptográfica SHA-256.</span>
              </div>

              <button type="submit" class="btn-publish-submit">
                🚀 Publicar Cambios en Vivo (v{nextVersion})
              </button>
            </form>
          </div>
        </section>
      </div>

      <!-- History Section -->
      <section class="history-section">
        <div class="history-header">
          <div>
            <h2 class="history-title">Historial de Versiones Publicadas</h2>
            <p class="history-subtitle">
              Cada publicación genera un respaldo automático. Puedes restaurar cualquier versión previa con un solo clic.
            </p>
          </div>
          <span class="history-counter-badge">Total: {history.length} {history.length === 1 ? 'versión' : 'versiones'}</span>
        </div>

        {history.length === 0 ? (
          <div class="empty-history-card">
            No se han publicado versiones de este sitio aún. Realiza tu primera publicación en el panel superior.
          </div>
        ) : (
          <>
            <!-- Mobile Version Cards (< 768px) -->
            <div class="history-mobile-cards">
              {history.map((pub) => {
                const isCurrentActive = activePublication?.id === pub.id;
                const pubTemplate = (pub.snapshot as any)?.templateKey || "tech-diagnostic";
                return (
                  <article class={`version-card ${isCurrentActive ? 'version-card-active' : ''}`}>
                    <div class="version-card-top">
                      <div class="version-card-tag-group">
                        <strong class="version-badge">v{pub.version}</strong>
                        {isCurrentActive ? (
                          <span class="badge-status-active">ACTIVA</span>
                        ) : (
                          <span class="badge-status-history">Histórica</span>
                        )}
                      </div>
                      <span
                        class="security-pill"
                        title={`Checksum SHA-256: ${pub.checksum}`}
                      >
                        ✓ Verificada
                      </span>
                    </div>

                    <div class="version-card-meta">
                      <div class="meta-item">
                        <span class="meta-label">Publicada:</span>
                        <span class="meta-value">{new Date(pub.publishedAt).toLocaleString()}</span>
                      </div>
                      <div class="meta-item">
                        <span class="meta-label">Plantilla:</span>
                        <span class="meta-template-tag">{pubTemplate}</span>
                      </div>
                    </div>

                    <div class="version-card-actions">
                      <a
                        href={`/preview/${siteId}?version=${pub.version}`}
                        target="_blank"
                        class="btn-version-snapshot"
                      >
                        Ver Snapshot ↗
                      </a>

                      {!isCurrentActive && (
                        <form method="POST" action={actions.rollbackSite} class="rollback-form">
                          <input type="hidden" name="siteId" value={siteId} />
                          <input type="hidden" name="tenantId" value={siteData.tenant_id} />
                          <input type="hidden" name="targetVersion" value={pub.version} />
                          <button
                            type="submit"
                            class="btn-version-rollback"
                            onclick="return confirm('¿Confirmas que deseas restaurar la versión v' + this.form.targetVersion.value + '? Tu sitio volverá a verse exactamente como en esa fecha.');"
                          >
                            Restaurar v{pub.version}
                          </button>
                        </form>
                      )}
                    </div>
                  </article>
                );
              })}
            </div>

            <!-- Desktop Version Table (>= 768px) -->
            <div class="history-table-wrapper">
              <table class="desktop-data-table">
                <thead>
                  <tr>
                    <th>Versión</th>
                    <th>Estado</th>
                    <th>Fecha de Publicación</th>
                    <th>Plantilla</th>
                    <th>Seguridad</th>
                    <th>Acciones</th>
                  </tr>
                </thead>
                <tbody>
                  {history.map((pub) => {
                    const isCurrentActive = activePublication?.id === pub.id;
                    const pubTemplate = (pub.snapshot as any)?.templateKey || "tech-diagnostic";
                    return (
                      <tr class={isCurrentActive ? 'row-active' : ''}>
                        <td>
                          <strong class="table-version-num">v{pub.version}</strong>
                        </td>
                        <td>
                          {isCurrentActive ? (
                            <span class="badge-status-active">ACTIVA</span>
                          ) : (
                            <span class="badge-status-history">Histórica</span>
                          )}
                        </td>
                        <td class="table-date-cell">{new Date(pub.publishedAt).toLocaleString()}</td>
                        <td>
                          <span class="meta-template-tag">{pubTemplate}</span>
                        </td>
                        <td>
                          <span
                            class="security-pill"
                            title={`Checksum SHA-256: ${pub.checksum}`}
                          >
                            ✓ Verificada
                          </span>
                        </td>
                        <td>
                          <div class="table-actions-cell">
                            <a
                              href={`/preview/${siteId}?version=${pub.version}`}
                              target="_blank"
                              class="btn-version-snapshot"
                            >
                              Ver Snapshot ↗
                            </a>

                            {!isCurrentActive && (
                              <form method="POST" action={actions.rollbackSite} class="rollback-form">
                                <input type="hidden" name="siteId" value={siteId} />
                                <input type="hidden" name="tenantId" value={siteData.tenant_id} />
                                <input type="hidden" name="targetVersion" value={pub.version} />
                                <button
                                  type="submit"
                                  class="btn-version-rollback"
                                  onclick="return confirm('¿Confirmas que deseas restaurar la versión v' + this.form.targetVersion.value + '? Tu sitio volverá a verse exactamente como en esa fecha.');"
                                >
                                  Restaurar v{pub.version}
                                </button>
                              </form>
                            )}
                          </div>
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          </>
        )}
      </section>
    </main>
  </body>
</html>

<style>
  /* =========================================================
     MOBILE-FIRST PUBLISH PAGE STYLING
     ========================================================= */

  .publish-page-intro {
    margin-bottom: 1.5rem;
  }

  .publish-main-heading {
    font-size: clamp(1.4rem, 3.5vw, 2.2rem);
    font-weight: 800;
    color: #f8fafc;
    margin: 0 0 0.4rem;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .publish-main-subheading {
    font-size: 0.88rem;
    color: #94a3b8;
    max-width: 44rem;
    margin: 0;
    line-height: 1.5;
  }

  /* Alerts */
  .alert-banner {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.75rem 1rem;
    border-radius: 0.65rem;
    font-size: 0.88rem;
    font-weight: 600;
    margin-bottom: 1.25rem;
  }
  .alert-success {
    background: #064e3b;
    color: #a7f3d0;
    border: 1px solid #059669;
  }
  .alert-error {
    background: #450a0a;
    color: #fecaca;
    border: 1px solid #dc2626;
  }
  .alert-icon {
    font-weight: 800;
    font-size: 1.05rem;
  }

  /* Cards Grid (Mobile 1 column, Desktop 2 columns) */
  .publish-cards-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    margin-bottom: 2.5rem;
  }

  .publish-card {
    background: #0d1527;
    border: 1px solid #1e2e4f;
    border-radius: 0.85rem;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
  }

  .publish-card-header {
    margin-bottom: 1rem;
  }

  .publish-card-title {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 750;
    color: #f1f5f9;
    letter-spacing: -0.01em;
  }

  .publish-card-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .status-field-label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #64748b;
    display: block;
    margin-bottom: 0.3rem;
  }

  .status-live-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .version-live-tag {
    font-size: 1.45rem;
    font-weight: 800;
    color: #4ade80;
  }

  .badge-status-active {
    display: inline-flex;
    align-items: center;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    padding: 0.2rem 0.55rem;
    border-radius: 0.35rem;
    background: #064e3b;
    color: #6ee7b7;
    border: 1px solid #059669;
  }

  .badge-status-history {
    display: inline-flex;
    align-items: center;
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.2rem 0.55rem;
    border-radius: 0.35rem;
    background: #1e293b;
    color: #94a3b8;
    border: 1px solid #334155;
  }

  .badge-status-draft {
    display: inline-flex;
    align-items: center;
    font-size: 0.75rem;
    font-weight: 750;
    padding: 0.3rem 0.65rem;
    border-radius: 0.4rem;
    background: #450a0a;
    color: #fca5a5;
    border: 1px solid #b91c1c;
  }

  .status-meta-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .status-meta-row {
    font-size: 0.85rem;
  }

  .status-date-value {
    color: #e2e8f0;
    font-size: 0.88rem;
  }

  .security-details {
    font-size: 0.82rem;
    margin-top: 0.25rem;
  }

  .security-summary {
    cursor: pointer;
    color: #94a3b8;
    user-select: none;
  }

  .security-check-label {
    color: #34d399;
    font-weight: 600;
  }

  .security-link {
    text-decoration: underline;
  }

  .security-checksum-code {
    display: block;
    margin-top: 0.4rem;
    background: #090f1d;
    border: 1px solid #1e2e4f;
    padding: 0.45rem 0.65rem;
    border-radius: 0.4rem;
    font-size: 0.75rem;
    color: #38bdf8;
    word-break: break-all;
    font-family: ui-monospace, monospace;
  }

  /* Sync status banner */
  .sync-status-box {
    margin-top: 0.25rem;
  }

  .sync-banner {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    padding: 0.7rem 0.85rem;
    border-radius: 0.5rem;
    font-size: 0.82rem;
    line-height: 1.4;
  }

  .sync-pending {
    background: rgba(120, 53, 15, 0.25);
    border-left: 3px solid #f59e0b;
    color: #fde68a;
  }

  .sync-synced {
    background: rgba(6, 78, 59, 0.25);
    border-left: 3px solid #10b981;
    color: #a7f3d0;
  }

  .sync-icon {
    font-size: 0.95rem;
    flex-shrink: 0;
  }

  /* Card action buttons */
  .publish-card-actions {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid #1e2e4f;
  }

  .btn-action {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    padding: 0.65rem 1rem;
    border-radius: 0.55rem;
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.15s ease;
    text-align: center;
  }

  .btn-preview {
    background: #1e293b;
    color: #38bdf8;
    border: 1px solid #334155;
  }
  .btn-preview:hover {
    background: #283548;
    color: #7dd3fc;
  }

  .btn-live {
    background: #064e3b;
    color: #6ee7b7;
    border: 1px solid #059669;
  }
  .btn-live:hover {
    background: #047857;
    color: #ffffff;
  }

  /* Publish form & next version box */
  .publish-explanation {
    font-size: 0.85rem;
    color: #94a3b8;
    line-height: 1.45;
    margin: 0;
  }

  .publish-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .next-version-box {
    background: #090f1d;
    border: 1px solid #1e2e4f;
    border-radius: 0.65rem;
    padding: 0.85rem 1rem;
  }

  .next-version-row {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin: 0.25rem 0 0.35rem;
  }

  .next-version-tag {
    font-size: 1.4rem;
    color: #38bdf8;
    font-weight: 800;
  }

  .template-pill-badge {
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.15rem 0.5rem;
    border-radius: 0.35rem;
    background: #1e3a5f;
    color: #93c5fd;
    border: 1px solid #2563eb;
    text-transform: lowercase;
  }

  .next-version-hint {
    font-size: 0.74rem;
    color: #64748b;
    display: block;
    line-height: 1.35;
  }

  .btn-publish-submit {
    width: 100%;
    padding: 0.85rem 1rem;
    font-size: 0.98rem;
    font-weight: 800;
    color: #ffffff;
    background: linear-gradient(135deg, #0284c7, #2563eb);
    border: none;
    border-radius: 0.65rem;
    cursor: pointer;
    box-shadow: 0 4px 16px rgba(2, 132, 199, 0.35);
    transition: all 0.15s ease;
  }
  .btn-publish-submit:hover {
    background: linear-gradient(135deg, #0369a1, #1d4ed8);
    box-shadow: 0 6px 20px rgba(2, 132, 199, 0.45);
    transform: translateY(-1px);
  }

  /* History Section */
  .history-section {
    margin-top: 1rem;
  }

  .history-header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .history-title {
    font-size: 1.25rem;
    font-weight: 750;
    color: #f1f5f9;
    margin: 0;
  }

  .history-subtitle {
    font-size: 0.84rem;
    color: #94a3b8;
