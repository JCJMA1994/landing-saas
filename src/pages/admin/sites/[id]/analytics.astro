---
import { actions } from "astro:actions";
import { SupabaseAnalyticsRepository } from "../../../../infrastructure/supabase/analytics-repository";
import { getSiteAnalyticsSummaryUseCase } from "../../../../application/analytics/track-event";
import type { TenantRole } from "../../../../domain/tenant/roles";
import SiteHeaderNav from "../../../../components/admin/SiteHeaderNav.astro";

export const prerender = false;

const { id: siteId } = Astro.params;
if (!siteId) {
  return Astro.redirect("/admin", 303);
}

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect("/admin/login", 303);
}

const { data: siteData, error: siteError } = await Astro.locals.supabase
  .from("sites")
  .select("id, name, slug, tenant_id")
  .eq("id", siteId)
  .maybeSingle();

if (siteError || !siteData) {
  return Astro.redirect("/admin", 303);
}

const { data: memberData } = await Astro.locals.supabase
  .from("tenant_members")
  .select("role")
  .eq("tenant_id", siteData.tenant_id)
  .eq("user_id", user.id)
  .maybeSingle();

const role = (memberData?.role as TenantRole) || "viewer";

const analyticsRepo = new SupabaseAnalyticsRepository(Astro.locals.supabase);
const summary = await getSiteAnalyticsSummaryUseCase(siteId, role, analyticsRepo, 30);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Analytics & Conversiones | {siteData.name}</title>
    <style>
      :root {
        --color-bg: #071225;
        --color-surface: #0e1e38;
        --color-surface-card: #132749;
        --color-border: #243b66;
        --color-text: #f0f4fc;
        --color-text-muted: #95a8c9;
        --color-primary: #3b82f6;
        --color-primary-hover: #2563eb;
        --color-success: #10b981;
        --color-warning: #f59e0b;
        --color-accent: #f59e0b;
      }
      body {
        margin: 0;
        padding: 0;
        font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        background: var(--color-bg);
        color: var(--color-text);
        line-height: 1.5;
      }
      .shell {
        max-width: 1080px;
        margin: 0 auto;
        padding: 1.5rem;
      }
      .topbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid var(--color-border);
        padding-top: 1rem;
        padding-bottom: 1rem;
      }
      .nav-links {
        display: flex;
        gap: 1rem;
        list-style: none;
        margin: 0;
        padding: 0;
        flex-wrap: wrap;
      }
      .nav-link {
        color: var(--color-text-muted);
        text-decoration: none;
        font-size: 0.9rem;
        padding: 0.4rem 0.8rem;
        border-radius: 6px;
        transition: all 0.2s ease;
      }
      .nav-link:hover, .nav-link.active {
        color: var(--color-text);
        background: var(--color-surface);
      }
      .card {
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 8px;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
      }
      .badge {
        display: inline-block;
        font-size: 0.75rem;
        font-weight: 600;
        padding: 0.2rem 0.6rem;
        border-radius: 9999px;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }
      .badge-info { background: rgba(59, 130, 246, 0.2); color: #60a5fa; border: 1px solid rgba(59, 130, 246, 0.3); }
      .badge-success { background: rgba(16, 185, 129, 0.2); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.3); }
      .metrics-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 1rem;
        margin-bottom: 2rem;
      }
      .metric-box {
        background: var(--color-surface-card);
        border: 1px solid var(--color-border);
        border-radius: 8px;
        padding: 1.25rem;
        display: flex;
        flex-direction: column;
      }
      .metric-value {
        font-size: 2rem;
        font-weight: 800;
        color: #fff;
        margin-top: 0.25rem;
      }
      .metric-label {
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--color-text-muted);
      }
      .table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.85rem;
      }
      .table th, .table td {
        padding: 0.75rem 1rem;
        border-bottom: 1px solid var(--color-border);
        text-align: left;
      }
      .table th {
        color: var(--color-text-muted);
        background: var(--color-surface-card);
      }
      code {
        background: rgba(0,0,0,0.3);
        padding: 0.15rem 0.4rem;
        border-radius: 4px;
        font-family: monospace;
        color: #93c5fd;
      }
    </style>
  </head>
  <body>
    <header class="shell topbar">
      <a href="/admin" style="text-decoration: none; color: #ffffff; display: flex; align-items: center; gap: .5rem; font-weight: 800; font-size: 1.1rem;">
        <span style="color: #ffffff;">Launch<span style="color: #38bdf8;">Pulse</span></span>
      </a>
      <nav aria-label="Admin navigation">
        <ul class="nav-links">
          <li><a href="/admin" class="nav-link active">Sitios</a></li>
          <li><a href="/admin/members" class="nav-link">Equipo</a></li>
          <li><a href="/admin/billing" class="nav-link">Suscripción</a></li>
        </ul>
      </nav>
      <form method="POST" action={actions.logout}>
        <button type="submit" style="background: transparent; border: 1px solid var(--color-border); color: var(--color-text); padding: 0.4rem 0.8rem; border-radius: 6px; cursor: pointer;">
          Salir
        </button>
      </form>
    </header>

    <main class="shell dashboard">
      <SiteHeaderNav
        siteId={siteId}
        siteName={siteData.name}
        activeTab="analytics"
      />

      <div style="margin-bottom: 2rem;">
        <p class="eyebrow" style="color: #38bdf8;">Gestión &bull; Rendimiento</p>
        <h1 style="font-size: clamp(1.8rem, 4vw, 2.5rem); margin: 0.25rem 0 0.5rem;">{siteData.name} &mdash; Métricas y Resultados</h1>
        <p class="muted" style="max-width: 48rem; margin: 0;">
          Supervisa el tráfico real de tu sitio, clics a tu WhatsApp y efectividad de tus campañas en los últimos 30 días sin cookies invasivas.
        </p>
      </div>

      <!-- Resumen de Métricas -->
      <div class="metrics-grid">
        <div class="metric-box">
          <span class="metric-label">Visitas Totales</span>
          <span class="metric-value" style="color: #93c5fd;">{summary.totalPageViews}</span>
        </div>
        <div class="metric-box">
          <span class="metric-label">Conversiones WhatsApp</span>
          <span class="metric-value" style="color: #34d399;">{summary.totalWhatsappClicks}</span>
        </div>
        <div class="metric-box">
          <span class="metric-label">Clics en CTA</span>
          <span class="metric-value" style="color: #fbbf24;">{summary.totalCtaClicks}</span>
        </div>
        <div class="metric-box">
          <span class="metric-label">Vistas de Campaña</span>
          <span class="metric-value" style="color: #c084fc;">{summary.totalCampaignViews}</span>
        </div>
        <div class="metric-box" style="border-color: rgba(52, 211, 153, 0.4); background: rgba(16, 185, 129, 0.08);">
          <span class="metric-label" style="color: #34d399;">Tasa de Conversión (CR)</span>
          <span class="metric-value" style="color: #34d399;">{summary.conversionRate}%</span>
        </div>
      </div>

      <!-- Registro de Eventos Recientes -->
      <div class="card">
        <h2 style="font-size: 1.15rem; margin-top: 0; margin-bottom: 1rem;">
          Eventos Recientes (Telemetría en Vivo)
        </h2>

        {summary.recentEvents.length === 0 ? (
          <p style="color: var(--color-text-muted); font-style: italic; margin: 0; padding: 1rem 0;">
            Aún no se han registrado eventos para esta landing. Las visitas públicas aparecerán aquí en tiempo real.
          </p>
        ) : (
          <div style="overflow-x: auto;">
            <table class="table">
              <thead>
                <tr>
                  <th>Fecha / Hora (UTC)</th>
                  <th>Tipo de Evento</th>
                  <th>Ruta</th>
                  <th>Referrer</th>
                  <th>Metadata</th>
                </tr>
              </thead>
              <tbody>
                {summary.recentEvents.map((evt) => (
                  <tr>
                    <td style="white-space: nowrap; color: var(--color-text-muted);">
                      {evt.createdAt ? new Date(evt.createdAt).toLocaleString() : "-"}
                    </td>
                    <td>
                      <span class={`badge ${evt.eventName === "whatsapp_click" ? "badge-success" : "badge-info"}`}>
                        {evt.eventName}
                      </span>
                    </td>
                    <td><code>{evt.path}</code></td>
                    <td style="max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                      {evt.referrer ? evt.referrer : <span style="color: var(--color-text-muted);">Directo</span>}
                    </td>
                    <td style="font-size: 0.75rem; color: var(--color-text-muted);">
                      {evt.metadata && Object.keys(evt.metadata).length > 0 ? JSON.stringify(evt.metadata) : "-"}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </div>
    </main>
  </body>
</html>
