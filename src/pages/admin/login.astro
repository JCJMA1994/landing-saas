---
import { actions } from "astro:actions";
import { SupabaseSubscriptionRepository } from "../../infrastructure/supabase/subscription-repository";
import "../../styles/admin.css";

const subRepo = new SupabaseSubscriptionRepository(Astro.locals.supabase);
const rawRedirect = Astro.url.searchParams.get("redirect");

async function resolveDestination(userId: string): Promise<string> {
  if (rawRedirect && rawRedirect.startsWith("/") && !rawRedirect.startsWith("//")) {
    return rawRedirect;
  }
  const isSuperadmin = await subRepo.isPlatformSuperadmin(userId);
  return isSuperadmin ? "/backoffice" : "/admin";
}

if (Astro.locals.user) {
  const dest = await resolveDestination(Astro.locals.user.id);
  return Astro.redirect(dest, 303);
}

const result = Astro.getActionResult(actions.login);
if (result?.data?.ok && Astro.locals.user) {
  const dest = await resolveDestination(Astro.locals.user.id);
  return Astro.redirect(dest, 303);
}
const showError = Boolean(result && (!result.data || !result.data.ok));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Sign in | Landing SaaS</title>
  </head>
  <body>
    <main class="shell auth-shell">
      <section class="panel" aria-labelledby="login-title">
        <p class="eyebrow">Workspace access</p>
        <h1 id="login-title">Sign in</h1>
        <p class="muted">Use the account provisioned by your workspace administrator.</p>
        {showError && <p class="error" role="alert">Invalid email or password.</p>}
        <form method="POST" action={actions.login}>
          <div class="field">
            <label for="email">Email</label>
            <input id="email" name="email" type="email" autocomplete="email" required maxlength="254" />
          </div>
          <div class="field">
            <label for="password">Password</label>
            <input id="password" name="password" type="password" autocomplete="current-password" required minlength="8" maxlength="128" />
          </div>
          <button type="submit">Sign in</button>
        </form>
      </section>
    </main>
  </body>
</html>
