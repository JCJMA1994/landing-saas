# Copy to .env; never commit real environment credentials.
APP_ENV=development
APP_HOSTNAME=localhost
SUPABASE_URL=http://127.0.0.1:54321
# Use a publishable key or the local Supabase CLI's legacy anon JWT.
# Never use a service-role JWT or sb_secret_ key.
SUPABASE_PUBLISHABLE_KEY=
HOST=127.0.0.1
PORT=4321
